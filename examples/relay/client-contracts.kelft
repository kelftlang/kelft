pub fn parse(source:string)->Result<j::Value,string> {return w::parse(source);}
pub fn validate_request(id:string,value:j::Value)->bool {return w::request(models(),manifest(),id,value);}
pub fn validate_response(id:string,status:i32,value:j::Value)->bool {return w::response(models(),manifest(),id,status,value);}
pub fn serialize_request(id:string,value:j::Value)->Result<string,string> {return w::serialize_request(models(),manifest(),id,value);}
pub fn serialize_response(id:string,status:i32,value:j::Value)->Result<string,string> {return w::serialize_response(models(),manifest(),id,status,value);}
pub fn route(method:string,path:string)->Option<j::Value> {return w::route(manifest(),method,path);}
