import "../../selfhost/json.kelft" as j;
import "./widgets.kelft" as w;
import "./data.kelft" as d;
fn flag(state:j::Value,key:string)->bool {return j::boolean(j::field(state,key));}
fn form(state:j::Value,key:string)->string {return d::text(j::field(state,"forms"),key);}
fn button(id:string,label:string,action:string,data:j::Value)->j::Value {return w::button(id,label,action,data,"");}
fn heading(value:string)->j::Value {return w::node("h2","section-heading","",[w::text(value)]);}
fn para(value:string)->j::Value {return w::paragraph("",value,"muted");}
fn observed(task:j::Value)->j::Value {
 let mut base:j::Value=d::object();let names:Array<string>=["revision","title","state"];for name in names {base=j::set(base,name,j::field(task,name));}let owner:j::Value=j::field(task,"owner");let mut id:j::Value=j::Value::Null();if !d::null(owner) {id=j::field(owner,"id");}base=j::set(base,"owner",id);return j::set(j::set(j::set(d::object(),"task",j::field(task,"id")),"workspace",j::field(task,"workspace")),"base",base);
}
fn latest_server(state:j::Value,conflict:j::Value)->j::Value {for task in j::array(j::field(j::field(state,"snapshot"),"tasks")) {if d::text(task,"id")==d::text(conflict,"task") {return task;}}return j::field(conflict,"server");}
fn can_edit(state:j::Value)->bool {return !flag(state,"new_op_busy")&&!flag(state,"quarantined")&&(flag(state,"authenticated")&&flag(state,"authorized")&&flag(state,"online")&&flag(state,"network_ok")||flag(state,"vault_unlocked")&&flag(state,"local_authorized"));}
fn admin(state:j::Value)->bool {for member in j::array(j::field(j::field(state,"visible"),"members")) {if d::text(j::field(member,"user"),"id")==d::text(j::field(state,"user"),"id") {return d::text(member,"role")=="admin";}}return false;}
fn header(state:j::Value)->j::Value {
 let mut actions:Array<j::Value>=[];let mut connection:string="Online";if !flag(state,"online")||!flag(state,"network_ok") {connection="Offline";}array_push::<j::Value>(inout actions,w::paragraph("connection",connection,"badge"));
 if flag(state,"authenticated") {array_push::<j::Value>(inout actions,w::paragraph("account",d::text(j::field(state,"user"),"display_name"),"account"));array_push::<j::Value>(inout actions,button("switch-account","Switch account","ui.switch-account",j::Value::Null()));array_push::<j::Value>(inout actions,button("logout","Sign out","ui.logout",j::Value::Null()));}else {array_push::<j::Value>(inout actions,w::button("sign-in","Sign in","ui.sign-in",j::Value::Null(),"primary"));}
 let brand:j::Value=w::node("div","brand","",[w::node("span","brand-mark","",[w::text("R")]),w::node("div","","",[w::node("h1","","",[w::text("Relay")]),w::paragraph("","A little clarity. A team in motion.","tagline")])]);return w::node("header","topbar","",[brand,w::node("div","account-actions","",actions)]);
}
fn navigation(state:j::Value)->j::Value {
 let mut choices:Array<j::Value>=[w::option("","Choose a workspace",d::text(state,"workspace")=="")];for workspace in j::array(j::field(j::field(state,"session"),"workspaces")) {array_push::<j::Value>(inout choices,w::option(d::text(workspace,"id"),d::text(workspace,"name"),d::text(workspace,"id")==d::text(state,"workspace")));}
 let mut tabs:Array<j::Value>=[];let names:Array<string>=["board","team","vault"];let labels:Array<string>=["Board","Team","Offline vault"];let mut i:i32=0;for name in names {let mut classes:string="tab";if d::text(state,"view")==name {classes=classes+" active";}array_push::<j::Value>(inout tabs,w::attr(w::button("tab-"+name,labels[i],"ui.view",j::Value::Text(name),classes),"aria-pressed",j::Value::Bool(d::text(state,"view")==name)));i=i+1;}
 return w::node("nav","workspace-nav","",[w::select("workspace","Workspace",d::text(state,"workspace"),choices,"ui.workspace-select",j::Value::Null()),w::node("div","tabs","",tabs)]);
}
fn pager(state:j::Value,name:string,count:i32,size:i32)->j::Value {let page:i32=d::number(j::field(j::field(state,"pages"),name));let data:j::Value=j::set(d::object(),"column",j::Value::Text(name));return w::node("div","row pager","",[w::disabled(button("prev-"+name,"Previous","ui.page",j::set(data,"page",d::int(page-1))),page==0),w::disabled(button("next-"+name,"Next","ui.page",j::set(data,"page",d::int(page+1))),(page+1)*size>=count)]);}
fn task_card(state:j::Value,task:j::Value)->j::Value {
 let id:string=d::text(task,"id");let editing:bool=d::text(state,"editor")==id;let mut content:Array<j::Value>=[];let mut pending:bool=false;for item in j::array(j::field(state,"queue")) {if d::text(j::field(item,"operation"),"task")==id {pending=true;}}
 if editing {array_push::<j::Value>(inout content,w::field("edit-title","Task title",form(state,"edit_title"),"text","edit_title"));array_push::<j::Value>(inout content,w::node("div","row","",[w::disabled(button("save-title","Save title","ui.task-save",j::Value::Text(id)),!can_edit(state)),button("cancel-title","Cancel","ui.task-cancel",j::Value::Null())]));}else {array_push::<j::Value>(inout content,w::node("h3","task-title","",[w::text(d::text(task,"title"))]));}
 let mut owners:Array<j::Value>=[w::option("","Unassigned",d::null(j::field(task,"owner")))];for member in j::array(j::field(j::field(state,"visible"),"members")) {let user:j::Value=j::field(member,"user");array_push::<j::Value>(inout owners,w::option(d::text(user,"id"),d::text(user,"display_name"),d::text(user,"id")==d::text(j::field(task,"owner"),"id")));}
 if editing {array_push::<j::Value>(inout content,w::disabled(w::select("owner-"+id,"Assignee for "+d::text(task,"title"),d::text(j::field(task,"owner"),"id"),owners,"ui.task-assign",observed(task)),!can_edit(state)));}else {let mut owner:string="Unassigned";if !d::null(j::field(task,"owner")) {owner=d::text(j::field(task,"owner"),"display_name");}array_push::<j::Value>(inout content,para(owner));}
 let states:Array<string>=["todo","doing","done"];let labels:Array<string>=["To do","Doing","Done"];let mut moves:Array<j::Value>=[];let mut i:i32=0;for value in states {let data:j::Value=j::set(observed(task),"state",j::Value::Text(value));array_push::<j::Value>(inout moves,w::attr(w::disabled(w::button("move-"+id+"-"+value,labels[i],"ui.task-move",data,"move"),!can_edit(state)||d::text(task,"state")==value),"aria-label",j::Value::Text("Move "+d::text(task,"title")+" to "+labels[i])));i=i+1;}
 array_push::<j::Value>(inout content,w::node("div","moves","",moves));let mut suffix:string="Synced";if pending {suffix="Saving";if flag(state,"vault_unlocked")&&d::number(j::field(state,"persisted_version"))>=d::number(j::field(state,"data_version")) {suffix="Queued securely";}}
 array_push::<j::Value>(inout content,w::node("div","task-footer","",[w::paragraph("task-status-"+id,suffix,"task-status"),w::disabled(w::button("edit-"+id,"Edit","ui.task-edit",j::Value::Text(id),"text-button"),!can_edit(state))]));return w::node("section","task-card","task-"+id,content);
}
fn board(state:j::Value)->j::Value {
 let snapshot:j::Value=j::field(state,"visible");let mut content:Array<j::Value>=[w::node("div","section-intro","",[heading("Make room for progress."),para("One board. Shared focus. Every change accounted for.")])];
 array_push::<j::Value>(inout content,w::node("div","composer","",[w::field("new-task","What needs doing?",form(state,"title"),"text","title"),w::disabled(w::button("add-task","Add task","ui.task-create",j::Value::Null(),"primary"),!can_edit(state)||flag(state,"new_op_busy"))]));
 if d::null(snapshot) {array_push::<j::Value>(inout content,w::node("section","empty-state","",[heading("Your team's next chapter."),para("Sign in and choose a workspace, or unlock its saved offline vault.")]));return w::node("section","board-view","board-view",content);}
 let states:Array<string>=["todo","doing","done"];let labels:Array<string>=["To do","In progress","Done"];let mut columns:Array<j::Value>=[];let mut i:i32=0;for value in states {let mut cards:Array<j::Value>=[];let mut count:i32=0;let page:i32=d::number(j::field(j::field(state,"pages"),value));for task in j::array(j::field(snapshot,"tasks")) {if d::text(task,"state")==value {if count>=page*20&&count<(page+1)*20 {array_push::<j::Value>(inout cards,task_card(state,task));}count=count+1;}}
 let mut children:Array<j::Value>=[w::node("div","column-heading","",[w::node("h2","","",[w::text(labels[i])]),w::node("span","count","",[w::text(i32_to_string(count))])]),w::node("div","task-list","",cards)];if count==0 {array_push::<j::Value>(inout children,para("A little breathing room."));}if count>20 {array_push::<j::Value>(inout children,pager(state,value,count,20));}array_push::<j::Value>(inout columns,w::node("section","column "+value,"column-"+value,children));i=i+1;}
 array_push::<j::Value>(inout content,w::node("div","board-grid","",columns));return w::node("section","board-view","board-view",content);
}
fn team(state:j::Value)->j::Value {
 let mut children:Array<j::Value>=[heading("Good work takes good company."),para("Administrators manage invitations and membership. The last administrator always stays protected.")];let allowed:bool=admin(state)&&flag(state,"authenticated")&&flag(state,"online");let mut people:Array<j::Value>=[];let mut count:i32=0;let page:i32=d::number(j::field(j::field(state,"pages"),"team"));for member in j::array(j::field(j::field(state,"visible"),"members")) {if count>=page*20&&count<(page+1)*20 {let user:j::Value=j::field(member,"user");let id:string=d::text(user,"id");let role:string=d::text(member,"role");let roles:Array<j::Value>=[w::option("member","Member",role=="member"),w::option("admin","Administrator",role=="admin")];array_push::<j::Value>(inout people,w::node("li","member-row","member-"+id,[w::paragraph("",d::text(user,"display_name"),"member-name"),w::disabled(w::select("role-"+id,"Role for "+d::text(user,"display_name"),role,roles,"ui.role",j::Value::Text(id)),!allowed),w::disabled(button("remove-"+id,"Remove","ui.remove-member",j::Value::Text(id)),!allowed)]));}count=count+1;}
 array_push::<j::Value>(inout children,w::node("ul","member-list","",people));if count>20 {array_push::<j::Value>(inout children,pager(state,"team",count,20));}
 array_push::<j::Value>(inout children,w::node("section","panel","",[w::node("h3","","",[w::text("Invite a teammate")]),w::field("recipient","Verified recipient email",form(state,"recipient"),"email","recipient"),w::disabled(w::button("invite-create","Create invitation link","ui.invite-create",j::Value::Null(),"primary"),!allowed),para("Bound to this provider and verified email. Single use. Expires after seven days.")]));if d::text(state,"invite_link")!="" {let field:j::Value=w::attr(w::attr(w::node("input","field","invitation-link",[]),"value",j::field(state,"invite_link")),"readonly",j::Value::Bool(true));array_push::<j::Value>(inout children,w::node("section","panel","",[para("Copy this invitation link and share it with its named recipient."),field]));}
 array_push::<j::Value>(inout children,w::disabled(button("leave-workspace","Leave workspace","ui.leave",j::Value::Null()),!flag(state,"authenticated")||!flag(state,"online")));return w::node("section","team-view","team-view",children);
}
fn pending(state:j::Value)->j::Value {
 let items:Array<j::Value>=j::array(j::field(state,"queue"));let mut children:Array<j::Value>=[heading("Pending work · "+i32_to_string(array_len::<j::Value>(items)))];let mut index:i32=0;let page:i32=d::number(j::field(j::field(state,"pages"),"pending"));for item in items {if index>=page*10&&index<(page+1)*10 {let operation:j::Value=j::field(item,"operation");let id:string=d::text(operation,"id");let status:string=d::text(item,"status");let mut label:string="Saving";if flag(state,"vault_unlocked")&&d::number(j::field(item,"version"))<=d::number(j::field(state,"persisted_version")) {label="Safely queued";}if status=="rejected" {label="Needs attention";}if status=="conflict" {label="Conflicting edits";}let mut row:Array<j::Value>=[w::node("h3","","",[w::text(label)]),para("Task "+d::text(operation,"task")),para(j::canonical(j::field(operation,"patch")))];
 if status=="conflict" {let server:j::Value=latest_server(state,j::field(item,"conflict"));let choice:j::Value=j::set(j::set(d::object(),"operation",j::Value::Text(id)),"server",server);array_push::<j::Value>(inout row,para("Server version: "+d::text(server,"title")+" · "+d::text(server,"state")));array_push::<j::Value>(inout row,w::node("div","row","",[button("resolve-mine-"+id,"Use my changes","ui.resolve-mine",choice),button("resolve-server-"+id,"Keep server version","ui.resolve-server",choice)]));}else if status=="rejected" {array_push::<j::Value>(inout row,para(d::text(item,"message")));array_push::<j::Value>(inout row,button("retry-"+id,"Retry unchanged edit","ui.pending-retry",j::Value::Text(id)));}
 if d::text(state,"confirm")=="discard-"+id {array_push::<j::Value>(inout row,para("Discard this edit and all its later task edits? This cannot be undone locally."));array_push::<j::Value>(inout row,w::button("discard-"+id,"Confirm discard","ui.discard",j::Value::Text(id),"danger"));}else {array_push::<j::Value>(inout row,w::button("discard-confirm-"+id,"Discard…","ui.discard-confirm",j::Value::Text(id),"text-button"));}array_push::<j::Value>(inout children,w::node("section","pending-item","pending-"+id,row));}index=index+1;}
 if array_len::<j::Value>(items)>10 {array_push::<j::Value>(inout children,pager(state,"pending",array_len::<j::Value>(items),10));}return w::node("section","pending-panel","pending-panel",children);
}
fn vault(state:j::Value)->j::Value {
 let mut children:Array<j::Value>=[heading("Your work, even without a signal."),para("Online use needs no passphrase. Enable this workspace's vault to draft safely offline. A forgotten passphrase cannot be recovered automatically.")];let mut status:string="Not enabled";if flag(state,"vault_enabled") {status="Locked";}if flag(state,"vault_unlocked") {status="Unlocked";}if flag(state,"quarantined") {status="Quarantined";}array_push::<j::Value>(inout children,w::paragraph("vault-status",status,"badge"));
 if flag(state,"vault_unlocked") {array_push::<j::Value>(inout children,button("vault-lock","Lock vault","ui.vault-lock",j::Value::Null()));}else if !flag(state,"quarantined") {array_push::<j::Value>(inout children,w::field("passphrase","Offline vault passphrase",form(state,"passphrase"),"password","passphrase"));let mut label:string="Enable encrypted vault";let mut action:string="ui.vault-enable";if flag(state,"vault_enabled") {label="Unlock saved work";action="ui.vault-unlock";}array_push::<j::Value>(inout children,w::disabled(w::button("vault-open",label,action,j::Value::Null(),"primary"),flag(state,"vault_activating")));}else {array_push::<j::Value>(inout children,para("Access was revoked or could not be confirmed. Saved work stays encrypted and cannot replay under another identity."));array_push::<j::Value>(inout children,button("vault-recover","Check renewed authorization","ui.vault-recover",j::Value::Null()));}
 array_push::<j::Value>(inout children,para("Locks after fifteen minutes of inactivity, logout or account switching. Revocation cannot be discovered while offline. Browser memory clearing is best effort; a compromised device or browser can still expose unlocked work."));if flag(state,"persistence_paused") {array_push::<j::Value>(inout children,button("persist-retry","Retry encrypted saving","ui.persist-retry",j::Value::Null()));}
 if flag(state,"vault_enabled") {if d::text(state,"confirm")=="delete-vault" {array_push::<j::Value>(inout children,para("Permanently delete this workspace's encrypted offline copy and pending work? Server work remains available."));array_push::<j::Value>(inout children,w::button("vault-delete","Permanently delete local work","ui.vault-delete",j::Value::Null(),"danger"));}else {array_push::<j::Value>(inout children,w::button("vault-delete-confirm","Delete encrypted local copy…","ui.vault-delete-confirm",j::Value::Null(),"text-button"));}}
 let mut stored:Array<j::Value>=[];let mut index:i32=0;for entry in j::array(j::field(state,"vaults")) {let key:j::Value=j::field(entry,"identity");array_push::<j::Value>(inout stored,button("saved-vault-"+i32_to_string(index),d::text(key,"subject")+" · "+d::text(key,"workspace"),"ui.vault-select",d::int(index)));index=index+1;}if index>0 {array_push::<j::Value>(inout children,w::node("section","panel","",[w::node("h3","","",[w::text("Saved workspaces")]),w::node("div","saved-workspaces","",stored)]));}return w::node("section","vault-view panel","vault-view",children);
}
pub fn view(state:j::Value)->j::Value {
 let mut children:Array<j::Value>=[header(state),navigation(state)];if d::text(state,"notice")!="" {array_push::<j::Value>(inout children,w::attr(w::paragraph("status",d::text(state,"notice"),"notice"),"aria-live",j::Value::Text("polite")));}if d::text(state,"error")!="" {array_push::<j::Value>(inout children,w::attr(w::paragraph("error",d::text(state,"error"),"error"),"role",j::Value::Text("alert")));}
 if flag(state,"authenticated") {array_push::<j::Value>(inout children,w::node("div","workspace-create","",[w::field("workspace-name","New workspace",form(state,"workspace_name"),"text","workspace_name"),button("create-workspace","Create workspace","ui.workspace-create",j::Value::Null())]));}
 if d::text(state,"invitation_token")!="" {array_push::<j::Value>(inout children,w::node("section","panel","",[heading("You've been invited."),para("Sign in with the invited provider and verified recipient email to join."),w::disabled(button("accept-invitation","Accept invitation","ui.invite-accept",j::Value::Null()),!flag(state,"authenticated"))]));}
 let selected:string=d::text(state,"view");if selected=="vault" {array_push::<j::Value>(inout children,vault(state));}else if selected=="team" {array_push::<j::Value>(inout children,team(state));}else {array_push::<j::Value>(inout children,board(state));}if array_len::<j::Value>(j::array(j::field(state,"queue")))>0 {array_push::<j::Value>(inout children,pending(state));}
 array_push::<j::Value>(inout children,w::node("footer","footer","",[w::text("Relay · Work together. Keep your momentum.")]));let mut classes:string="app";if d::number(j::field(state,"width"))<720 {classes=classes+" compact mobile-ready";}return w::node("main",classes,"relay",children);
}
