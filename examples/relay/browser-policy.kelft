import "../../selfhost/json.kelft" as j;
import "../../selfhost/syntax.kelft" as s;
import "../../stdlib/contracts.kelft" as contracts;
import "./data.kelft" as d;
import "./browser-io.kelft" as io;
import "./client-contracts.kelft" as wire;
import "./render.kelft" as render;

fn flag(state:j::Value,key:string)->bool {return j::boolean(j::field(state,key));}
fn queue(state:j::Value)->Array<j::Value> {return j::array(j::field(state,"queue"));}
fn session(state:j::Value)->j::Value {return j::field(state,"session");}
fn same_scope(state:j::Value,meta:j::Value)->bool {return d::same(j::field(state,"identity"),j::field(meta,"identity"))&&d::text(state,"workspace")==d::text(meta,"workspace")&&d::number(j::field(state,"auth_epoch"))==d::number(j::field(meta,"epoch"));}
fn workspace_input(state:j::Value)->j::Value {return j::set(d::object(),"workspace",j::field(state,"workspace"));}
fn root(state:j::Value)->string {return "/api/workspaces/"+d::text(state,"workspace");}
fn error(inout state:j::Value,value:string)->void {state=j::set(state,"error",j::Value::Text(value));}
fn notice(inout state:j::Value,value:string)->void {state=j::set(state,"notice",j::Value::Text(value));}
fn catalog(inout state:j::Value,inout commands:Array<j::Value>)->void {io::vault(inout state,inout commands,"vault.list","catalog",d::object());}
fn refresh_session(inout state:j::Value,inout commands:Array<j::Value>)->void {if !flag(state,"online")||flag(state,"session_loading") {return;}if io::http(inout state,inout commands,"GET","/api/session","api.session",j::Value::Null(),"","session",d::object()) {state=j::set(state,"session_loading",j::Value::Bool(true));}}
fn synchronize(inout state:j::Value,inout commands:Array<j::Value>)->void {if !flag(state,"online")||!flag(state,"authenticated")||d::text(state,"workspace")==""||flag(state,"sync_loading")||flag(state,"quarantined") {return;}if !d::same(j::field(session(state),"identity"),j::field(state,"identity")) {return;}let url:string=root(state)+"/sync";let request:j::Value=workspace_input(state);if io::http(inout state,inout commands,"GET",url,"api.sync",request,"","sync",d::object()) {state=j::set(state,"sync_loading",j::Value::Bool(true));}}
fn public_user(state:j::Value,id:string)->j::Value {for member in j::array(j::field(j::field(state,"snapshot"),"members")) {let user:j::Value=j::field(member,"user");if d::text(user,"id")==id {return user;}}return j::Value::Null();}
fn owner_id(task:j::Value)->j::Value {let owner:j::Value=j::field(task,"owner");if d::null(owner) {return j::Value::Null();}return j::field(owner,"id");}
fn baseline(task:j::Value)->j::Value {let mut out:j::Value=d::object();out=j::set(out,"revision",j::field(task,"revision"));out=j::set(out,"title",j::field(task,"title"));out=j::set(out,"state",j::field(task,"state"));return j::set(out,"owner",owner_id(task));}
fn projected(state:j::Value)->j::Value {
    let mut snapshot:j::Value=j::field(state,"snapshot");if d::null(snapshot) {return snapshot;}let mut tasks:Array<j::Value>=j::array(j::field(snapshot,"tasks"));let mut blocked:Map<string,bool>=map_new::<string,bool>();
    for item in queue(state) {let operation:j::Value=j::field(item,"operation");let id:string=d::text(operation,"task");let status:string=d::text(item,"status");if status=="conflict"||status=="rejected" {map_set::<string,bool>(inout blocked,id,true);continue;}let mut unavailable:bool=false;match map_get::<string,bool>(blocked,id) {Option::Some(value)=>{unavailable=value;},Option::None=>{}}if unavailable {continue;}let mut index:i32=-1;let mut i:i32=0;for task in tasks {if d::text(task,"id")==id {index=i;}i=i+1;}let mut task:j::Value=d::object();if index<0 {if d::text(operation,"kind")!="create" {continue;}task=j::parse("{\"state\":\"todo\",\"owner\":null,\"revision\":0}");task=j::set(task,"id",j::Value::Text(id));task=j::set(task,"workspace",j::field(state,"workspace"));}else {task=tasks[index];}let previous:j::Value=task;let patch:j::Value=j::field(operation,"patch");if !d::null(j::field(patch,"title")) {task=j::set(task,"title",j::field(patch,"title"));}if !d::null(j::field(patch,"state")) {task=j::set(task,"state",j::field(patch,"state"));}if j::boolean(j::field(patch,"assign")) {task=j::set(task,"owner",public_user(state,j::string(j::field(patch,"owner"))));}if !d::same(task,previous) {task=j::set(task,"revision",d::int(d::number(j::field(previous,"revision"))+1));}if index<0 {array_push::<j::Value>(inout tasks,task);}else {tasks[index]=task;}}
    snapshot=j::set(snapshot,"tasks",j::Value::Array(tasks));return snapshot;
}
fn find_task(state:j::Value,id:string)->j::Value {for task in j::array(j::field(projected(state),"tasks")) {if d::text(task,"id")==id {return task;}}return j::Value::Null();}
fn payload(state:j::Value)->j::Value {let mut value:j::Value=j::parse("{\"schemaVersion\":\"0.2\",\"local_authorized\":true}");value=j::set(value,"identity",j::field(state,"identity"));value=j::set(value,"workspace",j::field(state,"workspace"));value=j::set(value,"user",j::field(state,"user"));value=j::set(value,"snapshot",j::field(state,"snapshot"));value=j::set(value,"queue",j::field(state,"queue"));return value;}
fn persist(inout state:j::Value,inout commands:Array<j::Value>)->void {
    if !flag(state,"vault_unlocked")||flag(state,"persisting")||flag(state,"persistence_paused")||flag(state,"quarantined")||d::number(j::field(state,"data_version"))<=d::number(j::field(state,"persisted_version")) {return;}let value:j::Value=payload(state);if string_len(j::canonical(value))>262144 {error(inout state,"Too much work is pending. Keep this tab open and synchronize or resolve existing edits.");return;}
    let cmd:j::Value=j::set(j::set(io::command("vault.store"),"identity",io::identity(state)),"payload",value);let meta:j::Value=j::set(d::object(),"version",j::field(state,"data_version"));io::pending(inout state,inout commands,cmd,"persist",meta);state=j::set(state,"persisting",j::Value::Bool(true));
}
fn blocked_earlier(items:Array<j::Value>,index:i32)->bool {let current:j::Value=j::field(items[index],"operation");let mut i:i32=0;while i<index {let previous:j::Value=j::field(items[i],"operation");if d::text(previous,"task")==d::text(current,"task") {if d::text(current,"kind")=="resolve"&&(d::text(j::field(items[i],"conflict"),"id")==d::text(current,"conflict")||d::text(previous,"kind")=="resolve"&&d::text(previous,"conflict")==d::text(current,"conflict")&&d::text(items[i],"status")=="rejected") {i=i+1;continue;}return true;}i=i+1;}return false;}
fn replay(inout state:j::Value,inout commands:Array<j::Value>)->void {
    if !flag(state,"online")||!flag(state,"authenticated")||!flag(state,"authorized")||flag(state,"auth_paused")||flag(state,"quarantined")||d::text(state,"replaying")!=""||d::text(state,"retry_timer")!=""||!d::same(j::field(session(state),"identity"),j::field(state,"identity")) {return;}let items:Array<j::Value>=queue(state);let mut index:i32=0;for item in items {if d::text(item,"status")!="pending"||blocked_earlier(items,index) {index=index+1;continue;}if flag(state,"vault_activating")||flag(state,"vault_unlocked")&&d::number(j::field(item,"version"))>d::number(j::field(state,"persisted_version")) {return;}let operation:j::Value=j::field(item,"operation");let body:j::Value=j::set(d::object(),"operation",operation);let logical:j::Value=j::set(body,"workspace",j::field(state,"workspace"));let meta:j::Value=j::set(d::object(),"operation",j::field(operation,"id"));let url:string=root(state)+"/operations";if io::http(inout state,inout commands,"POST",url,"api.apply_operation",logical,j::canonical(body),"operation",meta) {state=j::set(state,"replaying",j::field(operation,"id"));}return;}
}
fn lock(inout state:j::Value,inout commands:Array<j::Value>,reason:string,quarantine:bool)->void {
    if flag(state,"vault_enabled") {let mut extra:j::Value=d::object();if !quarantine {extra=j::set(extra,"reason",j::Value::Text(reason));}let mut kind:string="vault.lock";if quarantine {kind="vault.quarantine";}io::vault(inout state,inout commands,kind,"lock",extra);}
    clear_locked_state(inout state,inout commands,quarantine);
}
fn clear_locked_state(inout state:j::Value,inout commands:Array<j::Value>,quarantine:bool)->void {
    let retry_id:string=d::text(state,"retry_timer");if retry_id!="" {array_push::<j::Value>(inout commands,j::set(io::command("timer.cancel"),"id",j::Value::Text(retry_id)));state=j::set(state,"pending",j::remove(j::field(state,"pending"),retry_id));state=j::set(state,"retry_timer",j::Value::Text(""));}
    state=j::set(state,"auth_epoch",d::int(d::number(j::field(state,"auth_epoch"))+1));state=j::set(state,"vault_unlocked",j::Value::Bool(false));state=j::set(state,"vault_activating",j::Value::Bool(false));state=j::set(state,"snapshot",j::Value::Null());state=j::set(state,"queue",j::Value::Array([]));state=j::set(state,"user",j::Value::Null());state=j::set(state,"local_authorized",j::Value::Bool(false));state=j::set(state,"authorized",j::Value::Bool(false));state=j::set(state,"persisting",j::Value::Bool(false));state=j::set(state,"replaying",j::Value::Text(""));state=j::set(state,"quarantined",j::Value::Bool(quarantine));state=j::set(state,"forms",d::object());state=j::set(state,"editor",j::Value::Text(""));state=j::set(state,"editor_base",j::Value::Null());state=j::set(state,"new_op_busy",j::Value::Bool(false));state=j::set(state,"sync_loading",j::Value::Bool(false));
}
fn drafting(state:j::Value)->bool {return !flag(state,"quarantined")&&(flag(state,"online")&&flag(state,"network_ok")&&flag(state,"authenticated")&&flag(state,"authorized")||flag(state,"vault_unlocked")&&flag(state,"local_authorized"));}
fn snapshot_valid(value:j::Value,workspace:string)->bool {if !wire::validate_response("api.sync",200,value)||d::text(j::field(value,"workspace"),"id")!=workspace {return false;}for task in j::array(j::field(value,"tasks")) {if d::text(task,"workspace")!=workspace {return false;}}return true;}
fn payload_valid(value:j::Value,state:j::Value)->bool {
    if d::text(value,"schemaVersion")!="0.2"||!j::boolean(j::field(value,"local_authorized"))||!d::same(j::field(value,"identity"),j::field(state,"identity"))||d::text(value,"workspace")!=d::text(state,"workspace")||!snapshot_valid(j::field(value,"snapshot"),d::text(state,"workspace"))||!contracts::validate(wire::models(),"User",j::field(value,"user"),false)||!j::is_array(j::field(value,"queue")) {return false;}let items:Array<j::Value>=j::array(j::field(value,"queue"));if array_len::<j::Value>(items)>256 {return false;}let mut ids:Map<string,bool>=map_new::<string,bool>();for item in items {let operation:j::Value=j::field(item,"operation");let logical:j::Value=j::set(j::set(d::object(),"workspace",j::field(state,"workspace")),"operation",operation);if !wire::validate_request("api.apply_operation",logical)||!d::same(j::field(operation,"original"),j::field(state,"identity")) {return false;}let id:string=d::text(operation,"id");match map_get::<string,bool>(ids,id) {Option::Some(old)=>{return false;},Option::None=>{}}map_set::<string,bool>(inout ids,id,true);let status:string=d::text(item,"status");if status!="pending"&&status!="conflict"&&status!="rejected" {return false;}if status=="conflict"&&(!contracts::validate(wire::models(),"Conflict",j::field(item,"conflict"),false)||d::text(j::field(j::field(item,"conflict"),"server"),"workspace")!=d::text(state,"workspace")) {return false;}}
    return true;
}
fn finish(state:j::Value,commands:Array<j::Value>)->j::Value {let mut current:j::Value=state;let mut effects:Array<j::Value>=commands;persist(inout current,inout effects);replay(inout current,inout effects);let view:j::Value=j::set(current,"visible",projected(current));array_push::<j::Value>(inout effects,j::set(io::command("dom.render"),"tree",render::view(view)));let guard:bool=array_len::<j::Value>(queue(current))>0&&(!flag(current,"vault_unlocked")||d::number(j::field(current,"data_version"))>d::number(j::field(current,"persisted_version")));array_push::<j::Value>(inout effects,j::set(io::command("unload.guard"),"enabled",j::Value::Bool(guard)));return io::frame(current,effects);}
fn poll(inout state:j::Value,inout commands:Array<j::Value>)->void {let mut delay:i32=2000;if flag(state,"hidden") {delay=15000;}io::timer(inout state,inout commands,"poll",delay);}
fn new_operation(inout state:j::Value,inout commands:Array<j::Value>,task:string,patch:j::Value,kind:string,base:j::Value,conflict:j::Value)->void {
    if !drafting(state)||flag(state,"new_op_busy") {error(inout state,"Unlock an authorized offline vault or reconnect to an authorized workspace before editing.");return;}if array_len::<j::Value>(queue(state))>=256 {error(inout state,"Synchronize or resolve pending work before adding more edits.");return;}
    let mut meta:j::Value=d::object();meta=j::set(meta,"task",j::Value::Text(task));meta=j::set(meta,"patch",patch);meta=j::set(meta,"kind",j::Value::Text(kind));meta=j::set(meta,"base",base);meta=j::set(meta,"conflict",conflict);let mut purpose:string="new-operation";if task=="" {purpose="new-task";}io::pending(inout state,inout commands,io::command("random.uuid"),purpose,meta);state=j::set(state,"new_op_busy",j::Value::Bool(true));
}
fn scope(inout state:j::Value,inout commands:Array<j::Value>,identity:j::Value,workspace:string)->void {
    if array_len::<j::Value>(queue(state))>0&&(!flag(state,"vault_unlocked")||d::number(j::field(state,"data_version"))>d::number(j::field(state,"persisted_version"))) {error(inout state,"Some edits are still saving. Keep this workspace open or enable its vault before switching.");return;}
    lock(inout state,inout commands,"manual",false);state=j::set(state,"identity",identity);state=j::set(state,"workspace",j::Value::Text(workspace));state=j::set(state,"data_version",d::int(0));state=j::set(state,"persisted_version",d::int(0));state=j::set(state,"vault_enabled",j::Value::Bool(false));state=j::set(state,"quarantined",j::Value::Bool(false));state=j::set(state,"auth_paused",j::Value::Bool(false));state=j::set(state,"session_loading",j::Value::Bool(false));
    for entry in j::array(j::field(state,"vaults")) {let key:j::Value=j::field(entry,"identity");if d::same(d::identity(key),identity)&&d::text(key,"workspace")==workspace {state=j::set(state,"vault_enabled",j::Value::Bool(true));state=j::set(state,"quarantined",j::field(entry,"quarantined"));}}
    if !d::null(session(state))&&d::same(j::field(session(state),"identity"),identity) {state=j::set(state,"user",j::field(session(state),"user"));}synchronize(inout state,inout commands);
}
fn append_operation(inout state:j::Value,inout commands:Array<j::Value>,meta:j::Value,id:string)->void {
    state=j::set(state,"new_op_busy",j::Value::Bool(false));if !contracts::validate(wire::models(),"UUID",j::Value::Text(id),false) {error(inout state,"A new operation could not be identified safely.");return;}let mut operation:j::Value=d::object();for key in operation_fields() {operation=j::set(operation,key,j::field(meta,key));}operation=j::set(operation,"id",j::Value::Text(id));operation=j::set(operation,"original",j::field(state,"identity"));let dependency:j::Value=j::Value::Null();let mut previous:j::Value=dependency;
    if d::text(operation,"kind")!="resolve" {for item in queue(state) {let old:j::Value=j::field(item,"operation");if d::text(old,"task")==d::text(operation,"task") {if d::text(item,"status")=="conflict"||d::text(item,"status")=="rejected" {error(inout state,"Resolve or explicitly discard this task's earlier pending edit first.");return;}previous=j::field(old,"id");}}}operation=j::set(operation,"dependency",previous);
    let logical:j::Value=j::set(j::set(d::object(),"workspace",j::field(state,"workspace")),"operation",operation);if !wire::validate_request("api.apply_operation",logical) {error(inout state,"The task edit does not match its contract. Check its title, state and assignment.");return;}
    let mut next:j::Value=state;let version:i32=io::touch(inout next);let mut item:j::Value=j::parse("{\"status\":\"pending\"}");item=j::set(item,"operation",operation);item=j::set(item,"version",d::int(version));let mut items:Array<j::Value>=queue(next);array_push::<j::Value>(inout items,item);next=j::set(next,"queue",j::Value::Array(items));if string_len(j::canonical(payload(next)))>262144 {error(inout state,"Synchronize or resolve pending work before adding more. This draft has not been queued.");return;}state=next;
    let mut forms:j::Value=j::field(state,"forms");if d::text(operation,"kind")=="create"&&d::trim(d::text(forms,"title"))==d::text(j::field(operation,"patch"),"title") {forms=j::set(forms,"title",j::Value::Text(""));}state=j::set(state,"forms",forms);if !d::null(j::field(operation,"patch"))&&!d::null(j::field(j::field(operation,"patch"),"title"))&&d::text(state,"editor")==d::text(operation,"task")&&d::trim(d::text(forms,"edit_title"))==d::text(j::field(operation,"patch"),"title") {state=j::set(state,"editor",j::Value::Text(""));state=j::set(state,"editor_base",j::Value::Null());}error(inout state,"");if flag(state,"vault_unlocked")||flag(state,"vault_activating") {notice(inout state,"Saving this edit in the encrypted vault.");}else {notice(inout state,"Saving online. This edit is not safely queued until the server acknowledges it.");}
}
fn operation_fields()->Array<string> {return ["task","patch","kind","base","conflict"];}
fn accept_operation(inout state:j::Value,operation:j::Value,body:j::Value)->void {
    let accepted:j::Value=j::field(body,"task");let mut snapshot:j::Value=j::field(state,"snapshot");let mut tasks:Array<j::Value>=j::array(j::field(snapshot,"tasks"));let mut index:i32=-1;let mut i:i32=0;for task in tasks {if d::text(task,"id")==d::text(accepted,"id") {index=i;}i=i+1;}if index<0 {array_push::<j::Value>(inout tasks,accepted);}else if d::number(j::field(accepted,"revision"))>=d::number(j::field(tasks[index],"revision")) {tasks[index]=accepted;}snapshot=j::set(snapshot,"tasks",j::Value::Array(tasks));state=j::set(state,"snapshot",snapshot);
    let version:i32=io::touch(inout state);let mut items:Array<j::Value>=[];for item in queue(state) {let old:j::Value=j::field(item,"operation");if d::text(old,"id")==d::text(operation,"id") {continue;}let resolved:bool=d::text(operation,"kind")=="resolve"&&(d::text(j::field(item,"conflict"),"id")==d::text(operation,"conflict")||d::text(old,"kind")=="resolve"&&d::text(old,"conflict")==d::text(operation,"conflict")&&d::text(item,"status")=="rejected");if resolved {continue;}let mut next:j::Value=item;let dependency:string=d::text(old,"dependency");let mut replacing:string=d::text(operation,"id");if d::text(operation,"kind")=="resolve" {for prior in queue(state) {if d::text(j::field(prior,"conflict"),"id")==d::text(operation,"conflict")&&dependency==d::text(j::field(prior,"operation"),"id") {replacing=dependency;}}}if dependency==replacing {let mut changed:j::Value=j::set(old,"dependency",j::field(operation,"id"));let mut base:j::Value=j::field(changed,"base");if d::number(j::field(base,"revision"))<d::number(j::field(accepted,"revision")) {base=j::set(base,"revision",j::field(accepted,"revision"));}changed=j::set(changed,"base",base);next=j::set(next,"operation",changed);next=j::set(next,"version",d::int(version));}array_push::<j::Value>(inout items,next);}state=j::set(state,"queue",j::Value::Array(items));state=j::set(state,"failures",d::int(0));notice(inout state,"The server acknowledged this edit.");
}
fn accepted_matches(operation:j::Value,body:j::Value,workspace:string)->bool {let task:j::Value=j::field(body,"task");let patch:j::Value=j::field(operation,"patch");if d::text(body,"operation")!=d::text(operation,"id")||d::text(task,"id")!=d::text(operation,"task")||d::text(task,"workspace")!=workspace||d::number(j::field(task,"revision"))<1 {return false;}if !d::null(j::field(operation,"base"))&&d::number(j::field(task,"revision"))<d::number(j::field(j::field(operation,"base"),"revision")) {return false;}for key in modified_fields() {if !d::null(j::field(patch,key))&&!d::same(j::field(patch,key),j::field(task,key)) {return false;}}if j::boolean(j::field(patch,"assign"))&&!d::same(j::field(patch,"owner"),owner_id(task)) {return false;}return true;}
fn modified_fields()->Array<string> {return ["title","state"];}
fn operation_result(inout state:j::Value,inout commands:Array<j::Value>,meta:j::Value,status:i32,body:j::Value)->void {
    state=j::set(state,"replaying",j::Value::Text(""));let id:string=d::text(meta,"operation");let mut items:Array<j::Value>=queue(state);let mut index:i32=-1;let mut i:i32=0;for item in items {if d::text(j::field(item,"operation"),"id")==id {index=i;}i=i+1;}if index<0 {return;}let operation:j::Value=j::field(items[index],"operation");
    if status==200 {if !accepted_matches(operation,body,d::text(state,"workspace")) {error(inout state,"The server response did not match this edit. Pending work is retained.");state=j::set(state,"auth_paused",j::Value::Bool(true));return;}accept_operation(inout state,operation,body);synchronize(inout state,inout commands);return;}
    if status==401 {state=j::set(state,"authenticated",j::Value::Bool(false));state=j::set(state,"authorized",j::Value::Bool(false));state=j::set(state,"auth_paused",j::Value::Bool(true));state=j::set(state,"session",j::Value::Null());if d::text(body,"code")!="SESSION_EXPIRED"&&d::text(body,"code")!="AUTHENTICATION_REQUIRED" {lock(inout state,inout commands,"logout",false);}notice(inout state,"Sign in as the original identity before replay. Saved offline work is retained.");return;}
    if status==403 {let code:string=d::text(body,"code");if code=="CSRF_FAILED" {state=j::set(state,"auth_paused",j::Value::Bool(true));refresh_session(inout state,inout commands);return;}let quarantine:bool=code=="MEMBERSHIP_REVOKED";lock(inout state,inout commands,"account-switch",quarantine);state=j::set(state,"session",j::Value::Null());state=j::set(state,"authenticated",j::Value::Bool(false));notice(inout state,"Workspace authority changed. Encrypted pending work is retained and replay is paused.");catalog(inout state,inout commands);return;}
    if status>=500||status==429 {retry(inout state,inout commands);return;}
    let version:i32=io::touch(inout state);let mut item:j::Value=items[index];let conflict:j::Value=j::field(body,"conflict");if status==409&&d::text(body,"code")=="TASK_CONFLICT"&&!d::null(conflict)&&d::text(j::field(conflict,"original"),"id")==id&&d::same(j::field(j::field(conflict,"original"),"original"),j::field(state,"identity"))&&d::text(j::field(conflict,"server"),"workspace")==d::text(state,"workspace") {item=j::set(item,"status",j::Value::Text("conflict"));item=j::set(item,"conflict",conflict);}else {item=j::set(item,"status",j::Value::Text("rejected"));}item=j::set(item,"message",j::field(body,"message"));item=j::set(item,"version",d::int(version));items[index]=item;state=j::set(state,"queue",j::Value::Array(items));error(inout state,d::text(body,"message"));synchronize(inout state,inout commands);
}
fn retry(inout state:j::Value,inout commands:Array<j::Value>)->void {let mut failures:i32=d::number(j::field(state,"failures"));if failures<31 {failures=failures+1;}state=j::set(state,"failures",d::int(failures));let mut delay:i32=1000;let mut i:i32=1;while i<failures&&delay<30000 {delay=delay*2;i=i+1;}if delay>30000 {delay=30000;}io::timer(inout state,inout commands,"retry",delay);notice(inout state,"Connection failed. Pending work is retained; retrying with a bounded delay.");}
fn received_session(inout state:j::Value,inout commands:Array<j::Value>,body:j::Value)->void {
    let identity:j::Value=j::field(body,"identity");if !d::null(j::field(state,"identity"))&&!d::same(identity,j::field(state,"identity")) {lock(inout state,inout commands,"account-switch",false);let extra:j::Value=j::set(d::object(),"reason",j::Value::Text("account-switch"));io::vault(inout state,inout commands,"vault.lock-all","lock-all",extra);state=j::set(state,"workspace",j::Value::Text(""));}
    state=j::set(state,"session",body);state=j::set(state,"authenticated",j::Value::Bool(true));state=j::set(state,"network_ok",j::Value::Bool(true));state=j::set(state,"auth_paused",j::Value::Bool(false));state=j::set(state,"identity",identity);state=j::set(state,"user",j::field(body,"user"));
    let workspaces:Array<j::Value>=j::array(j::field(body,"workspaces"));if d::text(state,"workspace")==""&&array_len::<j::Value>(workspaces)>0 {scope(inout state,inout commands,identity,d::text(workspaces[0],"id"));}else {synchronize(inout state,inout commands);}notice(inout state,"Authenticated server operations check current workspace permission.");
}
fn authentication_failed(inout state:j::Value,inout commands:Array<j::Value>,code:string)->void {
    state=j::set(state,"authenticated",j::Value::Bool(false));state=j::set(state,"authorized",j::Value::Bool(false));state=j::set(state,"auth_paused",j::Value::Bool(true));state=j::set(state,"session",j::Value::Null());
    if code!="SESSION_EXPIRED"&&code!="AUTHENTICATION_REQUIRED"&&flag(state,"vault_unlocked") {lock(inout state,inout commands,"logout",false);}notice(inout state,"Sign in again before synchronizing. An unlocked authorized vault permits local drafting after session expiry.");
}
fn management(inout state:j::Value,inout commands:Array<j::Value>,method:string,url:string,endpoint:string,logical:j::Value,body:j::Value,action:string)->void {
    if !flag(state,"online")||!flag(state,"authenticated") {error(inout state,"This team operation requires a current online session.");return;}let mut content:string="";if !d::null(body) {content=j::canonical(body);}let meta:j::Value=j::set(d::object(),"action",j::Value::Text(action));io::http(inout state,inout commands,method,url,endpoint,logical,content,"management",meta);
}
fn merge_snapshot(previous:j::Value,current:j::Value)->j::Value {
    if d::null(previous)||d::text(j::field(previous,"workspace"),"id")!=d::text(j::field(current,"workspace"),"id") {return current;}
    let mut merged:j::Value=current;let mut tasks:Array<j::Value>=j::array(j::field(current,"tasks"));
    for old in j::array(j::field(previous,"tasks")) {let mut index:i32=-1;let mut i:i32=0;for task in tasks {if d::text(task,"id")==d::text(old,"id") {index=i;}i=i+1;}if index<0 {array_push::<j::Value>(inout tasks,old);}else if d::number(j::field(old,"revision"))>d::number(j::field(tasks[index],"revision")) {tasks[index]=old;}}
    merged=j::set(merged,"tasks",j::Value::Array(tasks));return merged;
}
fn restore_payload(inout state:j::Value,value:j::Value)->bool {
    let mut items:Array<j::Value>=[];let current:Array<j::Value>=queue(state);let mut changed:bool=false;
    for saved in j::array(j::field(value,"queue")) {let mut next:j::Value=j::set(saved,"version",d::int(1));for item in current {if d::text(j::field(item,"operation"),"id")==d::text(j::field(saved,"operation"),"id") {if !d::same(j::field(item,"operation"),j::field(saved,"operation")) {return false;}if !d::same(j::remove(item,"version"),j::remove(saved,"version")) {changed=true;next=j::set(item,"version",d::int(2));}}}array_push::<j::Value>(inout items,next);}
    for item in current {let mut found:bool=false;for saved in items {if d::text(j::field(item,"operation"),"id")==d::text(j::field(saved,"operation"),"id") {found=true;}}if !found {changed=true;array_push::<j::Value>(inout items,j::set(item,"version",d::int(2)));}}
    if array_len::<j::Value>(items)>256 {return false;}let mut next:j::Value=state;next=j::set(next,"queue",j::Value::Array(items));next=j::set(next,"snapshot",merge_snapshot(j::field(value,"snapshot"),j::field(state,"snapshot")));if d::null(j::field(state,"snapshot")) {next=j::set(next,"snapshot",j::field(value,"snapshot"));}next=j::set(next,"user",j::field(value,"user"));if string_len(j::canonical(payload(next)))>262144 {return false;}next=j::set(next,"data_version",d::int(1));if changed {next=j::set(next,"data_version",d::int(2));}next=j::set(next,"persisted_version",d::int(1));next=j::set(next,"authorized",j::Value::Bool(false));state=next;return true;
}
fn unsafe_pending(state:j::Value)->bool {return array_len::<j::Value>(queue(state))>0&&(!flag(state,"vault_unlocked")||d::number(j::field(state,"data_version"))>d::number(j::field(state,"persisted_version")));}
fn restore_failed(inout state:j::Value,inout commands:Array<j::Value>)->void {
    io::vault(inout state,inout commands,"vault.lock","lock",d::object());state=j::set(state,"vault_unlocked",j::Value::Bool(false));state=j::set(state,"local_authorized",j::Value::Bool(false));state=j::set(state,"auth_paused",j::Value::Bool(true));state=j::set(state,"persistence_paused",j::Value::Bool(true));
}
fn forms(state:j::Value,key:string)->string {return d::text(j::field(state,"forms"),key);}
fn edit_task(inout state:j::Value,inout commands:Array<j::Value>,id:string,patch:j::Value,base:j::Value)->void {let task:j::Value=find_task(state,id);if d::null(task) {error(inout state,"This task is no longer available.");return;}if !contracts::validate(wire::models(),"TaskBaseline",base,false) {error(inout state,"Refresh this task before saving. Its observed field baseline is required.");return;}new_operation(inout state,inout commands,id,patch,"update",base,j::Value::Null());}
fn open_vault(inout state:j::Value,inout commands:Array<j::Value>,create:bool)->void {
    let passphrase:string=forms(state,"passphrase");state=j::set(state,"forms",j::set(j::field(state,"forms"),"passphrase",j::Value::Text("")));
    if flag(state,"authenticated")&&!d::same(j::field(session(state),"identity"),j::field(state,"identity")) {error(inout state,"Sign in as the original account before unlocking this saved workspace.");return;}
    if d::text(state,"workspace")==""||d::null(j::field(state,"identity"))||flag(state,"quarantined")||flag(state,"vault_activating") {error(inout state,"Select an available workspace before opening its vault.");return;}
    if create&&(!flag(state,"authenticated")||!flag(state,"authorized")||!snapshot_valid(j::field(state,"snapshot"),d::text(state,"workspace"))) {error(inout state,"Authorize this workspace online before enabling offline drafting.");return;}
    if string_len(passphrase)<12||string_len(passphrase)>1024 {error(inout state,"Use a passphrase of at least twelve characters. There is no automatic passphrase recovery.");return;}
    io::clock(inout state,inout commands,"clock.activity");let mut cmd:j::Value=j::set(j::set(io::command("vault.unlock"),"identity",io::identity(state)),"passphrase",j::Value::Text(passphrase));let mut purpose:string="vault-unlock";let mut meta:j::Value=d::object();
    if create {cmd=j::set(cmd,"type",j::Value::Text("vault.create"));cmd=j::set(cmd,"payload",payload(state));purpose="vault-create";meta=j::set(meta,"version",j::field(state,"data_version"));}
    io::pending(inout state,inout commands,cmd,purpose,meta);state=j::set(state,"vault_activating",j::Value::Bool(true));state=j::set(state,"persisting",j::Value::Bool(true));
}
fn resolve(inout state:j::Value,inout commands:Array<j::Value>,id:string,mine:bool,preview:j::Value)->void {
    for item in queue(state) {let operation:j::Value=j::field(item,"operation");if d::text(operation,"id")==id&&d::text(item,"status")=="conflict" {let conflict:j::Value=j::field(item,"conflict");let server:j::Value=preview;if !contracts::validate(wire::models(),"Task",server,false)||d::text(server,"id")!=d::text(operation,"task")||d::text(server,"workspace")!=d::text(state,"workspace") {error(inout state,"Review the current server version before resolving this edit.");return;}let mut patch:j::Value=j::field(operation,"patch");if !mine {patch=d::object();patch=j::set(patch,"title",j::field(server,"title"));patch=j::set(patch,"state",j::field(server,"state"));patch=j::set(patch,"assign",j::Value::Bool(true));patch=j::set(patch,"owner",owner_id(server));}new_operation(inout state,inout commands,d::text(operation,"task"),patch,"resolve",baseline(server),j::field(conflict,"id"));return;}}
    error(inout state,"Select a retained conflict to resolve.");
}
fn actions(inout state:j::Value,inout commands:Array<j::Value>,event:j::Value)->void {
    let action:string=d::text(event,"type");let data:j::Value=j::field(event,"data");let id:string=j::string(data);error(inout state,"");
    if action=="ui.view" {if id=="board"||id=="team"||id=="vault" {state=j::set(state,"view",data);}return;}
    if action=="ui.sign-in"||action=="ui.switch-account" {if unsafe_pending(state) {error(inout state,"Save pending edits in the encrypted vault or explicitly discard them before leaving this page.");return;}lock(inout state,inout commands,"account-switch",false);io::vault(inout state,inout commands,"vault.lock-all","lock-all",j::set(d::object(),"reason",j::Value::Text("account-switch")));let mut url:string="/auth/login";if action=="ui.switch-account" {url=url+"?switch=true";}array_push::<j::Value>(inout commands,j::set(io::command("navigate"),"url",j::Value::Text(url)));return;}
    if action=="ui.logout" {if unsafe_pending(state) {error(inout state,"Save pending edits in the encrypted vault or explicitly discard them before signing out.");return;}management(inout state,inout commands,"POST","/api/logout","api.logout",j::Value::Null(),j::Value::Null(),"logout");return;}
    if action=="ui.workspace-select" {let identity:j::Value=j::field(session(state),"identity");scope(inout state,inout commands,identity,d::text(event,"value"));return;}
    if action=="ui.page" {let name:string=d::text(data,"column");let page:i32=d::number(j::field(data,"page"));if (name=="todo"||name=="doing"||name=="done"||name=="team"||name=="pending")&&page>=0&&page<26 {state=j::set(state,"pages",j::set(j::field(state,"pages"),name,d::int(page)));}return;}
    if action=="ui.workspace-create" {let body:j::Value=j::set(d::object(),"name",j::Value::Text(d::trim(forms(state,"workspace_name"))));management(inout state,inout commands,"POST","/api/workspaces","api.create_workspace",body,body,"workspace-created");return;}
    if action=="ui.invite-accept" {let mut token:string=forms(state,"invitation");if token=="" {token=d::text(state,"invitation_token");}let body:j::Value=j::set(d::object(),"token",j::Value::Text(token));management(inout state,inout commands,"POST","/api/invitations/accept","api.accept_invitation",body,body,"invitation-accepted");return;}
    if action=="ui.invite-create" {let body:j::Value=j::set(d::object(),"recipient",j::Value::Text(d::trim(forms(state,"recipient"))));let logical:j::Value=j::set(body,"workspace",j::field(state,"workspace"));let url:string=root(state)+"/invitations";management(inout state,inout commands,"POST",url,"api.invite",logical,body,"invitation-created");return;}
    if action=="ui.role" {let body:j::Value=j::set(d::object(),"role",j::field(event,"value"));let logical:j::Value=j::set(j::set(body,"member",data),"workspace",j::field(state,"workspace"));let url:string=root(state)+"/members/"+id;management(inout state,inout commands,"PATCH",url,"api.change_role",logical,body,"membership");return;}
    if action=="ui.remove-member" {let logical:j::Value=j::set(workspace_input(state),"member",data);let url:string=root(state)+"/members/"+id;management(inout state,inout commands,"DELETE",url,"api.remove_member",logical,j::Value::Null(),"membership");return;}
    if action=="ui.leave" {let url:string=root(state)+"/membership";let logical:j::Value=workspace_input(state);management(inout state,inout commands,"DELETE",url,"api.leave_workspace",logical,j::Value::Null(),"left");return;}
    if action=="ui.task-create" {let patch:j::Value=j::set(d::object(),"title",j::Value::Text(d::trim(forms(state,"title"))));new_operation(inout state,inout commands,"",patch,"create",j::Value::Null(),j::Value::Null());return;}
    if action=="ui.task-edit" {let task:j::Value=find_task(state,id);state=j::set(state,"editor",data);state=j::set(state,"editor_base",baseline(task));state=j::set(state,"forms",j::set(j::field(state,"forms"),"edit_title",j::field(task,"title")));return;}
    if action=="ui.task-cancel" {state=j::set(state,"editor",j::Value::Text(""));state=j::set(state,"editor_base",j::Value::Null());return;}
    if action=="ui.task-save" {let task_id:string=d::text(state,"editor");let patch:j::Value=j::set(d::object(),"title",j::Value::Text(d::trim(forms(state,"edit_title"))));let base:j::Value=j::field(state,"editor_base");edit_task(inout state,inout commands,task_id,patch,base);return;}
    if action=="ui.task-move" {if d::text(data,"workspace")!=d::text(state,"workspace") {error(inout state,"This task control belongs to a previous workspace.");return;}edit_task(inout state,inout commands,d::text(data,"task"),j::set(d::object(),"state",j::field(data,"state")),j::field(data,"base"));return;}
    if action=="ui.task-assign" {let mut owner:j::Value=j::field(event,"value");if j::string(owner)=="" {owner=j::Value::Null();}let patch:j::Value=j::set(j::set(d::object(),"assign",j::Value::Bool(true)),"owner",owner);if d::text(data,"workspace")!=d::text(state,"workspace") {error(inout state,"This task control belongs to a previous workspace.");return;}edit_task(inout state,inout commands,d::text(data,"task"),patch,j::field(data,"base"));return;}
    if action=="ui.vault-enable"||action=="ui.vault-unlock" {open_vault(inout state,inout commands,action=="ui.vault-enable");return;}
    if action=="ui.vault-select" {let entries:Array<j::Value>=j::array(j::field(state,"vaults"));let index:i32=d::number(data);if index>=0&&index<array_len::<j::Value>(entries) {let key:j::Value=j::field(entries[index],"identity");scope(inout state,inout commands,d::identity(key),d::text(key,"workspace"));state=j::set(state,"view",j::Value::Text("vault"));}return;}
    if action=="ui.vault-lock" {if unsafe_pending(state) {error(inout state,"Encrypted saving is still in progress. Retry saving before locking.");return;}lock(inout state,inout commands,"manual",false);return;}
    if action=="ui.vault-recover" {if !flag(state,"online")||!flag(state,"authenticated")||!d::same(j::field(session(state),"identity"),j::field(state,"identity")) {error(inout state,"Sign in as the original identity to recover this workspace.");return;}let url:string=root(state)+"/sync";let logical:j::Value=workspace_input(state);io::http(inout state,inout commands,"GET",url,"api.sync",logical,"","recover-check",d::object());return;}
    if action=="ui.vault-delete-confirm" {state=j::set(state,"confirm",j::Value::Text("delete-vault"));return;}
    if action=="ui.vault-delete"&&d::text(state,"confirm")=="delete-vault" {io::vault(inout state,inout commands,"vault.delete","vault-delete",d::object());return;}
    if action=="ui.persist-retry" {state=j::set(state,"persistence_paused",j::Value::Bool(false));return;}
    if action=="ui.resolve-mine"||action=="ui.resolve-server" {resolve(inout state,inout commands,d::text(data,"operation"),action=="ui.resolve-mine",j::field(data,"server"));return;}
    if action=="ui.pending-retry" {let mut items:Array<j::Value>=queue(state);let mut i:i32=0;for item in items {if d::text(j::field(item,"operation"),"id")==id&&d::text(item,"status")=="rejected" {let version:i32=io::touch(inout state);items[i]=j::set(j::set(item,"status",j::Value::Text("pending")),"version",d::int(version));}i=i+1;}state=j::set(state,"queue",j::Value::Array(items));return;}
    if action=="ui.discard-confirm" {state=j::set(state,"confirm",j::Value::Text("discard-"+id));return;}
    if action=="ui.discard"&&d::text(state,"confirm")=="discard-"+id {let mut task:string="";for item in queue(state) {if d::text(j::field(item,"operation"),"id")==id {task=d::text(j::field(item,"operation"),"task");}}let mut items:Array<j::Value>=[];let mut dropping:bool=false;for item in queue(state) {let operation:j::Value=j::field(item,"operation");if d::text(operation,"id")==id {dropping=true;}if dropping&&d::text(operation,"task")==task {if d::text(operation,"id")==d::text(state,"replaying") {error(inout state,"Wait for the in-flight edit before discarding its dependent work.");return;}}else {array_push::<j::Value>(inout items,item);}}state=j::set(state,"queue",j::Value::Array(items));state=j::set(state,"confirm",j::Value::Text(""));io::touch(inout state);notice(inout state,"The selected pending edit and its later task edits were explicitly discarded.");return;}
}
fn management_result(inout state:j::Value,inout commands:Array<j::Value>,meta:j::Value,status:i32,body:j::Value)->void {
    let action:string=d::text(meta,"action");if status==401 {authentication_failed(inout state,inout commands,d::text(body,"code"));return;}if status<200||status>=300 {error(inout state,d::text(body,"message"));if status==403&&d::text(body,"code")=="CSRF_FAILED" {refresh_session(inout state,inout commands);}return;}
    if action=="logout" {lock(inout state,inout commands,"logout",false);io::vault(inout state,inout commands,"vault.lock-all","lock-all",j::set(d::object(),"reason",j::Value::Text("logout")));state=j::set(state,"session",j::Value::Null());state=j::set(state,"authenticated",j::Value::Bool(false));notice(inout state,"Signed out. Encrypted pending work is retained and locked.");return;}
    if action=="invitation-created" {state=j::set(state,"invite_link",j::field(body,"link"));notice(inout state,"Share this single-use link with the named recipient. It expires after seven days.");return;}
    if action=="workspace-created"||action=="invitation-accepted" {let identity:j::Value=j::field(session(state),"identity");scope(inout state,inout commands,identity,d::text(body,"id"));state=j::set(state,"invitation_token",j::Value::Text(""));state=j::set(state,"forms",d::object());}
    if action=="left" {lock(inout state,inout commands,"quarantine",true);state=j::set(state,"workspace",j::Value::Text(""));notice(inout state,"You left the workspace. Any encrypted pending work remains quarantined.");}
    refresh_session(inout state,inout commands);synchronize(inout state,inout commands);
}
pub fn transition(initial:j::Value,event:j::Value)->j::Value {
    let mut state:j::Value=initial;let mut commands:Array<j::Value>=[];let kind:string=d::text(event,"type");
    if kind=="initialise" {
        state=j::parse("{\"sequence\":0,\"auth_epoch\":0,\"data_version\":0,\"persisted_version\":0,\"pending\":{},\"queue\":[],\"vaults\":[],\"forms\":{},\"view\":\"board\",\"workspace\":\"\",\"online\":true,\"network_ok\":true,\"hidden\":false,\"width\":1024}");if d::has(event,"online") {state=j::set(state,"online",j::field(event,"online"));}if d::has(event,"width") {state=j::set(state,"width",j::field(event,"width"));}let url:string=d::text(event,"url");let parts:Array<string>=string_split(url,"?");if array_len::<string>(parts)>1 {for parameter in string_split(parts[1],"&") {let value:Array<string>=string_split(parameter,"=");if array_len::<string>(value)==2&&value[0]=="invitation"&&d::hex(value[1],64) {state=j::set(state,"invitation_token",j::Value::Text(value[1]));}}}catalog(inout state,inout commands);refresh_session(inout state,inout commands);io::clock(inout state,inout commands,"clock.start");poll(inout state,inout commands);return finish(state,commands);
    }
    if kind=="platform.changed" {let online:bool=j::boolean(j::field(event,"online"));let hidden:bool=!j::boolean(j::field(event,"visible"));let changed:bool=online!=flag(state,"online");let visibility:bool=hidden!=flag(state,"hidden");state=j::set(state,"width",j::field(event,"width"));state=j::set(state,"hidden",j::Value::Bool(hidden));state=j::set(state,"online",j::Value::Bool(online));if visibility {io::clock(inout state,inout commands,"clock.poll");poll(inout state,inout commands);}if changed {if online {state=j::set(state,"authorized",j::Value::Bool(false));refresh_session(inout state,inout commands);}else {state=j::set(state,"network_ok",j::Value::Bool(false));notice(inout state,"Offline. Only edits committed to an unlocked encrypted vault are safely queued.");}}return finish(state,commands);}
    if kind=="platform.online"||kind=="platform.offline" {state=j::set(state,"online",j::Value::Bool(kind=="platform.online"));if kind=="platform.online" {state=j::set(state,"authorized",j::Value::Bool(false));refresh_session(inout state,inout commands);}else {state=j::set(state,"network_ok",j::Value::Bool(false));notice(inout state,"Offline. Only edits committed to an unlocked encrypted vault are safely queued.");}return finish(state,commands);}
    if kind=="platform.resize" {state=j::set(state,"width",j::field(event,"width"));return finish(state,commands);}
    if kind=="platform.visibilitychange" {state=j::set(state,"hidden",j::field(event,"hidden"));io::clock(inout state,inout commands,"clock.poll");poll(inout state,inout commands);return finish(state,commands);}
    if kind=="platform.activity" {io::clock(inout state,inout commands,"clock.activity");return finish(state,commands);}
    if kind=="platform.vault-lock" {let affected:bool=j::boolean(j::field(event,"all"))||d::same(j::field(event,"identity"),io::identity(state));if affected {clear_locked_state(inout state,inout commands,d::text(event,"reason")=="quarantine");if d::text(event,"reason")=="account-switch"||d::text(event,"reason")=="logout" {state=j::set(state,"session",j::Value::Null());state=j::set(state,"authenticated",j::Value::Bool(false));state=j::set(state,"auth_paused",j::Value::Bool(true));}notice(inout state,"Offline work was locked in another tab. Its encrypted queue is retained.");}return finish(state,commands);}
    if kind=="ui.field" {let key:string=j::string(j::field(event,"data"));let value:string=d::text(event,"value");if string_len(value)>4096 {error(inout state,"This field is too long.");}else {state=j::set(state,"forms",j::set(j::field(state,"forms"),key,j::Value::Text(value)));}return finish(state,commands);}
    if s::starts(kind,"ui.") {actions(inout state,inout commands,event);return finish(state,commands);}
    let id:string=d::text(event,"id");let meta:j::Value=j::field(j::field(state,"pending"),id);if !j::is_object(meta) {return finish(state,commands);}state=j::set(state,"pending",j::remove(j::field(state,"pending"),id));let purpose:string=d::text(meta,"purpose");
    if kind=="timer.fired"&&purpose=="poll" {state=j::set(state,"poll_timer",j::Value::Text(""));io::clock(inout state,inout commands,"clock.poll");if flag(state,"authenticated") {synchronize(inout state,inout commands);}else {refresh_session(inout state,inout commands);}poll(inout state,inout commands);return finish(state,commands);}
    if purpose=="catalog"&&kind=="host.complete" {if j::boolean(j::field(event,"ok")) {state=j::set(state,"vaults",j::field(event,"result"));let key:j::Value=io::identity(state);for entry in j::array(j::field(event,"result")) {if d::same(j::field(entry,"identity"),key) {state=j::set(state,"vault_enabled",j::Value::Bool(true));if j::boolean(j::field(entry,"quarantined")) {state=j::set(state,"quarantined",j::Value::Bool(true));}}}}return finish(state,commands);}
    if purpose=="lock"||purpose=="lock-all" {if !j::boolean(j::field(event,"ok")) {error(inout state,"The workspace is locked, but its storage status could not be updated. Retain the encrypted work and retry.");}return finish(state,commands);}
    if !same_scope(state,meta) {return finish(state,commands);}
    if kind=="timer.fired"&&purpose=="retry" {state=j::set(state,"retry_timer",j::Value::Text(""));if !flag(state,"authenticated") {refresh_session(inout state,inout commands);}return finish(state,commands);}
    if kind=="host.complete" {
        if s::starts(purpose,"clock.") {if !j::boolean(j::field(event,"ok"))&&flag(state,"vault_unlocked") {lock(inout state,inout commands,"inactivity",false);notice(inout state,"The vault locked because its inactivity clock could not be checked. Saved encrypted work is retained.");}if j::boolean(j::field(event,"ok")) {let now:i32=d::number(j::field(j::field(event,"result"),"monotonicSecond"));state=j::set(state,"clock_now",d::int(now));if flag(state,"vault_unlocked")&&purpose!="clock.unlock"&&(now<d::number(j::field(state,"last_activity"))||now-d::number(j::field(state,"last_activity"))>=900) {lock(inout state,inout commands,"inactivity",false);notice(inout state,"The vault locked after fifteen minutes of inactivity. Encrypted pending work is retained.");}else if purpose=="clock.unlock"||purpose=="clock.start"||purpose=="clock.activity" {state=j::set(state,"last_activity",d::int(now));}}return finish(state,commands);}
        if purpose=="new-task"||purpose=="new-operation" {if !j::boolean(j::field(event,"ok")) {state=j::set(state,"new_op_busy",j::Value::Bool(false));error(inout state,"A safe operation identifier could not be generated.");return finish(state,commands);}let uuid:string=d::text(j::field(event,"result"),"uuid");if purpose=="new-task" {let next:j::Value=j::set(meta,"task",j::Value::Text(uuid));io::pending(inout state,inout commands,io::command("random.uuid"),"new-operation",next);}else {append_operation(inout state,inout commands,meta,uuid);}return finish(state,commands);}
        if purpose=="persist" {state=j::set(state,"persisting",j::Value::Bool(false));if j::boolean(j::field(event,"ok"))&&j::boolean(j::field(j::field(event,"result"),"persisted")) {state=j::set(state,"persisted_version",j::field(meta,"version"));if array_len::<j::Value>(queue(state))>0 {notice(inout state,"Encrypted pending work is safely queued. Server replay still requires current authentication and permission.");}else {notice(inout state,"Workspace saved in the encrypted vault.");}}else {state=j::set(state,"persistence_paused",j::Value::Bool(true));error(inout state,"This edit has not been safely queued. Keep this tab open and retry encrypted saving.");}return finish(state,commands);}
        if purpose=="vault-create"||purpose=="vault-unlock" {state=j::set(state,"vault_activating",j::Value::Bool(false));if !j::boolean(j::field(event,"ok")) {state=j::set(state,"persisting",j::Value::Bool(false));error(inout state,"The vault could not be opened. Check the passphrase, quarantine status or another unlocked tab; encrypted work is retained.");return finish(state,commands);}state=j::set(state,"vault_enabled",j::Value::Bool(true));state=j::set(state,"vault_unlocked",j::Value::Bool(true));state=j::set(state,"persistence_paused",j::Value::Bool(false));state=j::set(state,"local_authorized",j::Value::Bool(true));state=j::set(state,"persisting",j::Value::Bool(false));if purpose=="vault-create" {state=j::set(state,"persisted_version",j::field(meta,"version"));}else {let value:j::Value=j::field(j::field(event,"result"),"payload");if !payload_valid(value,state) {restore_failed(inout state,inout commands);error(inout state,"Saved work needs a compatible application or review. It has not been deleted.");return finish(state,commands);}if !restore_payload(inout state,value) {restore_failed(inout state,inout commands);error(inout state,"Encrypted and current drafts disagree about an operation. Saved ciphertext and current drafts are retained for review.");return finish(state,commands);}}io::clock(inout state,inout commands,"clock.unlock");refresh_session(inout state,inout commands);catalog(inout state,inout commands);return finish(state,commands);}
        if purpose=="vault-recover" {if j::boolean(j::field(event,"ok")) {state=j::set(state,"quarantined",j::Value::Bool(false));notice(inout state,"Authorization was renewed. Enter the original passphrase to unlock retained work; recovery did not unlock keys.");catalog(inout state,inout commands);}else {error(inout state,"Retained work could not be recovered. It has not been deleted.");}return finish(state,commands);}
        if purpose=="vault-delete" {if j::boolean(j::field(event,"ok")) {lock(inout state,inout commands,"manual",false);state=j::set(state,"vault_enabled",j::Value::Bool(false));state=j::set(state,"confirm",j::Value::Text(""));catalog(inout state,inout commands);notice(inout state,"Encrypted local work was explicitly deleted.");}return finish(state,commands);}
    }
    if kind=="http.failed" {state=j::set(state,"network_ok",j::Value::Bool(false));if purpose=="session" {state=j::set(state,"session_loading",j::Value::Bool(false));}if purpose=="sync" {state=j::set(state,"sync_loading",j::Value::Bool(false));}if purpose=="operation" {state=j::set(state,"replaying",j::Value::Text(""));retry(inout state,inout commands);}else {notice(inout state,"The server is unreachable. Saved encrypted work remains available in an unlocked authorized vault.");}return finish(state,commands);}
    if kind=="http.complete" {
        let status:i32=d::number(j::field(event,"status"));let mut body:j::Value=j::Value::Null();let mut valid:bool=false;let content:string=d::text(event,"body");if content=="" {valid=wire::validate_response(d::text(meta,"endpoint"),status,body);}else {match wire::parse(content) {Result::Ok(value)=>{body=value;valid=wire::validate_response(d::text(meta,"endpoint"),status,body);},Result::Error(message)=>{}}}
        if purpose=="session" {state=j::set(state,"session_loading",j::Value::Bool(false));}if purpose=="sync" {state=j::set(state,"sync_loading",j::Value::Bool(false));}
        if !valid {if purpose=="operation" {state=j::set(state,"replaying",j::Value::Text(""));retry(inout state,inout commands);}else {error(inout state,"The server returned an unrecognized response. No saved pending work was discarded.");}return finish(state,commands);}state=j::set(state,"network_ok",j::Value::Bool(true));
        if purpose=="session" {if status==200 {received_session(inout state,inout commands,body);}else if status==401 {authentication_failed(inout state,inout commands,d::text(body,"code"));}return finish(state,commands);}
        if purpose=="sync" {if status==200&&snapshot_valid(body,d::text(state,"workspace")) {let merged:j::Value=merge_snapshot(j::field(state,"snapshot"),body);if !d::same(merged,j::field(state,"snapshot")) {state=j::set(state,"snapshot",merged);io::touch(inout state);}state=j::set(state,"authorized",j::Value::Bool(true));state=j::set(state,"auth_paused",j::Value::Bool(false));state=j::set(state,"local_authorized",j::Value::Bool(true));}else if status==401 {authentication_failed(inout state,inout commands,d::text(body,"code"));}else if status==403||status==404 {lock(inout state,inout commands,"quarantine",true);state=j::set(state,"session",j::Value::Null());state=j::set(state,"authenticated",j::Value::Bool(false));notice(inout state,"Workspace access is unavailable. Encrypted pending work is quarantined until renewed authorization or explicit deletion.");catalog(inout state,inout commands);}return finish(state,commands);}
        if purpose=="recover-check" {if status==200&&snapshot_valid(body,d::text(state,"workspace"))&&d::same(j::field(session(state),"identity"),j::field(state,"identity")) {io::vault(inout state,inout commands,"vault.recover","vault-recover",d::object());}else {error(inout state,"Fresh authorization for the original identity is required to recover this workspace.");}return finish(state,commands);}
        if purpose=="operation" {operation_result(inout state,inout commands,meta,status,body);return finish(state,commands);}
        if purpose=="management" {management_result(inout state,inout commands,meta,status,body);return finish(state,commands);}
    }
    return finish(state,commands);
}
