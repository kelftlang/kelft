// Typed helpers. Read/write authority remains separate at the host boundary.
import "../selfhost/json.kelft" as j;
pub struct Metadata {kind:string,size_bytes:string}
fn request(operation:string,path:string)->j::Value {let mut out:j::Value=j::parse("{\"schema\":\"kelft.filesystem-request/1\"}");out=j::set(out,"operation",j::Value::Text(operation));return j::set(out,"path",j::Value::Text(path));}
fn error(response:j::Value)->string {if j::field(response,"schema")!=j::Value::Text("kelft.filesystem-result/1") {return "INVALID_HOST_RESPONSE";}if !j::is_string(j::field(response,"error")) {return "INVALID_HOST_RESPONSE";}return j::string(j::field(response,"error"));}
pub fn list(path:string)->Result<Array<string>,string> {let response:j::Value=j::parse(filesystem_read(j::canonical(request("list",path))));let message:string=error(response);if message!="" {return Result::<Array<string>,string>::Error(message);}let value:j::Value=j::field(response,"value");if !j::is_array(value) {return Result::<Array<string>,string>::Error("INVALID_HOST_RESPONSE");}let mut out:Array<string>=[];for item in j::array(value) {if !j::is_string(item) {return Result::<Array<string>,string>::Error("INVALID_HOST_RESPONSE");}array_push::<string>(inout out,j::string(item));}return Result::<Array<string>,string>::Ok(out);}
fn decimal(raw:string)->bool {if raw==""||string_len(raw)>20||(string_len(raw)>1&&string_byte(raw,0)==u8_from_i32(48)) {return false;}for byte in string_to_bytes(raw) {let n:i32=i32_from_u8(byte);if n<48||n>57 {return false;}}return true;}
pub fn metadata(path:string)->Result<Metadata,string> {let response:j::Value=j::parse(filesystem_read(j::canonical(request("metadata",path))));let message:string=error(response);if message!="" {return Result::<Metadata,string>::Error(message);}let value:j::Value=j::field(response,"value");let kind:string=j::string(j::field(value,"kind"));let size:string=j::string(j::field(value,"sizeBytes"));if (kind!="file"&&kind!="directory"&&kind!="link"&&kind!="other")||!decimal(size) {return Result::<Metadata,string>::Error("INVALID_HOST_RESPONSE");}return Result::<Metadata,string>::Ok(Metadata {kind:kind,size_bytes:size});}
pub fn temporary(parent:string,prefix:string)->Result<string,string> {let input:j::Value=j::set(request("temporary",parent),"prefix",j::Value::Text(prefix));let response:j::Value=j::parse(filesystem_write(j::canonical(input)));let message:string=error(response);if message!="" {return Result::<string,string>::Error(message);}let value:j::Value=j::field(response,"value");if !j::is_string(value) {return Result::<string,string>::Error("INVALID_HOST_RESPONSE");}return Result::<string,string>::Ok(j::string(value));}
pub fn rename(source:string,destination:string)->Result<bool,string> {let input:j::Value=j::set(request("rename",source),"destination",j::Value::Text(destination));let response:j::Value=j::parse(filesystem_write(j::canonical(input)));let message:string=error(response);if message!="" {return Result::<bool,string>::Error(message);}if j::field(response,"value")!=j::Value::Bool(true) {return Result::<bool,string>::Error("INVALID_HOST_RESPONSE");}return Result::<bool,string>::Ok(true);}
pub fn remove(path:string)->Result<bool,string> {return remove_tree(path,false);}
pub fn remove_tree(path:string,recursive:bool)->Result<bool,string> {let input:j::Value=j::set(request("remove",path),"recursive",j::Value::Bool(recursive));let response:j::Value=j::parse(filesystem_write(j::canonical(input)));let message:string=error(response);if message!="" {return Result::<bool,string>::Error(message);}if j::field(response,"value")!=j::Value::Bool(true) {return Result::<bool,string>::Error("INVALID_HOST_RESPONSE");}return Result::<bool,string>::Ok(true);}
