fn expression(inout ctx:Context,n:ir::Node)->string {if ctx.replaying {return operand(inout ctx,n);}return evaluate(inout ctx,n,false);}
struct ExpressionFrame {node:ir::Node,place:bool,step:i32,index:i32,children:Array<ir::Node>,values:Array<string>,temps:Array<i32>}
fn expression_frame(n:ir::Node,place:bool)->ExpressionFrame {return ExpressionFrame {node:n,place:place,step:0,index:0,children:[],values:[],temps:[]};}
fn operand(inout ctx:Context,n:ir::Node)->string {if ctx.cached_index>=array_len::<string>(ctx.cached) {s::error("K0403","missing Wasm operand",n.span);}let out:string=ctx.cached[ctx.cached_index];ctx.cached_index=ctx.cached_index+1;return out;}
fn evaluate(inout ctx:Context,n:ir::Node,place:bool)->string {
