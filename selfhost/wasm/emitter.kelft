 while root.op=="index"||root.op=="field" {let mut key:ir::Node=root.args[0];if root.op=="index" {key=root.args[1];}else {key=ir::make("literal",i32_to_string(field(ctx.program,root)),"i32",[],root.span,false);}let mut next:Array<ir::Node>=[key];for old in keys {array_push::<ir::Node>(inout next,old);}keys=next;root=root.args[0];}
