  let body:string=statement(inout ctx,f.args[array_len::<ir::Node>(f.args)-1]);let mut code:Array<string>=[set(ctx.frame,call("alloc",[c(0),c(array_len::<string>(names)*8),c(0)]))];let mut signature:Array<string>=[];i=0;for p in params {array_push::<string>(inout signature,"i64");array_push::<string>(inout code,swide(address(ctx,p.name),g(i)));i=i+1;}array_push::<string>(inout code,body);array_push::<string>(inout code,clean(ctx,names));array_push::<string>(inout code,call("release",[op("i64.extend_i32_u",[g(ctx.frame)])]));array_push::<string>(inout code,q(0));
