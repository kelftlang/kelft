  if n.name=="&&"||n.name=="||" {let first:string=expression(inout ctx,a[0]);let second:string=expression(inout ctx,a[1]);let mut yes:string=box(c(1),3);let mut no:string=second;if n.name=="&&" {yes=second;no=box(c(0),3);}return j([set(left,first),iff(ptr(g(left)),yes,no,"i64")]);}
