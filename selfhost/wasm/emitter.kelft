fn clean(ctx:Context,names:Array<string>)->string {let mut parts:Array<string>=[];for name in names {array_push::<string>(inout parts,call("release",[wide(address(ctx,name))]));array_push::<string>(inout parts,swide(address(ctx,name),q(0)));}return j(parts);}
fn free_resources(values:Array<i32>)->string {let mut out:Array<string>=[];for value in values {array_push::<string>(inout out,call("release",[g(value)]));}return j(out);}
fn field(program:ir::Program,n:ir::Node)->i32 {if s::starts(n.args[0].ty,"(") {return s::number(n.name);}for decl in program.types {if decl.name==n.args[0].ty {let mut i:i32=0;for f in decl.args {if f.name==n.name {return i;}i=i+1;}}}s::error("K0403","Wasm field layout is missing",n.span);return 0;}
fn collect(n:ir::Node,inout names:Array<string>)->void {let mut pending:Array<ir::Node>=[n];while array_len::<ir::Node>(pending)>0 {let node:ir::Node=pending[array_len::<ir::Node>(pending)-1];array_pop::<ir::Node>(inout pending);if node.op=="bind"||node.op=="param"||node.op=="local"||node.op=="pattern"&&node.name!="_"&&node.name!="true"&&node.name!="false" {if !has(names,node.name) {array_push::<string>(inout names,node.name);}}let mut i:i32=array_len::<ir::Node>(node.args)-1;while i>=0 {array_push::<ir::Node>(inout pending,node.args[i]);i=i-1;}}}
