fn element(value:string,index:string)->string {return call("slot",[value,index]);}
fn str(value:string)->string {let hex:string="0123456789abcdef";let mut out:string="str ";for byte in string_to_bytes(value) {let n:i32=i32_from_u8(byte);out=out+s::slice(hex,n>>>4,(n>>>4)+1)+s::slice(hex,n&15,(n&15)+1);}return out;}
fn has(values:Array<string>,value:string)->bool {for old in values {if old==value {return true;}}return false;}
fn get(values:Map<string,i32>,key:string)->i32 {match map_get::<string,i32>(values,key) {Option::Some(value)=>{return value;},Option::None=>{s::error("K0403","missing Wasm local",s::span("<wasm>",0,0));}}return 0;}
