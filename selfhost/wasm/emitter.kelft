struct PatternFrame {node:ir::Node,value:string,index:i32,waiting:bool,children:Array<string>}
fn pattern_frame(n:ir::Node,value:string)->PatternFrame {return PatternFrame {node:n,value:value,index:0,waiting:false,children:[]};}
fn pattern(ctx:Context,p:ir::Node,value:string,bind:bool)->string {
 let mut pending:Array<PatternFrame>=[pattern_frame(p,value)];let mut result:string="";
 while array_len::<PatternFrame>(pending)>0 {let mut f:PatternFrame=pattern_frame(p,value);match array_pop::<PatternFrame>(inout pending) {Option::Some(v)=>{f=v;},Option::None=>{}}let node:ir::Node=f.node;
