 while array_len::<ExpressionFrame>(pending)>0 {let mut f:ExpressionFrame=expression_frame(n,false);match array_pop::<ExpressionFrame>(inout pending) {Option::Some(v)=>{f=v;},Option::None=>{}}let node:ir::Node=f.node;
  if f.step==0 {let mut count:i32=0;f.children=node.args;
   if f.place {let mut root:ir::Node=node;let mut keys:Array<ir::Node>=[];while root.op=="index"||root.op=="field" {let mut key:ir::Node=root.args[0];if root.op=="index" {key=root.args[1];}else {key=ir::make("literal",i32_to_string(field(ctx.program,root)),"i32",[],root.span,false);}array_push::<ir::Node>(inout keys,key);root=root.args[0];}f.children=[];let mut i:i32=array_len::<ir::Node>(keys)-1;while i>=0 {array_push::<ir::Node>(inout f.children,keys[i]);i=i-1;}count=3+array_len::<ir::Node>(keys);
   }else if node.op=="array"||node.op=="tuple"||node.op=="record"||node.op=="variant" {count=1+array_len::<ir::Node>(node.args);if node.op=="variant" {count=count+2;}if node.op=="record" {f.children=[];for item in node.args {array_push::<ir::Node>(inout f.children,item.args[0]);}}}
   else if node.op=="field"||node.op=="index"||node.op=="binary" {count=3;}else if node.op=="unary" {count=1;}else if node.op=="intrinsic" {count=1+array_len::<ir::Node>(node.args);}
