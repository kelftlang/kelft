fn call(name:string,args:Array<string>)->string {let mut out:Array<string>=args;array_push::<string>(inout out,"call "+name);return j(out);}
fn op(name:string,args:Array<string>)->string {let mut out:Array<string>=args;array_push::<string>(inout out,name);return j(out);}
fn iff(test:string,yes:string,no:string,result:string)->string {let mut tag:string="if";if result!="" {tag=tag+" "+result;}let mut parts:Array<string>=[test,tag,yes];if no!="" {array_push::<string>(inout parts,"else");array_push::<string>(inout parts,no);}array_push::<string>(inout parts,"end");return j(parts);}
fn ptr(value:string)->string {return op("i32.wrap_i64",[value]);}
