struct Loop {stop:string,next:string,depth:i32,resources:i32}
struct Context {program:ir::Program,names:Array<string>,slots:Map<string,i32>,inouts:Array<string>,locals:Array<string>,frame:i32,params:i32,labels:i32,scopes:Array<Array<string>>,loops:Array<Loop>,runtime_names:Array<string>,resources:Array<i32>,cached:Array<string>,cached_index:i32,cached_temps:Array<i32>,temp_index:i32,replaying:bool}
fn j(parts:Array<string>)->string {return s::join(parts,"\n");}
fn c(n:i32)->string {return "i32.const "+i32_to_string(n);}
