 if n.op=="variant" {let values:i32=temp(inout ctx,"i64");let result:i32=temp(inout ctx,"i64");return j([set(values,aggregate(inout ctx,a,[])),set(result,call("variant",[str(n.name),g(values)])),call("release",[g(values)]),g(result)]);}
 if n.op=="field"||n.op=="index" {let source:i32=temp(inout ctx,"i64");let index:i32=temp(inout ctx,"i64");let result:i32=temp(inout ctx,"i64");let first:string=expression(inout ctx,a[0]);let mut second:string="";if n.op=="index" {second=expression(inout ctx,a[1]);}else {second=box(c(field(ctx.program,n)),1);}return j([set(source,first),set(index,second),set(result,call("get",[g(source),ptr(g(index))])),call("release",[g(source)]),call("release",[g(index)]),g(result)]);}
