 }
 let mut maximum:string="";if policy!="" {maximum="1";let value:json::Value=json::parse(policy);let keys:Array<string>=["read","write"];for key in keys {let mut operation:string="r";if key=="write" {operation="w";}for root in json::array(json::field(value,key)) {let path:string=json::string(root);maximum=maximum+operation+i32_to_string(string_len(path))+":"+path;}}}
