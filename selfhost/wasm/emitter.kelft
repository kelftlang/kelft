 let values:Array<string>=["add","sub","mul","div","rem","and","or","xor","shl","shr_s","shr_u","lt_s","le_s","gt_s","ge_s"];let mut i:i32=0;for value in names {if value==name {return values[i];}i=i+1;}return "";
