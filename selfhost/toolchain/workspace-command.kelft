// Installed workspace decisions. Host operations are bounded observations and
// fixed atomic publication; no package code, shell, download or verifier runs.
import "./workspace.kelft" as w;
import "./toml.kelft" as toml;
import "./pins.kelft" as pins;
import "../json.kelft" as j;
import "../syntax.kelft" as s;
import "../hash.kelft" as h;
struct Options { command:string, json:bool, locked:bool, offline:bool, manifest:string }
fn fail(code:string,message:string,status:i32)->void {
 let mut detail:j::Value=j::parse("{}");detail=j::set(detail,"code",j::Value::Text(code));detail=j::set(detail,"message",j::Value::Text(message));
 let mut result:j::Value=j::parse("{\"schema\":\"kelft.command-result/1\",\"status\":\"failure\"}");result=j::set(result,"error",detail);result=j::set(result,"exit",j::Value::Number(i32_to_string(status)));
 let mut action:j::Value=j::parse("{\"schema\":\"kelft.workspace-action/2\",\"operation\":\"complete\"}");action=j::set(action,"result",result);println(j::canonical(action));exit(0);
}
fn need(ok:bool,message:string)->void {if !ok {fail("WORKSPACE",message,1);}}
fn options(raw:j::Value)->Options {
 need(j::is_array(raw),"workspace arguments required");let arguments:Array<j::Value>=j::array(raw);if array_len::<j::Value>(arguments)==0 {fail("INVALID_INVOCATION","workspace command required",64);}
 let command:string=j::string(arguments[0]);if command!="metadata"&&command!="tree"&&command!="lock" {fail("INVALID_INVOCATION","expected metadata, tree or lock",64);}
 let mut out:Options=Options {command:command,json:false,locked:false,offline:false,manifest:""};let mut seen:Map<string,string>=map_new::<string,string>();let mut at:i32=1;
 while at<array_len::<j::Value>(arguments) {
  need(j::is_string(arguments[at]),"argument must be text");let flag:string=j::string(arguments[at]);match map_get::<string,string>(seen,flag) {Option::Some(previous)=>{fail("INVALID_INVOCATION","duplicate workspace option: "+flag,64);},Option::None=>{}}map_set::<string,string>(inout seen,flag,flag);
  if flag=="--json" {out.json=true;}else if flag=="--locked" {out.locked=true;}else if flag=="--offline" {out.offline=true;}
  else if flag=="--manifest-path" {at=at+1;if at>=array_len::<j::Value>(arguments)||!j::is_string(arguments[at])||j::string(arguments[at])==""||s::starts(j::string(arguments[at]),"-") {fail("INVALID_INVOCATION","manifest path value required",64);}out.manifest=j::string(arguments[at]);}
  else {fail("INVALID_INVOCATION","unknown workspace option: "+flag,64);}at=at+1;
 }
 return out;
}
fn action(operation:string,root:i32,paths:Array<j::Value>)->j::Value {
 let mut out:j::Value=j::parse("{\"schema\":\"kelft.workspace-action/2\"}");out=j::set(out,"operation",j::Value::Text(operation));out=j::set(out,"root",j::Value::Number(i32_to_string(root)));return j::set(out,"paths",j::Value::Array(paths));
}
fn relative(ancestor:string,near:string)->string {
 let mut parts:Array<string>=[];if ancestor!="" {parts=string_split(ancestor,"/");}let mut drop:i32=0;if near!="" {drop=array_len::<string>(string_split(near,"/"));}
 need(array_len::<string>(parts)>=drop,"inconsistent discovery observations");let mut n:i32=0;let mut out:Array<string>=[];while n<array_len::<string>(parts)-drop {array_push::<string>(inout out,parts[n]);n=n+1;}return s::join(out,"/");
}
fn discover(rows:Array<j::Value>,explicit:bool)->i32 {
 need(array_len::<j::Value>(rows)>0&&array_len::<j::Value>(rows)<=32,"workspace discovery limit");let mut nearest:i32=-1;let mut selected:i32=-1;let mut index:i32=0;
 for row in rows {
  let raw:j::Value=j::field(row,"manifest");
  if raw!=j::Value::Null() {
   need(j::is_string(raw),"invalid discovery manifest");let manifest:j::Value=toml::parse(j::string(raw),"<discovery>/kelft.toml");w::validate(manifest);
   if nearest<0 {nearest=index;selected=index;}
   if j::is_object(j::field(manifest,"workspace")) {
    if nearest==index {return index;}
    let member:string=relative(j::string(j::field(row,"relative")),j::string(j::field(rows[nearest],"relative")));let mut included:bool=false;
    for value in j::array(j::field(j::field(manifest,"workspace"),"members")) {if j::string(value)==member {included=true;}}
    need(included,"package is not an explicit member of its containing workspace");return index;
   }
  }else if index==0&&explicit {fail("MISSING_MANIFEST","explicit kelft.toml does not exist",1);}
  index=index+1;
 }
 if selected<0 {fail("MISSING_MANIFEST","no kelft.toml found in this directory or its ancestors",1);}return selected;
}
fn locked_text(data:j::Value)->string {
 let mut out:string="# Generated by Kelft. Local manifest graph only; not a package-content or toolchain pin.\nschema = 1\ncontract = \"kelft-local-lock/1\"\nroot-manifest-sha256 = "+s::json_quote(j::string(j::field(data,"rootManifestSHA256")))+"\n\n[resolution]\nalgorithm = \"kelft-local-paths/1\"\nsource-edition = \"0.1\"\n";
 if j::field(data,"lockContract")==j::Value::Text("kelft-local-lock/2") {out=pins::lock_header(data);}
 for node in j::array(j::field(data,"packages")) {
  let package:j::Value=j::field(node,"package");out=out+"\n[[package]]\nid = "+s::json_quote(j::string(j::field(node,"id")))+"\nname = "+s::json_quote(j::string(j::field(package,"name")))+"\nversion = "+s::json_quote(j::string(j::field(package,"version")))+"\nsource = \"path\"\nedition = \"0.1\"\nmanifest-sha256 = "+s::json_quote(j::string(j::field(node,"manifestSHA256")))+"\n";
  if j::field(package,"namespace")!=j::Value::Null() {out=out+"namespace = "+s::json_quote(j::string(j::field(package,"namespace")))+"\n";}
  let mut dependencies:Array<string>=[];for (alias,id) in j::object(j::field(node,"dependencies")) {array_push::<string>(inout dependencies,"{ alias = "+s::json_quote(alias)+", package = "+s::json_quote(j::string(id))+" }");}out=out+"dependencies = ["+s::join(dependencies,", ")+"]\n";
  if j::field(data,"lockContract")==j::Value::Text("kelft-local-lock/2") {let mut files:Array<string>=[];for (path,value) in j::object(j::field(node,"sourceFiles")) {array_push::<string>(inout files,"{ path = "+s::json_quote(path)+", size = "+j::canonical(j::field(value,"size"))+", sha256 = "+s::json_quote(j::string(j::field(value,"sha256")))+" }");}out=out+"source-sha256 = "+s::json_quote(j::string(j::field(node,"sourceSHA256")))+"\nfiles = ["+s::join(files,", ")+"]\n";}
 }
 return out;
}
fn tree(data:j::Value)->string {
 let mut out:string="";for node in j::array(j::field(data,"packages")) {let package:j::Value=j::field(node,"package");out=out+j::string(j::field(package,"name"))+"@"+j::string(j::field(package,"version"))+" ("+j::string(j::field(node,"id"))+")\n";for (alias,id) in j::object(j::field(node,"dependencies")) {out=out+"  "+alias+" -> "+j::string(id)+"\n";}}return out;
}
pub fn decide(request:j::Value)->j::Value {
 need(j::string(j::field(request,"schema"))=="kelft.workspace-command/2","unsupported workspace command request");let opt:Options=options(j::field(request,"arguments"));
 if j::field(request,"ancestors")==j::Value::Null() {let mut out:j::Value=action("discover",0,[]);out=j::set(out,"manifest",j::Value::Text(opt.manifest));return out;}
 let root:i32=discover(j::array(j::field(request,"ancestors")),opt.manifest!="");
 if j::field(request,"selectedRoot")!=j::Value::Number(i32_to_string(root)) {return action("select-root",root,[]);}
 let files:j::Value=j::field(request,"manifests");let pending:Array<j::Value>=w::pending(files);if array_len::<j::Value>(pending)>0 {return action("read-manifests",root,pending);}
 let snapshot:j::Value=j::set(j::parse("{\"schema\":\"kelft.workspace-request/1\"}"),"manifests",files);let mut data:j::Value=j::field(w::metadata(snapshot),"data");let locks:j::Value=j::field(request,"locks");let mut paths:Array<j::Value>=[];let mut wanted:Map<string,string>=map_new::<string,string>();map_set::<string,string>(inout wanted,"kelft.lock","kelft.lock");
 for node in j::array(j::field(data,"packages")) {let dir:string=w::directory(j::string(j::field(node,"manifest")));if dir!="" {map_set::<string,string>(inout wanted,dir+"/kelft.lock",dir);}}
 for (path,unused) in wanted {match map_get::<string,j::Value>(j::object(locks),path) {Option::Some(value)=>{if path!="kelft.lock" {need(value==j::Value::Null(),"only the workspace root may contain kelft.lock: "+path);}},Option::None=>{array_push::<j::Value>(inout paths,j::Value::Text(path));}}}
 if array_len::<j::Value>(paths)>0 {return action("read-locks",root,paths);}
 let tools:j::Value=j::field(request,"toolchains");let mut missing:Array<j::Value>=[];for (path,unused) in wanted {let tool:string=s::slice(path,0,string_len(path)-10)+"kelft-toolchain.toml";match map_get::<string,j::Value>(j::object(tools),tool) {Option::Some(value)=>{if tool!="kelft-toolchain.toml" {need(value==j::Value::Null(),"only the workspace root may contain kelft-toolchain.toml: "+tool);}},Option::None=>{array_push::<j::Value>(inout missing,j::Value::Text(tool));}}}
 if array_len::<j::Value>(missing)>0 {return action("read-toolchains",root,missing);}
 let toolchain:j::Value=j::field(tools,"kelft-toolchain.toml");if toolchain!=j::Value::Null() {
  let verified:j::Value=pins::toolchain(toolchain,j::field(request,"installedToolchain"));let sources:j::Value=j::field(request,"sources");let mut pending_sources:Array<j::Value>=[];for value in pins::paths(data) {let path:string=j::string(value);match map_get::<string,j::Value>(j::object(sources),path) {Option::Some(item)=>{},Option::None=>{if array_len::<j::Value>(pending_sources)<128 {array_push::<j::Value>(inout pending_sources,value);}}}}
  if array_len::<j::Value>(pending_sources)>0 {return action("read-sources",root,pending_sources);}
  data=pins::sources(data,sources);for (key,value) in j::object(verified) {data=j::set(data,key,value);}
 }
 let expected:string=locked_text(data);let actual:j::Value=j::field(locks,"kelft.lock");let current:bool=actual==j::Value::Text(expected);let mut state:string="stale";if actual==j::Value::Null() {state="missing";}if current {state="current";}
 if opt.locked&&!current {fail("LOCKED_WORKSPACE","kelft.lock is "+state+"; run kelft lock explicitly before using --locked",1);}
 if opt.command=="lock"&&!current {
  if !j::boolean(j::field(request,"exclusive")) {return action("acquire-lock",root,[]);}
  let mut out:j::Value=action("publish-lock",root,[]);out=j::set(out,"contents",j::Value::Text(expected));return out;
 }
 data=j::set(data,"lockfileImplemented",j::Value::Bool(true));if toolchain==j::Value::Null() {data=j::set(data,"lockContract",j::Value::Text("kelft-local-lock/1"));data=j::set(data,"lockScope",j::Value::Text("local-manifest-graph"));}data=j::set(data,"lockStatus",j::Value::Text(state));data=j::set(data,"expectedLockSHA256",j::Value::Text(h::sha256(expected)));let mut actual_hash:j::Value=j::Value::Null();if j::is_string(actual) {actual_hash=j::Value::Text(h::sha256(j::string(actual)));}data=j::set(data,"lockSHA256",actual_hash);data=j::set(data,"offline",j::Value::Bool(true));data=j::set(data,"lockChanged",j::Value::Bool(j::boolean(j::field(request,"published"))));
 let mut result:j::Value=j::parse("{\"schema\":\"kelft.command-result/1\",\"status\":\"success\",\"exit\":0}");result=j::set(result,"command",j::Value::Text(opt.command));result=j::set(result,"data",data);
 let mut out:j::Value=action("complete",root,[]);out=j::set(out,"result",result);out=j::set(out,"json",j::Value::Bool(opt.json));let mut text:string=j::canonical(data)+"\n";if opt.command=="tree" {text=tree(data);}if opt.command=="lock" {text="kelft.lock "+state+" (local manifest graph)\n";if toolchain!=j::Value::Null() {text="kelft.lock "+state+" (declared sources and toolchain pins)\n";}}return j::set(out,"text",j::Value::Text(text));
}
fn main()->void {
 let arguments:Array<string>=args();need(array_len::<string>(arguments)==1,"private workspace command request required");
 match read_file(arguments[0]) {Result::Ok(bytes)=>{need(array_len::<u8>(bytes)<=4194304,"workspace command request exceeds 4 MiB");match utf8_decode(bytes) {Result::Ok(raw)=>{println(j::canonical(decide(j::parse(raw))));},Result::Error(message)=>{need(false,"invalid UTF-8 request");}}},Result::Error(message)=>{need(false,"cannot read workspace command request");}}
}
