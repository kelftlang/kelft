x => x !== null)) {\n    const roots = policy[operation];\n    if (!Array.isArray(roots) || !roots.some(root => typeof root === 'string' && kWithin(canonical, root))) kTrap('KRT_CAPABILITY');\n  }\n  return canonical;\n}\nfunction kReadFile(path, text) {\n  const authorized = kAuthorize(path, 'read');\n  try { const bytes = kFS.readFileSync(authorized); return kOk(text ? kDecode(bytes) : kVector([...bytes])); }\n  catch (e) { if (e instanceof KTrap) throw e; return kError(kIOError(e)); }\n}\nfunction kWriteFile(path, value, text) {\n  const authorized = kAuthorize(path, 'write');\n  try { kFS.writeFileSync(authorized, text ? value : Buffer.from(kValues(value))); return kOk(true); }\n  catch (e) { if (e instanceof KTrap) throw e; return kError(kIOError(e)); }\n}\nfunction kIter(value) { return value.tag === 'map' ? value.items.map(kTuple) : kValues(value); }\nfunction kRunArtifact(bytes, target, args, policyText) {\n  if (!kExternalPolicy.execute || kMaximumPolicy !== null && !kMaximumPolicy.execute) kTrap('KRT_CAPABILITY');\n  if (target !== 'javascript' && target !== 'wasm') return kError('UNSUPPORTED_ARTIFACT_TARGET');\n  const policy = JSON.parse(policyText);\n  for (const operation of ['read', 'write']) {\n    if (!Array.isArray(policy[operation]) || !policy[operation].every(root => typeof root === 'string')) return kError('INVALID_POLICY');\n    for (const root of policy[operation]) kAuthorize(root, operation);\n  }\n  // Execution authority is never delegated to the child artifact.\n  policy.execute = false;\n  const dir = kFS.mkdtempSync(kPathModule.join(kOS.tmpdir(), 'kelft-artifact-'));\n  try {\n    const file = kPathModule.join(dir, target === 'wasm' ? 'program.wasm' : 'program.mjs'); kFS.writeFileSync(file, Buffer.from(kValues(bytes)));\n    const policyFile = kPathModule.join(dir, 'policy.json'); kFS.writeFileSync(policyFile, JSON.stringify(policy));\n    const executable = target === 'wasm' ? process.env.KELFT_WASI_DRIVER ?? kPathModule.join(process.cwd(), 'driver', 'target', 'release', process.platform === 'win32' ? 'kelft-wasi.exe' : 'kelft-wasi') : process.execPath;\n    const commandArgs = target === 'wasm' ? ['exec', file, '--project-root', process.cwd(), '--capabilities', policyFile, '--', ...kValues(args)] : [file, ...kValues(args)];\n    const child = kChildProcess.spawnSync(executable, commandArgs, { encoding: 'utf8', timeout: 30000, maxBuffer: 16 * 1024 * 1024,\n      env: { ...Object.fromEntries(['PATH','Path','SystemRoot','SYSTEMROOT','WINDIR','TEMP','TMP','TMPDIR','LANG','LC_ALL'].filter(key=>process.env[key]!==undefined).map(key=>[key,process.env[key]])), NODE_OPTIONS: '', NODE_PATH: '', KELFT_CAPABILITIES: JSON.stringify(policy) } });\n    if (child.error || child.signal || child.status === null) return kError('ARTIFACT_EXECUTION_FAILED');\n    return kOk(kTuple([child.status, child.stdout, child.stderr]));\n  } finally { kFS.rmSync(dir, { recursive: true, force: true }); }\n}\n// Reference host mechanisms. Native authority is enforced by the installed\n// broker; Node's filesystem observations are not native confinement evidence.\nfunction kFilesystemRequest(raw, writing) {\n  const schema='kelft.filesystem-result/1';\n  try {\n    if (Buffer.byteLength(raw)>65536) return JSON.stringify({schema,error:'INVALID_REQUEST',value:null});\n    const r=JSON.parse(raw), names=r?.operation==='rename'?['schema','operation','path','destination']:r?.operation==='temporary'?['schema','operation','path','prefix']:r?.operation==='remove'?['schema','operation','path','recursive']:['schema','operation','path'];\n    if(!r||Array.isArray(r)||r.schema!=='kelft.filesystem-request/1'||Object.keys(r).some(k=>!names.includes(k))||typeof r.path!=='string'||r.path.includes('\\0')||!['list','metadata','temporary','rename','remove'].includes(r.operation)||writing!==['temporary','rename','remove'].includes(r.operation))return JSON.stringify({schema,error:'INVALID_REQUEST',value:null});\n    const noLinks=(source,operation,lea