pub fn js_runtime() -> string { return "import * as kNativeFS from 'node:fs';\nimport * as kNativePathModule from 'node:path';\nimport * as kChildProcess from 'node:child_process';\nimport * as kOS from 'node:os';\nconst kEngineFilesystem = globalThis[Symbol.for('kelft.engine.filesystem/1')];\nconst kFS = kEngineFilesystem?.filesystem ?? kNativeFS;\nconst kPathModule = kEngineFilesystem?.path ?? kNativePathModule;\nclass KTrap extends Error { constructor(code) { super(code); this.code = code; } }\nclass KExit extends Error { constructor(code) { super(\"exit\"); this.code = code; } }\nconst kTrap = code => { throw new KTrap(code); };\n// Immutable strings may be read repeatedly by the self-hosted lexer/JSON reader.\n// Separate size classes keep numeric tokens from evicting the source buffer.\nconst kUtf8Cache = [];\nfunction kUtf8Bytes(value) {\n  for (const entry of kUtf8Cache) if(entry.value===value)return entry.bytes;\n  const bytes=Buffer.from(value);\n  // The compiler protocol permits 64 MiB payloads, including whole-compiler Core.\n  if(bytes.length<=64*1024*1024){\n    const large=bytes.length>=4096,index=kUtf8Cache.findIndex(entry=>entry.large===large),entry={value,bytes,large};\n    if(index<0)kUtf8Cache.push(entry);else kUtf8Cache[index]=entry;\n  }\n  return bytes;\n}\nfunction kUtf8Length(value) {\n  for (const entry of kUtf8Cache) if(entry.value===value)return entry.bytes.length;\n  return Buffer.byteLength(value);\n}\nconst kCell = initial => { let value = initial; return { get: () => value, set: next => { value = next; } }; };\n// Persistent radix-32 vectors: assignment shares immutable backing trees.\nfunction kVector(items = []) { let v = { tag: 'array', size: 0, depth: 0, root: [] }; for (const x of items) v = kPush(v, x); return v; }\nfunction kTreeSet(tree, depth, index, value) {\n  const copy = tree.slice(); const slot = Math.floor(index / 32 ** depth) % 32;\n  copy[slot] = depth === 0 ? value : kTreeSet(tree[slot] ?? [], depth - 1, index, value); return copy;\n}\nfunction kPush(v, value) {\n  let root = v.root, depth = v.depth;\n  if (v.size === 32 ** (depth + 1)) { root = [root]; depth++; }\n  return { tag: 'array', size: v.size + 1, depth, root: kTreeSet(root, depth, v.size, value) };\n}\nfunction kGet(v, index) {\n  if (!Number.isInteger(index) || index < 0 || index >= v.size) kTrap('KRT_BOUNDS');\n  let tree = v.root; for (let d = v.depth; d > 0; d--) tree = tree[Math.floor(index / 32 ** d) % 32]; return tree[index % 32];\n}\nfunction kSet(v, index, value) { kGet(v, index); return { ...v, root: kTreeSet(v.root, v.depth, index, value) }; }\nfunction kValues(v) { const a = []; for (let i = 0; i < v.size; i++) a.push(kGet(v, i)); return a; }\nconst kTuple = items => ({ tag: 'tuple', items });\nconst kRecord = entries => ({ tag: 'record', fields: Object.assign(Object.create(null), Object.fromEntries(entries)) });\nconst kVariant = (name, values = []) => ({ tag: 'variant', name, values });\nconst kOk = value => kVariant('Ok', [value]);\nconst kError = value => kVariant('Error', [value]);\nconst kIOError = e => e.code === 'EPERM' ? 'EACCES' : ['ENOENT','EACCES','EEXIST','ENOTDIR','EISDIR'].includes(e.code) ? e.code : 'IO_ERROR';\nfunction kField(v, key) { return v.tag === 'tuple' ? v.items[Number(key)] : v.fields[key]; }\nfunction kChild(v, key) { return v.tag === 'array' ? kGet(v, key) : kField(v, key); }\nfunction kUpdate(v, keys, value) {\n  if (!keys.length) return value;\n  const [key, ...rest] = keys, child = kUpdate(kChild(v, key), rest, value);\n  if (v.tag === 'array') return kSet(v, key, child);\n  if (v.tag === 'tuple') { const items = v.items.slice(); items[Number(key)] = child; return kTuple(items); }\n  const fields = Object.assign(Object.create(null), v.fields); fields[key] = child; return { tag: 'record', fields };\n}\nfunction kLocation(root, keys) {\n  // Passing an existing inout root adds no evaluated path. Reuse its cell.\n  if (!keys.length) return root;\n  return { get: () => keys.re