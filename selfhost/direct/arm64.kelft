pub fn encode_program(p:ir::Program)->Array<Code> {if p.target!="arm64"||p.platform!="linux" {b::error("expected private Linux ARM64 IR");}let mut validated:ir::Program=p;validated.target="x86_64";ir::verify(validated);let mut imports:Array<string>=[];for a in p.imports {array_push::<string>(inout imports,a.name);}let opcode_registry:Map<string,i32>=opcodes::registry();let mut out:Array<Code>=[];for f in p.functions {array_push::<Code>(inout out,encode_registered(f.name,ir::lower(f,imports),opcode_registry));}return out;}
