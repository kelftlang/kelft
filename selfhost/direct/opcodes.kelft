// Private opcode dispatch.
// The immutable table is shared for a complete function, including platform wrappers.
pub fn registry()->Map<string,i32> {
 let mut values:Map<string,i32>=map_new::<string,i32>();
 let names:Array<string>=["add","address","and","arg_address","arm_linux_close","arm_linux_exit","arm_linux_fchmod","arm_linux_getcwd","arm_linux_map","arm_linux_mkdirat","arm_linux_read","arm_linux_readlinkat","arm_linux_start","arm_linux_unmap","arm_linux_write","call","context","darwin_api","darwin_start","div_s","eq","ge_s","goto","gt_s","imm","label","le_s","linux_artifact_clock_gettime","linux_artifact_close_range","linux_artifact_dup2","linux_artifact_execveat","linux_artifact_exit","linux_artifact_fcntl","linux_artifact_fork","linux_artifact_getpid","linux_artifact_getppid","linux_artifact_kill","linux_artifact_lseek","linux_artifact_memfd_create","linux_artifact_pipe2","linux_artifact_poll","linux_artifact_prctl","linux_artifact_setpgid","linux_artifact_size","linux_artifact_wait4","linux_capture_process","linux_check_exit_result","linux_close","linux_core_context","linux_engine_limits","linux_entry","linux_exit_result","linux_exit_value","linux_fchmod","linux_fs_context","linux_fs_entry","linux_getcwd","linux_heap_context","linux_heap_entry","linux_linker_limits","linux_map","linux_mkdirat","linux_openat2","linux_process_context","linux_read","linux_readlinkat","linux_reset_arguments","linux_unmap","linux_write","linux_write_error","load","loc_address","lt_s","mask_u8","mul","ne","nonzero","or","out_address","prologue","ptr_add","ptr_eq","read","rem_s","return","save","second","shl","shr_s","shr_u","slot_address","sub","symbol_address","trap","windows_api","windows_start","write","xor"];
 let ids:Array<i32>=[993596020,745154899,254395046,1471864344,2045938239,-193686831,1405890082,1260799395,969167693,793972201,-1869325295,483132072,-224374653,-1972619776,817269784,-1276017495,-1937305476,-1956410691,1059693933,-332448462,1142581827,1804211731,-173862938,-585182360,2129075090,-157870083,699435220,-332442225,-553116235,-1881810696,2014810848,1959743953,649549332,-1921625107,-1638292116,71936918,-200668763,-1074700701,-852042043,2092530317,1406590764,-1630335072,-1912801381,-822997312,-267281352,1929372990,-1043520699,-60862558,652709309,-192260839,68661502,-608435030,824112576,-329006911,2053668141,-883723542,-1192017736,1635314640,1527960135,88941590,926229024,-1980136536,2012789891,2064718255,-1214220898,1936094547,1270148970,-1229058575,650092225,-1878086884,-435725847,1992971310,1404448415,-285466473,-343609983,1479958588,1790618910,1563699588,-216729632,-656573192,1697139769,376154780,-824204347,-2091945951,-2047985729,-855671224,-1409755939,-533861450,-1849078538,-1815523300,-1491298942,-598853355,-434141662,1619038978,-1118287963,-996325371,-1104765092,-865346690];
 let mut index:i32=0;while index<array_len::<string>(names) {map_set::<string,i32>(inout values,names[index],ids[index]);index=index+1;}
 return values;
}
pub fn identify(op:string,values:Map<string,i32>)->i32 {
 if string_len(op)==0||string_len(op)>64 {return -1;}
 match map_get::<string,i32>(values,op) {Option::Some(value)=>{return value;},Option::None=>{return -1;}}
}
