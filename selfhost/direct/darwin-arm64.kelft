 let op_le_s:i32=699435220;
 let op_load:i32=-435725847;
 let op_loc_address:i32=1992971310;
 let op_lt_s:i32=1404448415;
 let op_mask_u8:i32=-285466473;
 let op_mul:i32=-343609983;
 let op_ne:i32=1479958588;
 let op_nonzero:i32=1790618910;
 let op_or:i32=1563699588;
 let op_out_address:i32=-216729632;
 let op_prologue:i32=-656573192;
 let op_ptr_add:i32=1697139769;
 let op_ptr_eq:i32=376154780;
 let op_read:i32=-824204347;
 let op_rem_s:i32=-2091945951;
 let op_return:i32=-2047985729;
 let op_save:i32=-855671224;
 let op_second:i32=-1409755939;
 let op_shl:i32=-533861450;
 let op_shr_s:i32=-1849078538;
 let op_shr_u:i32=-1815523300;
 let op_slot_address:i32=-1491298942;
 let op_sub:i32=-598853355;
 let op_symbol_address:i32=-434141662;
 let op_trap:i32=1619038978;
 let op_write:i32=-1104765092;
 let op_xor:i32=-865346690;
 // END generated opcode constants




 if array_len::<x::Machine>(instructions)==3&&instructions[1].op=="darwin_api" {if instructions[0].op!="prologue"||instructions[0].a!=64||instructions[2].op!="return"||instructions[2].a!=instructions[1].b {b::error("invalid Apple ARM64 mechanism frame");}return mechanism(name,instructions[1]);}
 if array_len::<x::Machine>(instructions)==2&&instructions[1].op=="darwin_start" {if name!="k_start"||instructions[0].op!="prologue"||instructions[0].a!=256||instructions[1].a!=0||instructions[1].b!=0||instructions[1].symbol!="k_darwin_main" {b::error("invalid Apple ARM64 startup");}return startup();}
 let mut lowered:Array<x::Machine>=[];for i in instructions {let operation_id:i32=opcodes::identify(i.op,opcode_registry);let found:bool=(operation_id==op_prologue||operation_id==op_label||operation_id==op_goto||operation_id==op_nonzero||operation_id==op_imm||operation_id==op_mask_u8||operation_id==op_load||operation_id==op_second||operation_id==op_save||operation_id==op_context||operation_id==op_arg_address||operation_id==op_loc_address||operation_id==op_out_address||operation_id==op_slot_address||operation_id==op_read||operation_id==op_write||operation_id==op_ptr_add||operation_id==op_ptr_eq||operation_id==op_add||operation_id==op_sub||operation_id==op_mul||operation_id==op_and||operation_id==op_or||operation_id==op_xor||operation_id==op_shl||operation_id==op_shr_s||operation_id==op_shr_u||operation_id==op_div_s||operation_id==op_rem_s||operation_id==op_eq||operation_id==op_ne||operation_id==op_lt_s||operation_id==op_le_s||operation_id==op_gt_s||operation_id==op_ge_s||operation_id==op_address||operation_id==op_symbol_address||operation_id==op_call||operation_id==op_trap||operation_id==op_return);if !found {b::error("unsupported platform ARM64 operation "+i.op);}let mut instruction:x::Machine=i;if operation_id==op_address {instruction.op="symbol_address";}array_push::<x::Machine>(inout lowered,instruction);}return convert(arm::encode_registered(name,lowered,opcode_registry));
}
pub fn encode_program(p:ir::Program)->Array<Code> {if p.platform!="macos"||p.target!="arm64" {b::error("expected private Apple ARM64 IR");}let mut validated:ir::Program=p;validated.platform="linux";validated.target="x86_64";ir::verify(validated);let mut imports:Array<string>=[];for a in p.imports {array_push::<string>(inout imports,a.name);}let opcode_registry:Map<string,i32>=opcodes::registry();let mut out:Array<Code>=[];for f in p.functions {array_push::<Code>(inout out,encode_registered(f.name,ir::lower(f,imports),opcode_registry));}return out;}
