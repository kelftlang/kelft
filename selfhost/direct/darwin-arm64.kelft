pub struct Code {name:string,bytes:Bytes,relocations:Array<x::Relocation>,frame_size:i32,returns:Array<i32>}
fn convert(c:arm::Code)->Code {return Code {name:c.name,bytes:c.bytes,relocations:c.relocations,frame_size:c.frame_size,returns:c.returns};}
fn word(inout out:Bytes,value:i32)->void {b::word(inout out,value);}
fn load(inout out:Bytes,reg:i32,offset:i32,width:i32)->void {let mut op:i32=-130023424;if width==4 {op=-1203765248;}word(inout out,op+(offset&511)*4096+29*32+reg);}
fn store(inout out:Bytes,reg:i32,offset:i32)->void {word(inout out,-134217728+(offset&511)*4096+29*32+reg);}
fn address(inout out:Bytes,reg:i32,offset:i32)->void {word(inout out,-788529152+(-offset)*1024+29*32+reg);}
fn call(inout out:Bytes,inout relocations:Array<x::Relocation>,name:string)->void {array_push::<x::Relocation>(inout relocations,x::Relocation {offset:array_len::<u8>(out),symbol:name,kind:"call26",addend:0});word(inout out,-1811939328);}
fn mechanism(name:string,i:x::Machine)->Code {
 let fixed:ir::Signature=api::get(i.symbol);let mut width:i32=4;if fixed.result=="void" {width=0;}if fixed.result=="ptr" {width=8;}if name!="k_darwin_"+i.symbol||i.a!=array_len::<string>(fixed.params)||i.a>6||i.b!=width {b::error("invalid Apple ARM64 mechanism signature");}
 let base:arm::Code=arm::encode(name,[x::make("prologue",64,0,""),x::make("return",width,0,"")]);let mut suffix:i32=20;if width==0 {suffix=12;}let prefix:i32=array_len::<u8>(base.bytes)-suffix;if prefix!=28 {b::error("Apple ARM64 bridge frame changed");}let mut out:Bytes=[];let mut n:i32=0;while n<prefix {array_push::<u8>(inout out,base.bytes[n]);n=n+1;}let mut relocations:Array<x::Relocation>=[];load(inout out,11,-16,8);n=0;
 let variadic:i32=api::variadic_start(i.symbol);while n<array_len::<string>(fixed.params) {let mut op:i32=-1186988032;let mut offset:i32=n*2;if fixed.params[n]=="ptr" {op=-113246208;offset=n;}let mut reg:i32=n;let stack:bool=variadic>=0&&n>=variadic;if stack {reg=9;}word(inout out,op+offset*1024+11*32+reg);if stack {word(inout out,-117440512+(n-variadic)*1024+31*32+reg);}n=n+1;}call(inout out,inout relocations,i.symbol);if width!=0 {let mut op:i32=704644073;if width==8 {op=-1442839575;}word(inout out,op);}let added:i32=array_len::<u8>(out)-prefix;n=prefix;while n<array_len::<u8>(base.bytes) {array_push::<u8>(inout out,base.bytes[n]);n=n+1;}let mut returns:Array<i32>=[];for pc in base.returns {array_push::<i32>(inout returns,pc+added);}return Code {name:name,bytes:out,relocations:relocations,frame_size:64,returns:returns};
}
fn startup()->Code {
 let base:arm::Code=arm::encode("k_start",[x::make("prologue",256,0,""),x::make("trap",0,0,"")]);let mut out:Bytes=[];let mut n:i32=0;while n<array_len::<u8>(base.bytes)-4 {array_push::<u8>(inout out,base.bytes[n]);n=n+1;}let mut relocations:Array<x::Relocation>=[];word(inout out,1384120329);let mut positions:Array<i32>=[-208,-200];n=0;while n<16 {array_push::<i32>(inout positions,-192+n*8);n=n+1;}for at in positions {store(inout out,9,at);}let from:Array<i32>=[-8,-16,-24];let to:Array<i32>=[-128,-120,-112];n=0;while n<3 {load(inout out,9,from[n],8);store(inout out,9,to[n]);n=n+1;}address(inout out,0,-192);address(inout out,1,-208);address(inout out,2,-208);address(inout out,3,-200);call(inout out,inout relocations,"k_darwin_main");load(inout out,0,-200,4);call(inout out,inout relocations,"_exit");word(inout out,-736100352);return Code {name:"k_start",bytes:out,relocations:relocations,frame_size:256,returns:[]};
}
pub fn encode(name:string,instructions:Array<x::Machine>)->Code {return encode_registered(name,instructions,opcodes::registry());}
pub fn encode_registered(name:string,instructions:Array<x::Machine>,opcode_registry:Map<string,i32>)->Code {
 // BEGIN generated opcode constants
 let op_add:i32=993596020;
 let op_address:i32=745154899;
 let op_and:i32=254395046;
 let op_arg_address:i32=1471864344;
 let op_call:i32=-1276017495;
 let op_context:i32=-1937305476;
 let op_div_s:i32=-332448462;
 let op_eq:i32=1142581827;
 let op_ge_s:i32=1804211731;
