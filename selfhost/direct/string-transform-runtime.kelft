// Trusted private literal transforms; no public pointer operations.
import "./builder.kelft" as g;
import "./ir.kelft" as ir;
fn guard(inout b:g::Builder,condition:i32,code:string)->void {let bad:string=g::label(inout b);let good:string=g::label(inout b);g::branch(inout b,condition,bad,good);g::begin(inout b,bad);g::call(inout b,"k_panic_"+code,[],"void",[]);g::end(inout b,ir::End {op:"trap",value:-1,label:"",condition:-1,yes:"",no:""});g::begin(inout b,good);}
pub fn string_transform_functions()->Array<ir::Function> {
 let mut functions:Array<ir::Function>=[];
 build_k_string_matches(inout functions);
 build_k_string_write(inout functions);
 build_k_string_split(inout functions);
 build_k_string_replace(inout functions);
 return functions;
}

fn build_k_string_matches(inout functions:Array<ir::Function>)->void {
  let mut b:g::Builder=g::builder("k_string_matches",["ptr","ptr"],0,"i32");
  let source:i32=g::argument(inout b,0);
  let needle:i32=g::argument(inout b,1);
  let size:i32=g::load(inout b,needle,8,"i32");
  let t3:i32=g::c(inout b,0);
  let t4:i32=g::binary(inout b,"eq",size,t3);
  guard(inout b,t4,"KRT_EMPTY_SEPARATOR");
  let position:i32=g::c(inout b,0);
  let count:i32=g::c(inout b,0);
  let test:string=g::label(inout b);
  let matched:string=g::label(inout b);
  let done:string=g::label(inout b);
  g::jump(inout b,test);
  g::begin(inout b,test);
  let found:i32=g::call(inout b,"k_string_find",[source,needle,position],"i32",[]);
  let t11:i32=g::c(inout b,0);
  let t12:i32=g::binary(inout b,"ge_s",found,t11);
  g::branch(inout b,t12,matched,done);
  g::begin(inout b,matched);
  let t13:i32=g::c(inout b,1);
  let t14:i32=g::binary(inout b,"add",count,t13);
  g::assign(inout b,count,t14);
  let t15:i32=g::binary(inout b,"add",found,size);
  g::assign(inout b,position,t15);
  g::jump(inout b,test);
  g::begin(inout b,done);
  g::ret(inout b,count);
  array_push::<ir::Function>(inout functions,g::finish(b));
 }

fn build_k_string_write(inout functions:Array<ir::Function>)->void {
  let mut b:g::Builder=g::builder("k_string_write",["ptr","i32","i32","ptr","i32"],0,"void");
  let source:i32=g::argument(inout b,0);
  let start:i32=g::argument(inout b,1);
  let end:i32=g::argument(inout b,2);
  let destination:i32=g::argument(inout b,3);
  let offset:i32=g::argument(inout b,4);
  let index:i32=g::copy(inout b,start);
  let test:string=g::label(inout b);
  let body:string=g::label(inout b);
  let done:string=g::label(inout b);
  g::jump(inout b,test);
  g::begin(inout b,test);
  let t25:i32=g::binary(inout b,"lt_s",index,end);
  g::branch(inout b,t25,body,done);
  g::begin(inout b,body);
  let t26:i32=g::c(inout b,40);
  let t27:i32=g::binary(inout b,"add",t26,index);
  let t28:i32=g::pointer(inout b,source,t27);
  let value:i32=g::load(inout b,t28,0,"u8");
  let t30:i32=g::binary(inout b,"sub",index,start);
  let at:i32=g::binary(inout b,"add",offset,t30);
  let t32:i32=g::c(inout b,40);
  let t33:i32=g::binary(inout b,"add",t32,at);
  let t34:i32=g::pointer(inout b,destination,t33);
  g::store(inout b,t34,0,value);
  let t35:i32=g::c(inout b,1);
  let t36:i32=g::binary(inout b,"add",index,t35);
  g::assign(inout b,index,t36);
  g::jump(inout b,test);
  g::begin(inout b,done);
  g::ret(inout b,-1);
  array_push::<ir::Function>(inout functions,g::finish(b));
 }

fn build_k_string_split(inout functions:Array<ir::Function>)->void {
  let mut b:g::Builder=g::builder("k_string_split",["ptr","ptr"],0,"ptr");
  let source:i32=g::argument(inout b,0);
  let separator:i32=g::argument(inout b,1);
  let length:i32=g::load(inout b,source,8,"i32");
  let size:i32=g::load(inout b,separator,8,"i32");
  let matches:i32=g::call(inout b,"k_string_matches",[source,separator],"i32",[]);
  let t42:i32=g::c(inout b,1);
  let count:i32=g::binary(inout b,"add",matches,t42);
  let t44:i32=g::c(inout b,1);
  let out:i32=g::call(inout b,"k_array_alloc",[count,t44],"ptr",[]);
  let position:i32=g::c(inout b,0);
  let index:i32=g::c(inout b,0);
  let test:string=g::label(inout b);
  let body:string=g::label(inout b);
  let tail:string=g::label(inout b);
  let copy:string=g::label(inout b);
  let done:string=g::label(inout b);
  g::jump(inout b,test);
  g::begin(inout b,test);
  let t53:i32=g::binary(inout b,"lt_s",index,count);
  g::branch(inout b,t53,body,done);
  g::begin(inout b,body);
  let end:i32=g::call(inout b,"k_string_find",[source,separator,position],"i32",[]);
  let t55:i32=g::c(inout b,0);
  let t56:i32=g::binary(inout b,"lt_s",end,t55);
  g::branch(inout b,t56,tail,copy);
  g::begin(inout b,tail);
  g::assign(inout b,end,length);
  g::jump(inout b,copy);
  g::begin(inout b,copy);
  let t57:i32=g::c(inout b,40);
  let t58:i32=g::binary(inout b,"add",t57,position);
  let data:i32=g::pointer(inout b,source,t58);
  let t60:i32=g::binary(inout b,"sub",end,position);
  let part:i32=g::call(inout b,"k_string_copy",[data,t60],"ptr",[]);
  let t62:i32=g::c(inout b,40);
  let t63:i32=g::c(inout b,8);
  let t64:i32=g::binary(inout b,"mul",index,t63);
  let t65:i32=g::binary(inout b,"add",t62,t64);
  let t66:i32=g::pointer(inout b,out,t65);
  g::store(inout b,t66,0,part);
  let t67:i32=g::binary(inout b,"add",end,size);
  g::assign(inout b,position,t67);
  let t68:i32=g::c(inout b,1);
  let t69:i32=g::binary(inout b,"add",index,t68);
  g::assign(inout b,index,t69);
  g::jump(inout b,test);
  g::begin(inout b,done);
  g::ret(inout b,out);
  array_push::<ir::Function>(inout functions,g::finish(b));
 }

fn build_k_string_replace(inout functions:Array<ir::Function>)->void {
  let mut b:g::Builder=g::builder("k_string_replace",["ptr","ptr","ptr"],0,"ptr");
  let source:i32=g::argument(inout b,0);
  let needle:i32=g::argument(inout b,1);
  let replacement:i32=g::argument(inout b,2);
  let length:i32=g::load(inout b,source,8,"i32");
  let size:i32=g::load(inout b,needle,8,"i32");
  let replacementSize:i32=g::load(inout b,replacement,8,"i32");
  let matches:i32=g::call(inout b,"k_string_matches",[source,needle],"i32",[]);
  let delta:i32=g::binary(inout b,"sub",replacementSize,size);
  let grow:string=g::label(inout b);
  let allocate:string=g::label(inout b);
  let t80:i32=g::c(inout b,0);
  let t81:i32=g::binary(inout b,"gt_s",delta,t80);
  g::branch(inout b,t81,grow,allocate);
  g::begin(inout b,grow);
  let t82:i32=g::c(inout b,268435400);
  let t83:i32=g::binary(inout b,"sub",t82,length);
  let t84:i32=g::binary(inout b,"div_s",t83,delta);
  let t85:i32=g::binary(inout b,"gt_s",matches,t84);
  g::guard(inout b,t85);
  g::jump(inout b,allocate);
  g::begin(inout b,allocate);
  let t86:i32=g::binary(inout b,"mul",matches,delta);
  let total:i32=g::binary(inout b,"add",length,t86);
  let t88:i32=g::c(inout b,0);
  let t89:i32=g::c(inout b,0);
  let t90:i32=g::nil(inout b);
  let out:i32=g::call(inout b,"k_heap_alloc",[total,t88,t89,t90],"ptr",[]);
  let position:i32=g::c(inout b,0);
  let offset:i32=g::c(inout b,0);
  let test:string=g::label(inout b);
  let body:string=g::label(inout b);
  let done:string=g::label(inout b);
  g::jump(inout b,test);
  g::begin(inout b,test);
  let found:i32=g::call(inout b,"k_string_find",[source,needle,position],"i32",[]);
  let t98:i32=g::c(inout b,0);
  let t99:i32=g::binary(inout b,"ge_s",found,t98);
  g::branch(inout b,t99,body,done);
  g::begin(inout b,body);
  g::call(inout b,"k_string_write",[source,position,found,out,offset],"void",[]);
  let t100:i32=g::binary(inout b,"sub",found,position);
  let t101:i32=g::binary(inout b,"add",offset,t100);
  g::assign(inout b,offset,t101);
  let t102:i32=g::c(inout b,0);
  g::call(inout b,"k_string_write",[replacement,t102,replacementSize,out,offset],"void",[]);
  let t103:i32=g::binary(inout b,"add",offset,replacementSize);
  g::assign(inout b,offset,t103);
  let t104:i32=g::binary(inout b,"add",found,size);
  g::assign(inout b,position,t104);
  g::jump(inout b,test);
  g::begin(inout b,done);
  g::call(inout b,"k_string_write",[source,position,length,out,offset],"void",[]);
  g::ret(inout b,out);
  array_push::<ir::Function>(inout functions,g::finish(b));
 }
