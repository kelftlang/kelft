pub fn write_object(inout object:Object)->Bytes {let data:Array<elf::Data>=object.data;let imports:Array<string>=object.imports;let metadata:string=object.metadata;return coff::consume(inout object.code,data,imports,metadata);}
pub fn emit_object(p:c::Program,limit:i32)->Bytes {let mut out:Object=build(p,limit);return write_object(inout out);}

pub fn build(p:c::Program,limit:i32)->Object {return build_with_policy(p,limit,"{\"execute\":false,\"read\":[],\"write\":[]}");}
pub fn emit_object_with_policy(p:c::Program,limit:i32,maximum:string)->Bytes {let mut out:Object=build_with_policy(p,limit,maximum);return write_object(inout out);}
