pub fn consume_bytes(inout p:c::Program,limit:i32,maximum:string)->Bytes {let mut out:Object=consume_object(inout p,limit,maximum);return write_object(inout out);}

pub fn build_with_policy(p:c::Program,limit:i32,maximum:string)->Object {return build_selected(p,limit,maximum,false);}
pub fn build_guest_with_policy(p:c::Program,limit:i32,maximum:string)->Object {return build_selected(p,limit,maximum,true);}
pub fn consume_object(inout p:c::Program,limit:i32,maximum:string)->Object {return consume_selected(inout p,limit,maximum,false);}
pub fn consume_guest_object(inout p:c::Program,limit:i32,maximum:string)->Object {return consume_selected(inout p,limit,maximum,true);}
