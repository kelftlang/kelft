 let mut functions:Array<ir::Function>=[];add(inout functions,heap::functions());add(inout functions,ar::array_functions());add(inout functions,ar::enum_functions());add(inout functions,strings::string_functions());add(inout functions,streams::stream_functions());add(inout functions,maps::functions());add(inout functions,graphs::functions());array_push::<ir::Function>(inout functions,ar::location_function());add(inout functions,process::functions());add(inout functions,paths::functions());add(inout functions,fs_policy::functions());add(inout functions,fs_runtime::functions());add(inout functions,writes::functions());add(inout functions,artifact::functions_for(183));let mut data:Array<elf::Data>=aggregate::lowering_data(plan);for value in runtime_data::data("arm64") {array_push::<elf::Data>(inout data,value);}array_push::<elf::Data>(inout data,elf::Data {name:"k_fs_maximum",bytes:string_to_bytes(fsmaximum)});
