pub struct Object {code:Array<d::Code>,data:Array<elf::Data>,imports:Array<string>,metadata:string}
fn present(values:Map<string,i32>,name:string)->bool {match map_get::<string,i32>(values,name) {Option::Some(value)=>{return true;},Option::None=>{return false;}}}
fn add(inout values:Array<ir::Function>,items:Array<ir::Function>)->void {for item in items {array_push::<ir::Function>(inout values,item);}}
fn trap(inout f:bb::Builder)->void {bb::end(inout f,ir::End {op:"trap",value:-1,label:"",condition:-1,yes:"",no:""});}
fn unsupported(root:c::Node)->void {let mut pending:Array<c::Node>=[root];while array_len::<c::Node>(pending)>0 {let n:c::Node=pending[array_len::<c::Node>(pending)-1];array_pop::<c::Node>(inout pending);let denied:Array<string>=[];if n.op=="intrinsic" {for name in denied {if name==n.name {b::error("Linux ARM64 host adapter is not implemented: "+n.name);}}}let mut i:i32=array_len::<c::Node>(n.args)-1;while i>=0 {array_push::<c::Node>(inout pending,n.args[i]);i=i-1;}}}
fn panic_function(name:string,size:i32)->ir::Function {let mut f:bb::Builder=bb::builder(name,[],0,"void");let pointer:i32=bb::slot(inout f,"ptr");let mut address:ir::Instruction=ir::instruction("address",pointer);address.symbol=name+"_text";bb::emit(inout f,address);let fd:i32=bb::c(inout f,2);let length:i32=bb::c(inout f,size);bb::call(inout f,"k_os_write",[fd,pointer,length],"i32",[]);let status:i32=bb::c(inout f,1);bb::call(inout f,"k_scalar_exit",[status],"void",[]);trap(inout f);return bb::finish(f);}
fn main_function(p:c::Program,limit:i32,maximum:string,host_used:bool)->ir::Function {let mut entry:i32=-1;let mut index:i32=0;for f in p.functions {if f.name==p.entry {entry=index;}index=index+1;}if entry<0 {b::error("Linux ARM64 Core entry missing");}let mut f:bb::Builder=bb::builder("k_linux_arm_main",[],0,"i32");let context:i32=bb::context(inout f);let heap_limit:i32=bb::c(inout f,limit);bb::store(inout f,context,12,heap_limit);let mut filesystem:bool=host_used;for e in p.effects {if e=="fs.read"||e=="fs.write"||e=="artifact.execute" {filesystem=true;}}if filesystem {let raw:i32=bb::slot(inout f,"ptr");let mut a:ir::Instruction=ir::instruction("address",raw);a.symbol="k_fs_maximum";bb::emit(inout f,a);let size:i32=bb::c(inout f,string_len(maximum));bb::call(inout f,"k_fs_init",[raw,size],"void",[]);}let mut result_type:string="i32";if p.functions[entry].ty=="void" {result_type="void";}let result:i32=bb::call(inout f,"kf"+i32_to_string(entry),[],result_type,[]);if host_used {bb::call(inout f,"k_fs_cleanup",[],"void",[]);}if filesystem&&!host_used {let a:i32=bb::load(inout f,context,88,"ptr");bb::call(inout f,"k_heap_release",[a],"void",[]);let z:i32=bb::load(inout f,context,96,"ptr");bb::call(inout f,"k_heap_release",[z],"void",[]);let nil_a:i32=bb::nil(inout f);bb::store(inout f,context,88,nil_a);let nil_z:i32=bb::nil(inout f);bb::store(inout f,context,96,nil_z);let wa:i32=bb::load(inout f,context,104,"ptr");bb::call(inout f,"k_heap_release",[wa],"void",[]);let wz:i32=bb::load(inout f,context,112,"ptr");bb::call(inout f,"k_heap_release",[wz],"void",[]);let nil_wa:i32=bb::nil(inout f);bb::store(inout f,context,104,nil_wa);let nil_wz:i32=bb::nil(inout f);bb::store(inout f,context,112,nil_wz);}let live:i32=bb::load(inout f,context,4,"i32");let zero:i32=bb::c(inout f,0);let leaked:i32=bb::binary(inout f,"ne",live,zero);bb::guard(inout f,leaked);let mut status:i32=result;if result<0 {status=bb::c(inout f,0);}let lower:i32=bb::c(inout f,0);let negative:i32=bb::binary(inout f,"lt_s",status,lower);let upper:i32=bb::c(inout f,255);let excessive:i32=bb::binary(inout f,"gt_s",status,upper);let invalid:i32=bb::binary(inout f,"or",negative,excessive);let bad:string=bb::label(inout f);let good:string=bb::label(inout f);bb::branch(inout f,invalid,bad,good);bb::begin(inout f,bad);bb::call(inout f,"k_panic_KRT_EXIT",[],"void",[]);trap(inout f);bb::begin(inout f,good);bb::ret(inout f,status);return bb::finish(f);}
pub fn build(p:c::Program,limit:i32,maximum:string)->Object {
 let host_used:bool=host_policy::uses_host(p);let fsmaximum:string=host_policy::filesystem_maximum(maximum);
 let parsed:j::Value=j::parse(fsmaximum);let mut valid:bool=j::is_object(parsed)&&j::canonical(parsed)==fsmaximum&&string_len(fsmaximum)<=1048576;for (key,value) in j::object(parsed) {if key=="execute" {if !j::is_bool(value) {valid=false;}}else if key=="read"||key=="write" {if !j::is_array(value) {valid=false;}for root in j::array(value) {if !j::is_string(root) {valid=false;}else {let name:string=j::string(root);if string_len(name)>=4096||string_find(name,string_from_codepoint(0),0)>=0 {valid=false;}}}}else {valid=false;}}if !valid {b::error("invalid native maximum policy");}
 if limit<4096||limit>268435456 {b::error("invalid Linux ARM64 development heap limit");}for f in p.functions {unsupported(f);}let lowered:ir::Program=aggregate::lower(p);let mut functions:Array<ir::Function>=lowered.functions;add(inout functions,heap::functions());add(inout functions,ar::array_functions());add(inout functions,ar::enum_functions());add(inout functions,strings::string_functions());add(inout functions,streams::stream_functions());add(inout functions,maps::functions());add(inout functions,graphs::functions());array_push::<ir::Function>(inout functions,ar::location_function());add(inout functions,process::functions());add(inout functions,paths::functions());add(inout functions,fs_policy::functions());add(inout functions,fs_runtime::functions());add(inout functions,writes::functions());add(inout functions,artifact::functions_for(183));let mut data:Array<elf::Data>=[];let replacement:Array<elf::Data>=runtime_data::data("arm64");for value in lowered.data {let mut selected:elf::Data=value;for candidate in replacement {if candidate.name==value.name {selected=candidate;}}array_push::<elf::Data>(inout data,selected);}array_push::<elf::Data>(inout data,elf::Data {name:"k_fs_maximum",bytes:string_to_bytes(fsmaximum)});
 if host_used {let mut additions:Array<ir::Function>=guest::functions();add(inout additions,host_runtime::unix_functions());let mut selected:Array<ir::Function>=[];for f in functions {let mut overridden:bool=false;for value in additions {if value.name==f.name {overridden=true;}}if !overridden {array_push::<ir::Function>(inout selected,f);}}functions=selected;add(inout functions,additions);for value in guest::data() {array_push::<elf::Data>(inout data,value);}for value in host_runtime::data() {array_push::<elf::Data>(inout data,value);}array_push::<elf::Data>(inout data,host_policy::host_maximum(maximum));}
 let mut traps:Array<string>=["k_panic_KRT_RESOURCE","k_panic_KRT_EXIT"];let mut seen:Map<string,i32>=map_new::<string,i32>();for name in traps {map_set::<string,i32>(inout seen,name,1);}for f in functions {for block in f.blocks {for i in block.instructions {if i.op=="call"&&string_find(i.symbol,"k_panic_",0)==0&&!present(seen,i.symbol) {array_push::<string>(inout traps,i.symbol);map_set::<string,i32>(inout seen,i.symbol,1);}}}}
 for at in b::name_order(traps) {let name:string=traps[at];let symbol:string=name+"_text";let bytes:Bytes=string_to_bytes("error["+string_slice(name,8,string_len(name))+"]\n");let mut exists:bool=false;for d in data {if d.name==symbol {exists=true;}}if !exists {array_push::<elf::Data>(inout data,elf::Data {name:symbol,bytes:bytes});}array_push::<ir::Function>(inout functions,panic_function(name,array_len::<u8>(bytes)));}array_push::<ir::Function>(inout functions,main_function(p,limit,fsmaximum,host_used));
 let apis:Array<ir::Signature>=signatures();let mut n:i32=0;let mut ids:Map<string,i32>=map_new::<string,i32>();n=0;for f in functions {map_set::<string,i32>(inout ids,f.name,n);n=n+1;}let mut reachable:Map<string,i32>=map_new::<string,i32>();let mut used_data:Map<string,i32>=map_new::<string,i32>();let mut pending:Array<string>=["k_linux_arm_main"];let mut cursor:i32=0;
 while cursor<array_len::<string>(pending) {let name:string=pending[cursor];cursor=cursor+1;if present(reachable,name) {continue;}map_set::<string,i32>(inout reachable,name,1);match map_get::<string,i32>(ids,name) {Option::Some(index)=>{let f:ir::Function=functions[index];for block in f.blocks {for i in block.instructions {if i.op=="call" {array_push::<string>(inout pending,i.symbol);}else if i.op=="address" {map_set::<string,i32>(inout used_data,i.symbol,1);}}}},Option::None=>{let mut known:bool=false;for a in apis {if a.name==name {known=true;}}if !known {b::error("Linux ARM64 mechanism unavailable: "+name);}}}}
 let mut selected:Array<ir::Function>=[];for f in functions {if present(reachable,f.name) {array_push::<ir::Function>(inout selected,f);}}let mut selected_data:Array<elf::Data>=[];for value in data {if present(used_data,value.name) {array_push::<elf::Data>(inout selected_data,value);}}let mut selected_apis:Array<ir::Signature>=[];for a in apis {if present(reachable,a.name) {array_push::<ir::Signature>(inout selected_apis,a);}}
 let program:ir::Program=ir::Program {schema:"kelft-native-ir/1",target:"arm64",platform:"linux",abi:"kelft-native/1",functions:selected,imports:selected_apis,data:selected_data};let mut code:Array<d::Code>=d::encode_program(program);
 for a in selected_apis {let mut width:i32=4;if a.result=="void" {width=0;}if a.result=="ptr" {width=8;}array_push::<d::Code>(inout code,d::encode(a.name,[x::make("prologue",64,0,""),x::make(mechanism(a.name),0,0,""),x::make("return",width,0,"")]));}
 array_push::<d::Code>(inout code,d::encode("_start",[x::make("prologue",256,0,""),x::make("arm_linux_start",0,0,"k_linux_arm_main")]));let metadata:string="{\"schema\":\"kelft-native-object/1\",\"platform\":\"linux\",\"target\":\"arm64\",\"format\":\"elf64\",\"runtimeABI\":\"kelft-native/1\",\"heapLimit\":"+i32_to_string(limit)+",\"status\":\"development-owned-core-process-paths-and-streams\",\"productionClosureVerified\":false,\"maximum\":"+maximum+"}";return Object {code:code,data:selected_data,imports:[],metadata:metadata};
}
pub fn write_object(inout object:Object)->Bytes {let data:Array<elf::Data>=object.data;let imports:Array<string>=object.imports;let metadata:string=object.metadata;return arm_elf::consume(inout object.code,data,imports,metadata);}
pub fn emit_object(p:c::Program,limit:i32,maximum:string)->Bytes {let mut out:Object=build(p,limit,maximum);return write_object(inout out);}
fn signatures()->Array<ir::Signature> {let mut out:Array<ir::Signature>=[ir::Signature {name:"k_os_map",params:["i32"],locations:0,result:"ptr"},ir::Signature {name:"k_os_unmap",params:["ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"k_os_write",params:["i32","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"k_os_getcwd",params:["ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"k_scalar_exit",params:["i32"],locations:0,result:"void"},ir::Signature {name:"k_os_openat2",params:["i32","ptr","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"k_os_readlinkat",params:["i32","ptr","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"k_os_read",params:["i32","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"k_os_close",params:["i32"],locations:0,result:"i32"},ir::Signature {name:"k_os_mkdirat",params:["i32","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"k_os_fchmod",params:["i32","i32"],locations:0,result:"i32"}];for item in services::signatures() {array_push::<ir::Signature>(inout out,item);}return out;}
fn mechanism(name:string)->string {if name=="k_os_map" {return "arm_linux_map";}if name=="k_os_unmap" {return "arm_linux_unmap";}if name=="k_os_write" {return "arm_linux_write";}if name=="k_os_getcwd" {return "arm_linux_getcwd";}if name=="k_scalar_exit" {return "arm_linux_exit";}if name=="k_os_openat2" {return "arm_linux_openat2";}if name=="k_os_readlinkat" {return "arm_linux_readlinkat";}if name=="k_os_read" {return "arm_linux_read";}if name=="k_os_close" {return "arm_linux_close";}if name=="k_os_mkdirat" {return "arm_linux_mkdirat";}if name=="k_os_fchmod" {return "arm_linux_fchmod";}return services::mechanism(name);}

// Consume checked Core before allocating whole executable sections.
fn encoded_core(f:c::Node,declarations:Array<c::Node>,plan:aggregate::Lowering,environment:ir::Environment,imported:Array<string>,opcode_registry:Map<string,i32>,inout literals:Array<elf::Data>)->d::Code {let first:i32=array_len::<elf::Data>(literals);let lowered:ir::Function=aggregate::lower_planned(f,declarations,plan,inout literals);ir::verify_part(lowered,environment,array_slice::<elf::Data>(literals,first,array_len::<elf::Data>(literals)));return d::encode_registered(lowered.name,ir::lower(lowered,imported),opcode_registry);}
pub fn consume_object(inout p:c::Program,limit:i32,maximum:string)->Object {
 let host_used:bool=host_policy::uses_host(p);let fsmaximum:string=host_policy::filesystem_maximum(maximum);
 let parsed:j::Value=j::parse(fsmaximum);let mut valid:bool=j::is_object(parsed)&&j::canonical(parsed)==fsmaximum&&string_len(fsmaximum)<=1048576;for (key,value) in j::object(parsed) {if key=="execute" {if !j::is_bool(value) {valid=false;}}else if key=="read"||key=="write" {if !j::is_array(value) {valid=false;}for root in j::array(value) {if !j::is_string(root) {valid=false;}else {let name:string=j::string(root);if string_len(name)>=4096||string_find(name,string_from_codepoint(0),0)>=0 {valid=false;}}}}else {valid=false;}}if !valid {b::error("invalid native maximum policy");}
