pub fn replace(items:Array<ir::Function>)->Array<ir::Function> {
 let replacements:Array<ir::Function>=functions();let mut out:Array<ir::Function>=[];
 for item in items {let mut selected:ir::Function=item;for replacement in replacements {if replacement.name==item.name {selected=replacement;}}array_push::<ir::Function>(inout out,selected);}
 for replacement in replacements {let mut present:bool=false;for item in items {if item.name==replacement.name {present=true;}}if !present {array_push::<ir::Function>(inout out,replacement);}}
 return out;
}
