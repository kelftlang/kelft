// Release-locked component policy. Host observations are mechanisms, never
// decisions: this Kelft program owns selection, compatibility and USTAR checks.
import "../json.kelft" as j;
import "../hash.kelft" as h;
import "../syntax.kelft" as s;
fn error(code:string,message:string,status:i32)->void {
 let mut out:j::Value=j::parse("{\"schema\":\"kelft.command-result/1\",\"command\":\"target\",\"status\":\"failure\"}");
 let mut detail:j::Value=j::parse("{}");detail=j::set(detail,"code",j::Value::Text(code));detail=j::set(detail,"message",j::Value::Text(message));out=j::set(out,"error",detail);out=j::set(out,"exit",j::Value::Number(i32_to_string(status)));println(j::canonical(out));exit(status);
}
fn need(ok:bool,message:string)->void {if !ok {error("TARGET_COMPONENT",message,1);}}
fn field(v:j::Value,key:string)->string {let value:j::Value=j::field(v,key);need(j::is_string(value),"missing string: "+key);return j::string(value);}
fn number(v:j::Value,key:string)->i32 {let value:j::Value=j::field(v,key);need(j::is_number(value),"missing number: "+key);match value {j::Value::Number(raw)=>{match string_to_i32(raw) {Result::Ok(n)=>{need(n>=0,"negative quantity");return n;},Result::Error(message)=>{need(false,"quantity exceeds bound");}}},_=>{}}return 0;}
fn digest(value:string)->void {need(string_len(value)==71&&s::starts(value,"sha256:"),"SHA-256 required");let mut i:i32=7;while i<71 {let b:i32=s::byte(value,i);need((b>=48&&b<=57)||(b>=97&&b<=102),"invalid SHA-256");i=i+1;}}
fn lower(value:string)->string {let mut out:string="";for byte in string_to_bytes(value) {let mut b:i32=i32_from_u8(byte);if b>=65&&b<=90 {b=b+32;}out=out+string_from_codepoint(b);}return out;}
fn path(value:string)->void {
 need(string_len(value)>0&&string_len(value)<=100&&!s::starts(value,"/"),"archive path bound");
 for byte in string_to_bytes(value) {let b:i32=i32_from_u8(byte);need(b>=33&&b<=126&&string_find("\\:<>\"|?*",string_from_codepoint(b),0)<0,"nonportable archive path");}
 for part in string_split(value,"/") {need(part!=""&&part!="."&&part!=".."&&s::byte(part,string_len(part)-1)!=46&&s::byte(part,string_len(part)-1)!=32,"archive traversal or alias");let base:string=lower(string_split(part,".")[0]);need(base!="con"&&base!="prn"&&base!="aux"&&base!="nul"&&base!="conin$"&&base!="conout$","archive device alias");if string_len(base)==4&&(s::starts(base,"com")||s::starts(base,"lpt")) {let b:i32=s::byte(base,3);need(b<49||b>57,"archive device alias");}}
}
fn normalize(value:string)->string {
 if value=="x86_64-linux"||value=="linux-x86_64" {return "linux-x86_64";}
 if value=="x86_64-windows"||value=="windows-x86_64" {return "windows-x86_64";}
 error("UNSUPPORTED_TARGET_PROFILE","unsupported target: "+value,1);return "";
}
fn components(catalog:j::Value)->Array<j::Value> {
 need(field(catalog,"schema")=="kelft.target-catalog/1","unsupported target catalog");need(field(catalog,"archiveContract")=="kelft.distribution-archive/1"&&field(catalog,"boundaryContract")=="kelft.installed-targets/1","component contracts differ");let host:string=field(catalog,"host");need(host=="linux-x86_64"||host=="windows-x86_64","unsupported component host");digest(field(catalog,"compilerSHA256"));need(field(catalog,"version")!="","release version required");
 let values:j::Value=j::field(catalog,"components");need(j::is_array(values),"component catalog array required");let rows:Array<j::Value>=j::array(values);need(array_len::<j::Value>(rows)<=1,"only the reciprocal x64 profile is supported");
 for row in rows {
  let target:string=field(row,"target");need(target!=host&&normalize(target)==target,"cross target differs");let mut profile:string="lld-elf-static/1";if host=="linux-x86_64" {profile="lld-coff/1";}need(field(row,"linkerProfile")==profile,"linker contract differs");
  digest(field(row,"profileSHA256"));digest(field(row,"metadataSHA256"));digest(field(j::field(row,"archive"),"sha256"));need(number(j::field(row,"archive"),"size")<=536870912,"archive bound");
  let files:Array<j::Value>=j::array(j::field(row,"files"));need(array_len::<j::Value>(files)>0&&array_len::<j::Value>(files)<8192,"component inventory bound");let mut names:Array<string>=[];let mut total:i32=0;
  for file in files {let name:string=field(file,"path");path(name);let mut owned:bool=s::starts(name,"rootfs/cross/linux-x86_64/")||name=="rootfs/control/cross-linux-x86_64.json";if host=="linux-x86_64" {owned=s::starts(name,"cross/windows-x86_64/");}need(owned,"component cannot own core paths");let folded:string=lower(name);for previous in names {need(previous!=folded&&!s::starts(folded,previous+"/")&&!s::starts(previous,folded+"/"),"duplicate or conflicting component path");}array_push::<string>(inout names,folded);digest(field(file,"sha256"));let size:i32=number(file,"size");need(size<=268435456,"tool file bound");total=total+size;need(total<=536870912&&total>=0,"component expanded bound");let mode:i32=number(file,"mode");need(mode==420||mode==493,"component mode differs");}
 }
 return rows;
}
fn state(row:j::Value,observed:j::Value)->j::Value {
 let files:Array<j::Value>=j::array(j::field(row,"files"));let actual:Array<j::Value>=j::array(j::field(observed,"files"));need(array_len::<j::Value>(files)==array_len::<j::Value>(actual),"incomplete host observations");let mut present:bool=false;let mut valid:bool=true;let mut modified:bool=false;let mut i:i32=0;
 while i<array_len::<j::Value>(files) {let expected:j::Value=files[i];let item:j::Value=actual[i];if j::boolean(j::field(item,"present")) {present=true;if j::field(item,"sha256")!=j::field(expected,"sha256")||j::field(item,"size")!=j::field(expected,"size")||!j::boolean(j::field(item,"modeValid")) {valid=false;modified=true;}}else {valid=false;}i=i+1;}
 let receipt:string=j::string(j::field(observed,"receipt"));let expected_receipt:string=h::bytes_hex(string_to_bytes(field(j::field(row,"archive"),"sha256")+"\n"));let installed:bool=valid&&receipt==expected_receipt;let mut integrity:string="absent";if present||receipt!=""||j::boolean(j::field(observed,"receiptPresent")) {integrity="incomplete";}if modified||(receipt!=""||j::boolean(j::field(observed,"receiptPresent")))&&receipt!=expected_receipt {integrity="modified";}if installed {integrity="valid";}
 let mut out:j::Value=j::parse("{\"supported\":true,\"certification\":\"not-evaluated\"}");out=j::set(out,"target",j::field(row,"target"));out=j::set(out,"linkerProfile",j::field(row,"linkerProfile"));out=j::set(out,"installed",j::Value::Bool(installed));out=j::set(out,"filesValid",j::Value::Bool(valid));let mut emit:j::Value=j::parse("[\"object\"]");if installed {emit=j::parse("[\"object\",\"executable\"]");}out=j::set(out,"emit",emit);out=j::set(out,"integrity",j::Value::Text(integrity));return out;
}
fn text(bytes:Bytes,start:i32,width:i32)->string {let mut out:Bytes=[];let mut ended:bool=false;let mut n:i32=start;while n<start+width {let b:u8=bytes[n];if i32_from_u8(b)==0 {ended=true;}else {need(!ended,"USTAR nonzero string padding");array_push::<u8>(inout out,b);}n=n+1;}return bytes_to_string(out);}
fn octal(bytes:Bytes,start:i32,width:i32)->i32 {let mut value:i32=0;let mut ended:bool=false;let mut digits:i32=0;let mut n:i32=start;while n<start+width {let b:i32=i32_from_u8(bytes[n]);if b==0||b==32 {ended=true;}else {need(!ended&&b>=48&&b<=55&&value<=67108864,"invalid USTAR quantity");value=value*8+b-48;need(value>=0&&value<=536870912,"USTAR quantity bound");digits=digits+1;}n=n+1;}need(digits>0,"USTAR octal required");return value;}
fn header(encoded:string,file:j::Value)->void {
 need(string_len(encoded)==1024,"USTAR header bound");let bytes:Bytes=h::hex_bytes(encoded);let name:string=text(bytes,0,100);path(name);need(name==field(file,"path"),"undeclared archive entry or order");need(octal(bytes,100,8)==number(file,"mode"),"archive mode differs");need(octal(bytes,108,8)==0&&octal(bytes,116,8)==0&&octal(bytes,136,12)==0,"noncanonical USTAR metadata");need(octal(bytes,124,12)==number(file,"size"),"archive entry size differs");need(i32_from_u8(bytes[156])==48,"archive entry must be a regular file");need(text(bytes,157,100)==""&&text(bytes,257,6)=="ustar"&&text(bytes,263,2)=="00","unsupported USTAR format");let mut n:i32=265;while n<512 {need(i32_from_u8(bytes[n])==0,"unsupported USTAR extension");n=n+1;}let mut checksum:i32=0;n=0;while n<512 {if n>=148&&n<156 {checksum=checksum+32;}else {checksum=checksum+i32_from_u8(bytes[n]);}n=n+1;}need(checksum==octal(bytes,148,8),"USTAR checksum differs");
}
fn archive(row:j::Value,catalog:j::Value,inspection:j::Value)->void {
 need(field(inspection,"gzipHeader")=="1f8b08000000000002ff","noncanonical gzip header");let pin:j::Value=j::field(row,"archive");need(j::field(inspection,"sha256")==j::field(pin,"sha256")&&j::field(inspection,"size")==j::field(pin,"size"),"target pack differs from this release catalog");need(j::boolean(j::field(inspection,"canonicalEnd")),"invalid archive end or trailing data");
 let entries:Array<j::Value>=j::array(j::field(inspection,"entries"));let files:Array<j::Value>=j::array(j::field(row,"files"));need(array_len::<j::Value>(entries)==array_len::<j::Value>(files)+1,"archive inventory differs");let first:j::Value=entries[0];need(j::field(first,"sha256")==j::field(row,"metadataSHA256"),"component metadata identity differs");let metadata:j::Value=j::parse(field(inspection,"metadata"));need(field(metadata,"schema")=="kelft.target-pack/1"&&j::field(metadata,"archiveContract")==j::field(catalog,"archiveContract")&&j::field(metadata,"boundaryContract")==j::field(catalog,"boundaryContract")&&j::field(metadata,"host")==j::field(catalog,"host")&&j::field(metadata,"version")==j::field(catalog,"version")&&j::field(metadata,"compilerSHA256")==j::field(catalog,"compilerSHA256")&&j::field(metadata,"target")==j::field(row,"target")&&j::field(metadata,"profileSHA256")==j::field(row,"profileSHA256")&&j::field(metadata,"linkerProfile")==j::field(row,"linkerProfile"),"target pack compatibility differs");
 let mut meta:j::Value=j::parse("{\"path\":\"component.json\",\"mode\":420}");meta=j::set(meta,"size",j::field(first,"size"));header(field(first,"header"),meta);let mut i:i32=0;while i<array_len::<j::Value>(files) {let item:j::Value=entries[i+1];header(field(item,"header"),files[i]);need(j::field(item,"sha256")==j::field(files[i],"sha256")&&j::field(item,"size")==j::field(files[i],"size"),"archive file content differs");i=i+1;}
}
pub fn decide(request:j::Value)->j::Value {
 let catalog:j::Value=j::field(request,"catalog");let rows:Array<j::Value>=components(catalog);need(j::field(request,"host")==j::field(catalog,"host")&&j::field(request,"compilerSHA256")==j::field(catalog,"compilerSHA256"),"installed core compatibility differs");
 let raw:Array<j::Value>=j::array(j::field(request,"arguments"));let mut arguments:Array<string>=[];let mut json:bool=false;for value in raw {need(j::is_string(value),"argument must be text");let argument:string=j::string(value);if argument=="--json" {if json {error("INVALID_INVOCATION","duplicate --json",64);}json=true;}else {array_push::<string>(inout arguments,argument);}}
 let count:i32=array_len::<string>(arguments);if count<2||arguments[0]!="target" {error("INVALID_INVOCATION","expected target list|add|remove",64);}let action:string=arguments[1];if (action=="list"&&count!=2)||(action=="remove"&&count!=3)||(action=="add"&&(count!=5||arguments[3]!="--from"))||(action!="list"&&action!="add"&&action!="remove") {error("INVALID_INVOCATION","usage: target list | add TARGET --from PACK | remove TARGET",64);}
 let observed:Array<j::Value>=j::array(j::field(request,"observed"));need(array_len::<j::Value>(observed)==array_len::<j::Value>(rows),"component observations missing");let mut states:Array<j::Value>=[];let mut i:i32=0;while i<array_len::<j::Value>(rows) {array_push::<j::Value>(inout states,state(rows[i],observed[i]));i=i+1;}
 let mut out:j::Value=j::parse("{\"schema\":\"kelft.command-result/1\",\"status\":\"success\",\"command\":\"target\",\"operation\":\"none\"}");out=j::set(out,"host",j::field(catalog,"host"));out=j::set(out,"json",j::Value::Bool(json));out=j::set(out,"data",j::Value::Array(states));if action=="list" {return out;}
 let target:string=normalize(arguments[2]);if target==field(catalog,"host") {error("NATIVE_TARGET","the native profile is part of the core installation",1);}let mut index:i32=-1;i=0;while i<array_len::<j::Value>(rows) {if field(rows[i],"target")==target {index=i;}i=i+1;}if index<0 {error("UNSUPPORTED_TARGET_PROFILE","target pack is not supported by this core release",1);}
 out=j::set(out,"component",j::Value::Number(i32_to_string(index)));out=j::set(out,"target",j::Value::Text(target));let item:j::Value=states[index];out=j::set(out,"data",item);
 if action=="remove" {if field(item,"integrity")!="absent" {out=j::set(out,"operation",j::Value::Text("remove"));}return out;}
 if field(request,"phase")=="published" {archive(rows[index],catalog,j::field(request,"inspection"));need(j::boolean(j::field(item,"filesValid")),"published component differs from the approved inventory");out=j::set(out,"operation",j::Value::Text("activate"));return out;}
 if j::boolean(j::field(item,"installed")) {return out;}
 out=j::set(out,"archive",j::Value::Text(arguments[4]));out=j::set(out,"operation",j::Value::Text("inspect"));if field(request,"phase")=="archive" {archive(rows[index],catalog,j::field(request,"inspection"));out=j::set(out,"operation",j::Value::Text("add"));}return out;
}
fn main()->void {let arguments:Array<string>=args();if array_len::<string>(arguments)!=1 {error("INVALID_INVOCATION","private policy request required",64);}match read_text(arguments[0]) {Result::Ok(raw)=>{need(string_len(raw)<=16777216,"policy request bound");println(j::canonical(decide(j::parse(raw))));},Result::Error(message)=>{error("TARGET_COMPONENT",message,1);}}}
