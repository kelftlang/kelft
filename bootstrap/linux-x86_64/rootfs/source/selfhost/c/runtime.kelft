// Runtime support; contains no compiler logic.
pub fn source()->string {return "/* Kelft Core C17 value runtime. Layouts and ownership are backend local. */\n#define _POSIX_C_SOURCE 200809L\n#define _XOPEN_SOURCE 700\n#include <stdint.h>\n#include <stddef.h>\n#include <stdbool.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <limits.h>\n#include <errno.h>\n\n#ifndef KELFT_HEAP_LIMIT\n#define KELFT_HEAP_LIMIT (256u * 1024u * 1024u)\n#endif\n#ifndef KELFT_CALL_LIMIT\n#define KELFT_CALL_LIMIT 256u\n#endif\ntypedef struct KObj KObj;\ntypedef struct { int tag; int32_t number; KObj *obj; } V;\nenum { KVOID, KINT, KBOOL, KSTRING, KARRAY, KTUPLE, KRECORD, KVARIANT, KMAP };\nstruct KObj { size_t refs, len; const char *name; int tag; KObj *releaseNext; V values[]; };\ntypedef struct KAllocation { struct KAllocation *prev, *next; size_t size; max_align_t align; } KAllocation;\nstatic KAllocation *kallocations;\nstatic size_t kheap, kdepth;\nstatic int kargc; static char **kargv;\nstatic void kcleanup(void) { while(kallocations) { KAllocation *next=kallocations->next; free(kallocations); kallocations=next; } kheap=0; }\nstatic _Noreturn void ktrap(const char *code) { fprintf(stderr,\"error[%s]\\n\",code); exit(1); }\nstatic void *kalloc(size_t size) {\n    if(size>SIZE_MAX-sizeof(KAllocation)) ktrap(\"KRT_RESOURCE\");\n    size_t total=sizeof(KAllocation)+size;\n    if(total>KELFT_HEAP_LIMIT||kheap>KELFT_HEAP_LIMIT-total) ktrap(\"KRT_RESOURCE\");\n    KAllocation *p=calloc(1,sizeof(KAllocation)+size); if(!p) ktrap(\"KRT_RESOURCE\");\n    p->size=size;p->next=kallocations;if(kallocations)kallocations->prev=p;kallocations=p;kheap+=total;return p+1;\n}\nstatic void kfree(void *value) { if(!value)return;KAllocation *p=(KAllocation*)value-1;if(p->prev)p->prev->next=p->next;else kallocations=p->next;if(p->next)p->next->prev=p->prev;kheap-=sizeof(KAllocation)+p->size;free(p); }\nstatic V kv(void) { return (V){KVOID,0,NULL}; }\nstatic V ki(int32_t n) { return (V){KINT,n,NULL}; }\nstatic V kb(bool b) { return (V){KBOOL,b?1:0,NULL}; }\nstatic V kcopy(V value) { if(value.obj) {if(value.obj->refs==SIZE_MAX)ktrap(\"KRT_RESOURCE\");value.obj->refs++;}return value; }\nstatic void kdrop(V value) {\n    if(!value.obj||--value.obj->refs)return;\n    KObj *pending=value.obj;pending->releaseNext=NULL;\n    while(pending){\n        KObj *current=pending;pending=current->releaseNext;\n        if(current->tag!=KSTRING)for(size_t i=0;i<current->len;i++){\n            KObj *child=current->values[i].obj;\n            if(child&&!--child->refs){child->releaseNext=pending;pending=child;}\n        }\n        kfree(current);\n    }\n}\nstatic void ktake(V *slot,V value) { kdrop(*slot);*slot=value; }\nstatic V kobject(int tag,size_t length) {\n    if(length>INT32_MAX||length>(SIZE_MAX-sizeof(KObj)-1)/sizeof(V))ktrap(\"KRT_RESOURCE\");\n    KObj *p=kalloc(sizeof(KObj)+(tag==KSTRING?length+1:length*sizeof(V)));p->refs=1;p->len=length;p->tag=tag;return (V){tag,0,p};\n}\nstatic unsigned char *kbytes(V value) { return (unsigned char*)value.obj->values; }\nstatic V kstr(const char *bytes,size_t length) { V v=kobject(KSTRING,length);if(length)memcpy(kbytes(v),bytes,length);kbytes(v)[length]=0;return v; }\nstatic V ktext(const char *text) { return kstr(text,strlen(text)); }\nstatic V kvector(int tag,size_t length,const V *items) { V v=kobject(tag,length);for(size_t i=0;i<length;i++)v.obj->values[i]=kcopy(items[i]);return v; }\nstatic V kvariant(const char *name,size_t length,const V *items) { V v=kvector(KVARIANT,length,items);v.obj->name=name;return v; }\nstatic V kok(V value) { return kvariant(\"Ok\",1,&value); }\nstatic V kerror(const char *message) { V text=ktext(message),v=kvariant(\"Error\",1,&text);kdrop(text);return v; }\nstatic V ksome(V value) { return kvariant(\"Some\",1,&value); }\nstatic V knone(void) { return kvariant(\"None\",0,NULL); }\ntypedef struct { const char *name; V value; } KField;\nstatic V krecord(size_t length,const KField *items) { V v=kobject(KRECORD,length*2);for(size_t i=0;i<length;i++){v.obj->values[i*2]=ktext(items[i].name);v.obj->values[i*2+1]=kcopy(items[i].value);}return v; }\nstatic bool kstringis(V value,const char *text) { size_t n=strlen(text);return value.tag==KSTRING&&value.obj->len==n&&!memcmp(kbytes(value),text,n); }\nstatic int kcompare(V a,V b) {\n    if(a.tag==KSTRING){size_t an=a.obj->len,bn=b.obj->len,n=an<bn?an:bn;int c=memcmp(kbytes(a),kbytes(b),n);return c?c:(an>bn)-(an<bn);}\n    return (a.number>b.number)-(a.number<b.number);\n}\ntypedef struct {V a,b;} KPair;\nstatic int keq_atomic(V a,V b){\n    if(a.tag!=b.tag)return 0;if(!a.obj||!b.obj)return a.number==b.number;if(a.obj==b.obj)return 1;\n    if(a.obj->len!=b.obj->len)return 0;if(a.tag==KSTRING)return !memcmp(kbytes(a),kbytes(b),a.obj->len);\n    if(a.tag==KVARIANT&&strcmp(a.obj->name,b.obj->name))return 0;return -1;\n}\nstatic bool keq_push(KPair **pairs,size_t *length,size_t *capacity,V a,V b){\n    int atomic=keq_atomic(a,b);if(atomic>=0)return atomic!=0;\n    if(*length==*capacity){\n        if(*capacity>SIZE_MAX/2/sizeof(KPair))ktrap(\"KRT_RESOURCE\");\n        size_t next=*capacity*2;KPair *grown=kalloc(next*sizeof(KPair));memcpy(grown,*pairs,*length*sizeof(KPair));kfree(*pairs);*pairs=grown;*capacity=next;\n    }\n    (*pairs)[(*length)++]=(KPair){a,b};return true;\n}\nstatic bool kequal(V a,V b){\n    int atomic=keq_atomic(a,b);if(atomic>=0)return atomic!=0;\n    size_t capacity=32,length=1;KPair *pairs=kalloc(capacity*sizeof(KPair));pairs[0]=(KPair){a,b};bool equal=true;\n    while(length&&equal){\n        KPair pair=pairs[--length];V left=pair.a,right=pair.b;\n        if(left.tag==KRECORD){\n            for(size_t i=0;i<left.obj->len&&equal;i+=2){\n                bool found=false;for(size_t j=0;j<right.obj->len;j+=2)if(keq_atomic(left.obj->values[i],right.obj->values[j])==1){found=true;equal=keq_push(&pairs,&length,&capacity,left.obj->values[i+1],right.obj->values[j+1]);break;}\n                if(!found)equal=false;\n            }\n        }else for(size_t i=0;i<left.obj->len&&equal;i++)equal=keq_push(&pairs,&length,&capacity,left.obj->values[i],right.obj->values[i]);\n    }\n    kfree(pairs);return equal;\n}\nstatic V kborrowindex(V value,int32_t index) { if(index<0||(size_t)index>=value.obj->len)ktrap(\"KRT_BOUNDS\");return value.obj->values[index]; }\nstatic V kindex(V value,V index) { return kcopy(kborrowindex(value,index.number)); }\nstatic size_t kfieldindex(V value,const char *name) {\n    if(value.tag==KTUPLE){char *end;unsigned long n=strtoul(name,&end,10);if(*end||n>=value.obj->len)ktrap(\"KRT_BOUNDS\");return (size_t)n;}\n    for(size_t i=0;i<value.obj->len;i+=2)if(kstringis(value.obj->values[i],name))return i+1;ktrap(\"KRT_OPERATION\");\n}\nstatic V kborrowfield(V value,const char *name) { return value.obj->values[kfieldindex(value,name)]; }\nstatic V kfield(V value,const char *name) { return kcopy(kborrowfield(value,name)); }\nstatic bool kvariantis(V value,const char *name) {return value.tag==KVARIANT&&!strcmp(value.obj->name,name);}\ntypedef struct {const char *name;int32_t index;bool indexed;} KKey;\ntypedef struct KLoc { V *root; const struct KLoc *parent; KKey key; } KLoc;\nstatic KLoc klocal(V *root) {return (KLoc){root,NULL,{NULL,0,false}};}\nstatic KLoc kchild(const KLoc *parent,KKey key) {return (KLoc){NULL,parent,key};}\nstatic V klborrow(KLoc location) {if(location.root)return *location.root;V parent=klborrow(*location.parent);return location.key.indexed?kborrowindex(parent,location.key.index):kborrowfield(parent,location.key.name);}\nstatic V klget(KLoc location) {return kcopy(klborrow(location));}\nstatic V kclone(V value) {V out=kvector(value.tag,value.obj->len,value.obj->values);out.obj->name=value.obj->name;return out;}\nstatic void klset(KLoc location,V value) {\n    if(location.root){V copy=kcopy(value);ktake(location.root,copy);return;}\n    V parent=klborrow(*location.parent);size_t index=location.key.indexed?(size_t)location.key.index:kfieldindex(parent,location.key.name);\n    if(location.key.indexed)kborrowindex(parent,location.key.index);\n    V copy=kclone(parent);ktake(&copy.obj->values[index],kcopy(value));klset(*location.parent,copy);kdrop(copy);\n}\nstatic V kconcat(V a,V b){if(a.obj->len>INT32_MAX-b.obj->len)ktrap(\"KRT_RESOURCE\");V v=kobject(KSTRING,a.obj->len+b.obj->len);memcpy(kbytes(v),kbytes(a),a.obj->len);memcpy(kbytes(v)+a.obj->len,kbytes(b),b.obj->len);return v;}\nstatic int32_t kwrap(uint32_t n) {return n<=INT32_MAX?(int32_t)n:INT32_MIN+(int32_t)(n-UINT32_C(2147483648));}\nstatic V kbinary(const char *op,V a,V b) {\n    int32_t x=a.number,y=b.number;uint32_t u=(uint32_t)x,v=(uint32_t)y;\n    if(!strcmp(op,\"+\"))return a.tag==KSTRING?kconcat(a,b):ki(kwrap(u+v));\n    if(!strcmp(op,\"-\"))return ki(kwrap(u-v));if(!strcmp(op,\"*\"))return ki(kwrap(u*v));\n    if(!strcmp(op,\"/\")||!strcmp(op,\"%\")){if(!y)ktrap(\"KRT_DIV_ZERO\");if(x==INT32_MIN&&y==-1){if(*op=='/')ktrap(\"KRT_DIV_OVERFLOW\");return ki(0);}return ki(*op=='/'?x/y:x%y);}\n    if(!strcmp(op,\"&\"))return ki(kwrap(u&v));if(!strcmp(op,\"|\"))return ki(kwrap(u|v));if(!strcmp(op,\"^\"))return ki(kwrap(u^v));\n    if(!strcmp(op,\"<<\"))return ki(kwrap(u<<(v&31)));if(!strcmp(op,\">>>\"))return ki(kwrap(u>>(v&31)));\n    if(!strcmp(op,\">>\")){unsigned n=v&31;uint32_t z=u>>n;if(x<0&&n)z|=UINT32_MAX<<(32-n);return ki(kwrap(z));}\n    if(!strcmp(op,\"==\"))return kb(kequal(a,b));if(!strcmp(op,\"!=\"))return kb(!kequal(a,b));\n    int c=kcompare(a,b);if(!strcmp(op,\"<\"))return kb(c<0);if(!strcmp(op,\"<=\"))return kb(c<=0);if(!strcmp(op,\">\"))return kb(c>0);if(!strcmp(op,\">=\"))return kb(c>=0);ktrap(\"KRT_OPERATION\");\n}\nstatic V kunary(const char *op,V a){if(!strcmp(op,\"!\"))return kb(!a.number);return ki(kwrap(!strcmp(op,\"-\")?0u-(uint32_t)a.number:~(uint32_t)a.number));}\nstatic bool kutf8(const unsigned char *s,size_t n){\n    size_t i=0;while(i<n){unsigned c=s[i++];if(c<128)continue;unsigned count,cp,min;if(c>=194&&c<=223){count=1;cp=c&31;min=128;}else if(c>=224&&c<=239){count=2;cp=c&15;min=2048;}else if(c>=240&&c<=244){count=3;cp=c&7;min=65536;}else return false;\n    if(count>n-i)return false;for(unsigned k=0;k<count;k++){unsigned b=s[i++];if((b&192)!=128)return false;cp=(cp<<6)|(b&63);}if(cp<min||cp>1114111||(cp>=55296&&cp<=57343))return false;}return true;\n}\nstatic bool kboundary(V s,size_t i){return i==s.obj->len||(kbytes(s)[i]&192)!=128;}\nstatic V kslice(V s,V start,V end){int32_t a=start.number,b=end.number;if(a<0||b<a||(size_t)b>s.obj->len)ktrap(\"KRT_BOUNDS\");if(!kboundary(s,(size_t)a)||!kboundary(s,(size_t)b))ktrap(\"KRT_UTF8_BOUNDARY\");return kstr((char*)kbytes(s)+a,(size_t)(b-a));}\nstatic int32_t kfind(V s,V q,int32_t start){if(start<0||(size_t)start>s.obj->len)ktrap(\"KRT_BOUNDS\");if(q.obj->len>s.obj->len-(size_t)start)return -1;for(size_t i=(size_t)start;i<=s.obj->len-q.obj->len;i++)if(!memcmp(kbytes(s)+i,kbytes(q),q.obj->len))return (int32_t)i;return -1;}\nstatic V kprint(V s,FILE *stream,bool newline){if(s.obj->len)fwrite(kbytes(s),1,s.obj->len,stream);if(newline)fputc('\\n',stream);return kv();}\nstatic V k_print(V s){return kprint(s,stdout,false);}static V k_println(V s){return kprint(s,stdout,true);}static V k_eprint(V s){return kprint(s,stderr,false);}\nstatic V k_i32_to_string(V x){char buffer[32];int length=snprintf(buffer,sizeof(buffer),\"%d\",x.number);return kstr(buffer,(size_t)length);}\nstatic V k_string_to_i32(V s){\n    size_t i=0,n=s.obj->len;const unsigned char *p=kbytes(s);bool negative=n&&p[0]=='-';if(negative)i++;if(i==n||p[i]<'0'||p[i]>'9'||p[i]=='0'&&i+1<n)return kerror(\"INVALID_I32\");\n    uint32_t value=0,limit=negative?UINT32_C(2147483648):INT32_MAX;for(;i<n;i++){if(p[i]<'0'||p[i]>'9'||value>(limit-(uint32_t)(p[i]-'0'))/10)return kerror(\"INVALID_I32\");value=value*10+(uint32_t)(p[i]-'0');}return kok(ki(negative?kwrap(0u-value):(int32_t)value));\n}\nstatic V k_i32_from_u8(V v){return ki(v.number);}static V k_u8_from_i32(V v){if(v.number<0||v.number>255)ktrap(\"KRT_U8_RANGE\");return ki(v.number);}\nstatic V k_string_len(V v){return ki((int32_t)v.obj->len);}static V k_string_byte(V v,V i){if(i.number<0||(size_t)i.number>=v.obj->len)ktrap(\"KRT_BOUNDS\");return ki(kbytes(v)[i.number]);}\nstatic V k_string_slice(V s,V a,V b){return kslice(s,a,b);}static V k_string_find(V s,V q,V start){return ki(kfind(s,q,start.number));}\nstatic V k_string_replace(V s,V a,V b){\n    if(!a.obj->len)ktrap(\"KRT_EMPTY_SEPARATOR\");size_t count=0;int32_t pos=0,found;while((found=kfind(s,a,pos))>=0){count++;pos=found+(int32_t)a.obj->len;}\n    if(b.obj->len>a.obj->len&&count>(INT32_MAX-s.obj->len)/(b.obj->len-a.obj->len))ktrap(\"KRT_RESOURCE\");\n    size_t length=b.obj->len>=a.obj->len?s.obj->len+count*(b.obj->len-a.obj->len):s.obj->len-count*(a.obj->len-b.obj->len);V out=kobject(KSTRING,length);pos=0;size_t offset=0;\n    while((found=kfind(s,a,pos))>=0){size_t n=(size_t)(found-pos);memcpy(kbytes(out)+offset,kbytes(s)+pos,n);offset+=n;memcpy(kbytes(out)+offset,kbytes(b),b.obj->len);offset+=b.obj->len;pos=found+(int32_t)a.obj->len;}memcpy(kbytes(out)+offset,kbytes(s)+pos,s.obj->len-(size_t)pos);return out;\n}\nstatic V k_string_split(V s,V separator){\n    if(!separator.obj->len)ktrap(\"KRT_EMPTY_SEPARATOR\");size_t count=1;int32_t pos=0,found;while((found=kfind(s,separator,pos))>=0){count++;pos=found+(int32_t)separator.obj->len;}V out=kobject(KARRAY,count);pos=0;size_t i=0;\n    while((found=kfind(s,separator,pos))>=0){out.obj->values[i++]=kstr((char*)kbytes(s)+pos,(size_t)(found-pos));pos=found+(int32_t)separator.obj->len;}out.obj->values[i]=kstr((char*)kbytes(s)+pos,s.obj->len-(size_t)pos);return out;\n}\nstatic V k_string_from_codepoint(V v){uint32_t cp=(uint32_t)v.number;if(v.number<0||cp>1114111||(cp>=55296&&cp<=57343))ktrap(\"KRT_UNICODE\");unsigned char b[4];size_t n;\n    if(cp<128){b[0]=(unsigned char)cp;n=1;}else if(cp<2048){b[0]=(unsigned char)(192|(cp>>6));b[1]=(unsigned char)(128|(cp&63));n=2;}else if(cp<65536){b[0]=(unsigned char)(