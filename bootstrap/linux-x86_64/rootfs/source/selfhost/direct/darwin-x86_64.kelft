pub struct Code {name:string,bytes:Bytes,relocations:Array<x::Relocation>,frame_size:i32,returns:Array<i32>}
struct Fixup {offset:i32,name:string}
fn disp(inout out:Bytes,prefix:Bytes,value:i32)->void {b::append(inout out,prefix);b::word(inout out,value);}
fn call(inout out:Bytes,inout relocations:Array<x::Relocation>,symbol:string,external:bool)->void {array_push::<u8>(inout out,232);let mut kind:string="pc32";if external {kind="plt32";}array_push::<x::Relocation>(inout relocations,x::Relocation {offset:array_len::<u8>(out),symbol:symbol,kind:kind,addend:-4});b::word(inout out,0);}
fn contains(values:Array<string>,value:string)->bool {for item in values {if item==value {return true;}}return false;}
fn shared(operation_id:i32)->bool {
 // BEGIN generated opcode constants
 let op_add:i32=993596020;
 let op_address:i32=745154899;
 let op_and:i32=254395046;
