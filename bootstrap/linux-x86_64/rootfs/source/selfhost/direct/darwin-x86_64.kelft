 // END generated opcode constants

return (operation_id==op_prologue||operation_id==op_imm||operation_id==op_mask_u8||operation_id==op_load||operation_id==op_second||operation_id==op_save||operation_id==op_context||operation_id==op_arg_address||operation_id==op_loc_address||operation_id==op_out_address||operation_id==op_slot_address||operation_id==op_read||operation_id==op_write||operation_id==op_ptr_add||operation_id==op_ptr_eq||operation_id==op_add||operation_id==op_sub||operation_id==op_mul||operation_id==op_and||operation_id==op_or||operation_id==op_xor||operation_id==op_shl||operation_id==op_shr_s||operation_id==op_shr_u||operation_id==op_div_s||operation_id==op_rem_s||operation_id==op_eq||operation_id==op_ne||operation_id==op_lt_s||operation_id==op_le_s||operation_id==op_gt_s||operation_id==op_ge_s||operation_id==op_address||operation_id==op_call||operation_id==op_trap||operation_id==op_return);}
pub fn encode(name:string,instructions:Array<x::Machine>)->Code {return encode_registered(name,instructions,opcodes::registry());}
pub fn encode_registered(name:string,instructions:Array<x::Machine>,opcode_registry:Map<string,i32>)->Code {
 // BEGIN generated opcode constants
 let op_arg_address:i32=1471864344;
 let op_darwin_api:i32=-1956410691;
 let op_darwin_start:i32=1059693933;
 let op_goto:i32=-173862938;
 let op_label:i32=-157870083;
 let op_load:i32=-435725847;
