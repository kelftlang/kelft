 let op_slot_address:i32=-1491298942;
 // END generated opcode constants




 if array_len::<x::Machine>(instructions)==0 {b::error("invalid Darwin native frame");}let first:x::Machine=instructions[0];if first.op!="prologue"||first.a<32||first.a>40000||first.a%16!=0 {b::error("invalid Darwin native frame");}
 let frame:i32=first.a;let mut out:Bytes=[];let mut relocations:Array<x::Relocation>=[];let mut returns:Array<i32>=[];let mut labels:Map<string,i32>=map_new::<string,i32>();let mut fixups:Array<Fixup>=[];let mut index:i32=0;
 for i in instructions {let operation_id:i32=opcodes::identify(i.op,opcode_registry);
  if operation_id==op_prologue&&index!=0 {b::error("nested Darwin prologue");}index=index+1;
  if (operation_id==op_load||operation_id==op_second||operation_id==op_save||operation_id==op_arg_address||operation_id==op_loc_address||operation_id==op_out_address||operation_id==op_slot_address)&&(i.a> -8||i.a< -frame) {b::error("invalid Darwin frame slot");}
  if operation_id==op_label {match map_get::<string,i32>(labels,i.symbol) {Option::Some(value)=>{b::error("duplicate Darwin label");},Option::None=>{}}map_set::<string,i32>(inout labels,i.symbol,array_len::<u8>(out));}
  else if operation_id==op_goto||operation_id==op_nonzero {if operation_id==op_goto {array_push::<u8>(inout out,233);}else {b::append(inout out,[133,192,15,133]);}array_push::<Fixup>(inout fixups,Fixup {offset:array_len::<u8>(out),name:i.symbol});b::word(inout out,0);}
  else if operation_id==op_darwin_api {
   let a:ir::Signature=api::get(i.symbol);let mut width:i32=4;if a.result=="void" {width=0;}if a.result=="ptr" {width=8;}if i.a!=array_len::<string>(a.params)||i.a>6||i.b!=width {b::error("invalid Darwin mechanism signature");}disp(inout out,[76,139,157],-16);
   let registers:Array<i32>=[187,179,147,139,131,139];let mut n:i32=0;while n<i.a {let mut rex:i32=65;if n>=4 {rex=69;}if a.params[n]=="ptr" {rex=rex+8;}disp(inout out,[u8_from_i32(rex),139,u8_from_i32(registers[n])],n*8);n=n+1;}if api::variadic_start(i.symbol)>=0 {b::append(inout out,[49,192]);}call(inout out,inout relocations,i.symbol,true);
  }else if operation_id==op_darwin_start {
   if frame<256||i.a!=0||i.b!=0||i.symbol!="k_darwin_main" {b::error("invalid Darwin startup frame");}let base:i32=-192;let mut positions:Array<i32>=[-208,-200];let mut n:i32=0;while n<16 {array_push::<i32>(inout positions,base+n*8);n=n+1;}for at in positions {disp(inout out,[72,199,133],at);b::word(inout out,0);}
   let from:Array<i32>=[-8,-16,-24];let to:Array<i32>=[64,72,80];n=0;while n<3 {disp(inout out,[72,139,133],from[n]);disp(inout out,[72,137,133],base+to[n]);n=n+1;}
   let prefixes:Array<Bytes>=[[72,141,189],[72,141,181],[72,141,149],[72,141,141]];let at:Array<i32>=[base,-208,-208,-200];n=0;while n<4 {disp(inout out,prefixes[n],at[n]);n=n+1;}call(inout out,inout relocations,i.symbol,false);disp(inout out,[139,189],-200);call(inout out,inout relocations,"_exit",true);b::append(inout out,[15,11]);
  }else {
   if !shared(operation_id) {b::error("unsupported Darwin operation "+i.op);}let encoded:x::Code=x::encode_registered(name,[i],opcode_registry);let offset:i32=array_len::<u8>(out);b::append(inout out,encoded.bytes);for r in encoded.relocations {array_push::<x::Relocation>(inout relocations,x::Relocation {offset:r.offset+offset,symbol:r.symbol,kind:r.kind,addend:r.addend});}if operation_id==op_return {array_push::<i32>(inout returns,array_len::<u8>(out)-1);}
  }
 }
 for f in fixups {let target:i32=b::get(labels,f.name);b::patch(inout out,f.offset,target-f.offset-4);}return Code {name:name,bytes:out,relocations:relocations,frame_size:frame,returns:returns};
}
pub fn encode_program(p:ir::Program)->Array<Code> {if p.platform!="macos"||p.target!="x86_64" {b::error("expected private macOS x86-64 IR");}let mut validated:ir::Program=p;validated.platform="linux";ir::verify(validated);let mut imports:Array<string>=[];for a in p.imports {array_push::<string>(inout imports,a.name);}let opcode_registry:Map<string,i32>=opcodes::registry();let mut out:Array<Code>=[];for f in p.functions {array_push::<Code>(inout out,encode_registered(f.name,ir::lower(f,imports),opcode_registry));}return out;}
