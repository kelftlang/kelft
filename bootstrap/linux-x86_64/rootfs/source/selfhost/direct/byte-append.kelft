pub fn target(n:c::Node)->Option<c::Node> {
 if n.op!="for"||array_len::<c::Node>(n.args)!=3 {return Option::<c::Node>::None();}
 let binding:c::Node=n.args[0];let source:c::Node=n.args[1];let body:c::Node=n.args[2];
 if binding.op!="pattern"||binding.ty!="u8"||binding.name=="_"||binding.name=="true"||binding.name=="false"||array_len::<c::Node>(binding.args)!=0||source.ty!="Array<u8>"||body.op!="block"||array_len::<c::Node>(body.args)!=1 {return Option::<c::Node>::None();}
 let statement:c::Node=body.args[0];if statement.op!="evaluate"||array_len::<c::Node>(statement.args)!=1 {return Option::<c::Node>::None();}
 let push:c::Node=statement.args[0];if push.op!="intrinsic"||push.name!="array_push"||push.ty!="void"||array_len::<c::Node>(push.args)!=2 {return Option::<c::Node>::None();}
 let destination:c::Node=push.args[0];let item:c::Node=push.args[1];
 if destination.op!="location"||destination.ty!="Array<u8>"||array_len::<c::Node>(destination.args)!=1 {return Option::<c::Node>::None();}
 let place:c::Node=destination.args[0];if place.op!="local"||array_len::<c::Node>(place.args)!=0||item.op!="local"||item.ty!="u8"||item.name!=binding.name||array_len::<c::Node>(item.args)!=0 {return Option::<c::Node>::None();}
 return Option::<c::Node>::Some(destination);
}
