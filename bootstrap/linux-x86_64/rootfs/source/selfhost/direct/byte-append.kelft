 let source_marker:i32=g::load(inout b,source,36,"i32");let source_zero:i32=g::c(inout b,0);let source_packed:i32=g::binary(inout b,"lt_s",source_marker,source_zero);let target_zero:i32=g::c(inout b,0);let target_packed:i32=g::binary(inout b,"lt_s",marker,target_zero);let packed:i32=g::binary(inout b,"and",source_packed,target_packed);
 let references:i32=g::load(inout b,array,0,"i32");let one:i32=g::c(inout b,1);let unique:i32=g::binary(inout b,"eq",references,one);let same:i32=g::equal(inout b,source,array);let different:i32=g::c(inout b,0);let disjoint:i32=g::binary(inout b,"eq",same,different);let zero:i32=g::c(inout b,0);let nonnegative:i32=g::binary(inout b,"ge_s",length,zero);let fits:i32=g::binary(inout b,"lt_s",length,capacity);let maximum:i32=g::c(inout b,268435400);let bounded:i32=g::binary(inout b,"lt_s",length,maximum);
 let space:i32=g::binary(inout b,"and",fits,bounded);let valid_length:i32=g::binary(inout b,"and",nonnegative,space);let valid_copy:i32=g::binary(inout b,"and",disjoint,valid_length);let valid_owner:i32=g::binary(inout b,"and",unique,valid_copy);let valid:i32=g::binary(inout b,"and",packed,valid_owner);g::branch(inout b,valid,bulk,fallback);
 g::begin(inout b,bulk);let count:i32=g::binary(inout b,"sub",size,index);let room:i32=g::binary(inout b,"sub",capacity,length);let limit:i32=g::c(inout b,268435400);let ceiling:i32=g::binary(inout b,"sub",limit,length);
