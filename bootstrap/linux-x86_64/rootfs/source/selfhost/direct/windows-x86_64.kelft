 let op_shr_s:i32=-1849078538;
 let op_shr_u:i32=-1815523300;
 let op_sub:i32=-598853355;
 let op_trap:i32=1619038978;
 let op_write:i32=-1104765092;
 let op_xor:i32=-865346690;
 // END generated opcode constants

 if operation_id==op_imm {disp(inout out,[184],i.a);}
 else if operation_id==op_mask_u8 {b::append(inout out,[37,255,0,0,0]);}
 else if operation_id==op_read {if i.a==8 {disp(inout out,[72,139,128],i.b);}else if i.a==4 {disp(inout out,[139,128],i.b);}else if i.a==1 {disp(inout out,[15,182,128],i.b);}else {b::error("invalid read width");}}
 else if operation_id==op_write {if i.a==8 {disp(inout out,[73,137,130],i.b);}else if i.a==4 {disp(inout out,[65,137,130],i.b);}else if i.a==1 {disp(inout out,[65,136,130],i.b);}else {b::error("invalid write width");}}
 else if operation_id==op_ptr_add {b::append(inout out,[77,99,210,76,1,208]);}
 else if operation_id==op_ptr_eq {b::append(inout out,[76,57,208,15,148,192,15,182,192]);}
 else if operation_id==op_add {b::append(inout out,[68,1,208]);}
 else if operation_id==op_sub {b::append(inout out,[68,41,208]);}
 else if operation_id==op_mul {b::append(inout out,[65,15,175,194]);}
 else if operation_id==op_and {b::append(inout out,[68,33,208]);}
 else if operation_id==op_or {b::append(inout out,[68,9,208]);}
 else if operation_id==op_xor {b::append(inout out,[68,49,208]);}
 else if operation_id==op_shl||operation_id==op_shr_s||operation_id==op_shr_u {let mut opcode:u8=232;if operation_id==op_shl {opcode=224;}if operation_id==op_shr_s {opcode=248;}b::append(inout out,[68,137,209,211,opcode]);}
 else if operation_id==op_div_s||operation_id==op_rem_s {b::append(inout out,[69,133,210,117,2,15,11,61,0,0,0,128,117,11,65,131,250,255,117,5]);if operation_id==op_div_s {b::append(inout out,[15,11,144,144,144]);}else {b::append(inout out,[49,192,235,7,144]);}b::append(inout out,[153,65,247,250]);if operation_id==op_rem_s {b::append(inout out,[137,208]);}}
 else if operation_id==op_eq||operation_id==op_ne||operation_id==op_lt_s||operation_id==op_le_s||operation_id==op_gt_s||operation_id==op_ge_s {let mut cc:u8=148;if operation_id==op_ne {cc=149;}if operation_id==op_lt_s {cc=156;}if operation_id==op_le_s {cc=158;}if operation_id==op_gt_s {cc=159;}if operation_id==op_ge_s {cc=157;}b::append(inout out,[68,57,208,15,cc,192,15,182,192]);}
 else if operation_id==op_address {if i.a< -2147483644 {b::error("native relocation addend overflow");}b::append(inout out,[72,141,5]);array_push::<x::Relocation>(inout relocations,x::Relocation {offset:array_len::<u8>(out),symbol:i.symbol,kind:"pc32",addend:i.a-4});b::word(inout out,0);}
 else if operation_id==op_call {array_push::<u8>(inout out,232);let mut kind:string="pc32";if i.a==1 {kind="plt32";}array_push::<x::Relocation>(inout relocations,x::Relocation {offset:array_len::<u8>(out),symbol:i.symbol,kind:kind,addend:-4});b::word(inout out,0);}
 else if operation_id==op_trap {b::append(inout out,[15,11]);}
