fn disp(inout out:Bytes,prefix:Bytes,value:i32)->void {b::append(inout out,prefix);b::word(inout out,value);}
fn slot(offset:i32,original:i32,shift:i32)->i32 {if offset> -8||offset< -original {b::error("invalid Windows frame slot");}return shift+offset;}
