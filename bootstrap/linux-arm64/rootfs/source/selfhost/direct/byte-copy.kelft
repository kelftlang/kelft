// Trusted bounded payload move, including overlapping ranges in one allocation.
import "./builder.kelft" as g;
import "./ir.kelft" as ir;
fn copy(inout b:g::Builder,source:i32,target:i32,index:i32,width:string)->void {let from:i32=g::pointer(inout b,source,index);let value:i32=g::load(inout b,from,0,width);let to:i32=g::pointer(inout b,target,index);g::store(inout b,to,0,value);}
// Fresh disjoint payloads only. Bounds are established by the original caller checks.
pub fn fresh_function()->ir::Function {
 let mut b:g::Builder=g::builder("k_copy_fresh",["ptr","ptr","i32"],0,"void");let src:i32=g::argument(inout b,0);let dst:i32=g::argument(inout b,1);let size:i32=g::argument(inout b,2);let index:i32=g::c(inout b,0);let eight:i32=g::c(inout b,8);let limit:i32=g::binary(inout b,"sub",size,eight);let words:string=g::label(inout b);let word:string=g::label(inout b);let tail:string=g::label(inout b);let byte:string=g::label(inout b);let done:string=g::label(inout b);g::jump(inout b,words);
 g::begin(inout b,words);let full:i32=g::binary(inout b,"le_s",index,limit);g::branch(inout b,full,word,tail);g::begin(inout b,word);copy(inout b,src,dst,index,"ptr");let stride:i32=g::c(inout b,8);let next:i32=g::binary(inout b,"add",index,stride);g::assign(inout b,index,next);g::jump(inout b,words);g::begin(inout b,tail);let more:i32=g::binary(inout b,"lt_s",index,size);g::branch(inout b,more,byte,done);g::begin(inout b,byte);copy(inout b,src,dst,index,"u8");let one:i32=g::c(inout b,1);let after:i32=g::binary(inout b,"add",index,one);g::assign(inout b,index,after);g::jump(inout b,tail);g::begin(inout b,done);g::ret(inout b,-1);return g::finish(b);
}
pub fn function()->ir::Function {
 let mut b:g::Builder=g::builder("k_byte_copy",["ptr","ptr","i32","i32","i32"],0,"void");let source:i32=g::argument(inout b,0);let target:i32=g::argument(inout b,1);let start:i32=g::argument(inout b,2);let offset:i32=g::argument(inout b,3);let size:i32=g::argument(inout b,4);let zero:i32=g::c(inout b,0);let nil:i32=g::nil(inout b);
 let no_source:i32=g::equal(inout b,source,nil);g::guard(inout b,no_source);let no_target:i32=g::equal(inout b,target,nil);g::guard(inout b,no_target);let invalid_start:i32=g::binary(inout b,"lt_s",start,zero);g::guard(inout b,invalid_start);let invalid_offset:i32=g::binary(inout b,"lt_s",offset,zero);g::guard(inout b,invalid_offset);let invalid_size:i32=g::binary(inout b,"lt_s",size,zero);g::guard(inout b,invalid_size);
 let source_size:i32=g::load(inout b,source,8,"i32");let target_size:i32=g::load(inout b,target,8,"i32");let source_outside:i32=g::binary(inout b,"gt_s",start,source_size);g::guard(inout b,source_outside);let target_outside:i32=g::binary(inout b,"gt_s",offset,target_size);g::guard(inout b,target_outside);let available_source:i32=g::binary(inout b,"sub",source_size,start);let too_long_source:i32=g::binary(inout b,"gt_s",size,available_source);g::guard(inout b,too_long_source);let available_target:i32=g::binary(inout b,"sub",target_size,offset);let too_long_target:i32=g::binary(inout b,"gt_s",size,available_target);g::guard(inout b,too_long_target);
 let header:i32=g::c(inout b,40);let source_offset:i32=g::binary(inout b,"add",header,start);let src:i32=g::pointer(inout b,source,source_offset);let second_header:i32=g::c(inout b,40);let target_offset:i32=g::binary(inout b,"add",second_header,offset);let dst:i32=g::pointer(inout b,target,target_offset);let same:i32=g::equal(inout b,source,target);let higher:i32=g::binary(inout b,"gt_s",offset,start);let end:i32=g::binary(inout b,"add",start,size);let overlaps:i32=g::binary(inout b,"lt_s",offset,end);let moving_back:i32=g::binary(inout b,"and",higher,overlaps);let backwards:i32=g::binary(inout b,"and",same,moving_back);
 let forward:string=g::label(inout b);let backward:string=g::label(inout b);let done:string=g::label(inout b);g::branch(inout b,backwards,backward,forward);
 g::begin(inout b,forward);let index:i32=g::c(inout b,0);let eight:i32=g::c(inout b,8);let limit:i32=g::binary(inout b,"sub",size,eight);let words:string=g::label(inout b);let word:string=g::label(inout b);let tail:string=g::label(inout b);let byte:string=g::label(inout b);g::jump(inout b,words);g::begin(inout b,words);let full:i32=g::binary(inout b,"le_s",index,limit);g::branch(inout b,full,word,tail);g::begin(inout b,word);copy(inout b,src,dst,index,"ptr");let stride:i32=g::c(inout b,8);let next:i32=g::binary(inout b,"add",index,stride);g::assign(inout b,index,next);g::jump(inout b,words);g::begin(inout b,tail);let more:i32=g::binary(inout b,"lt_s",index,size);g::branch(inout b,more,byte,done);g::begin(inout b,byte);copy(inout b,src,dst,index,"u8");let one:i32=g::c(inout b,1);let after:i32=g::binary(inout b,"add",index,one);g::assign(inout b,index,after);g::jump(inout b,tail);
 g::begin(inout b,backward);let remaining:i32=g::copy(inout b,size);let reverse:string=g::label(inout b);let reverse_word:string=g::label(inout b);let reverse_tail:string=g::label(inout b);let reverse_byte:string=g::label(inout b);g::jump(inout b,reverse);g::begin(inout b,reverse);let block_size:i32=g::c(inout b,8);let full_reverse:i32=g::binary(inout b,"ge_s",remaining,block_size);g::branch(inout b,full_reverse,reverse_word,reverse_tail);g::begin(inout b,reverse_word);let subtract:i32=g::c(inout b,8);let before:i32=g::binary(inout b,"sub",remaining,subtract);g::assign(inout b,remaining,before);copy(inout b,src,dst,remaining,"ptr");g::jump(inout b,reverse);g::begin(inout b,reverse_tail);let any:i32=g::binary(inout b,"gt_s",remaining,zero);g::branch(inout b,any,reverse_byte,done);g::begin(inout b,reverse_byte);let single:i32=g::c(inout b,1);let previous:i32=g::binary(inout b,"sub",remaining,single);g::assign(inout b,remaining,previous);copy(inout b,src,dst,remaining,"u8");g::jump(inout b,reverse_tail);g::begin(inout b,done);g::ret(inout b,-1);return g::finish(b);
}
