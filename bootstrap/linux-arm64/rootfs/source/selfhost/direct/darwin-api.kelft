// Fixed libSystem mechanisms. No arbitrary FFI.
import "./binary.kelft" as b;
import "./ir.kelft" as ir;
pub fn signatures()->Array<ir::Signature> {return [ir::Signature {name:"getenv",params:["ptr"],locations:0,result:"ptr"},ir::Signature {name:"mmap",params:["ptr","i32","i32","i32","i32","ptr"],locations:0,result:"ptr"},ir::Signature {name:"munmap",params:["ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"write",params:["i32","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"openat",params:["i32","ptr","i32","i32"],locations:0,result:"i32"},ir::Signature {name:"fcntl",params:["i32","i32","ptr"],locations:0,result:"i32"},ir::Signature {name:"read",params:["i32","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"close",params:["i32"],locations:0,result:"i32"},ir::Signature {name:"mkdirat",params:["i32","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"fchmod",params:["i32","i32"],locations:0,result:"i32"},ir::Signature {name:"readlinkat",params:["i32","ptr","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"getcwd",params:["ptr","i32"],locations:0,result:"ptr"},ir::Signature {name:"__error",params:[],locations:0,result:"ptr"},ir::Signature {name:"_exit",params:["i32"],locations:0,result:"void"}];}
pub fn get(name:string)->ir::Signature {for api in signatures() {if api.name==name {return api;}}b::error("Darwin mechanism is not allowlisted: "+name);return ir::Signature {name:"",params:[],locations:0,result:"void"};}

pub fn variadic_start(name:string)->i32 {if name=="openat" {return 3;}if name=="fcntl" {return 2;}return -1;}
