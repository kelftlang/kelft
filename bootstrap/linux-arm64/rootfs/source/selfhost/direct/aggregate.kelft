array_push::<elf::Data>(inout r.data,elf::Data {name:"k_engine_wasm",bytes:string_to_bytes("engine-wasm-linux-x86_64-v1")});

array_push::<elf::Data>(inout r.data,elf::Data {name:"k_artifact_javascript",bytes:string_to_bytes("javascript")});
array_push::<elf::Data>(inout r.data,elf::Data {name:"k_artifact_wasm",bytes:string_to_bytes("wasm")});
array_push::<elf::Data>(inout r.data,elf::Data {name:"k_artifact_js_fd_key",bytes:string_to_bytes("KELFT_JAVASCRIPT_RUNTIME_FD=")});
array_push::<elf::Data>(inout r.data,elf::Data {name:"k_artifact_wasm_fd_key",bytes:string_to_bytes("KELFT_WASM_RUNTIME_FD=")});
array_push::<elf::Data>(inout r.data,elf::Data {name:"k_artifact_js_flag",bytes:string_to_bytes("--input-type=module"+string_from_codepoint(0)+"")});
array_push::<elf::Data>(inout r.data,elf::Data {name:"k_artifact_stdin",bytes:string_to_bytes("-"+string_from_codepoint(0)+"")});
array_push::<elf::Data>(inout r.data,elf::Data {name:"k_artifact_wasm_command",bytes:string_to_bytes("artifact-exec"+string_from_codepoint(0)+"")});
array_push::<elf::Data>(inout r.data,elf::Data {name:"k_artifact_separator",bytes:string_to_bytes("--"+string_from_codepoint(0)+"")});
array_push::<elf::Data>(inout r.data,elf::Data {name:"k_artifact_required",bytes:string_to_bytes("ARTIFACT_RUNTIME_REQUIRED")});
array_push::<elf::Data>(inout r.data,elf::Data {name:"k_artifact_invalid",bytes:string_to_bytes("INVALID_ARTIFACT_RUNTIME")});
}
pub fn runtime_build(additions:Array<ir::Function>,extra_data:Array<elf::Data>)->runtime::Runtime {
 let opcode_registry:Map<string,i32>=opcodes::registry();
 let mut r:runtime::Runtime=runtime::build();let mut functions:Array<ir::Function>=aggregate_runtime::array_functions();for f in aggregate_runtime::enum_functions() {array_push::<ir::Function>(inout functions,f);}for f in string_runtime::string_functions() {array_push::<ir::Function>(inout functions,f);}for f in stream_runtime::stream_functions() {array_push::<ir::Function>(inout functions,f);}for f in map_runtime::functions() {array_push::<ir::Function>(inout functions,f);}for f in graph_runtime::functions() {array_push::<ir::Function>(inout functions,f);}for f in path_runtime::functions() {array_push::<ir::Function>(inout functions,f);}for f in process_runtime::functions() {array_push::<ir::Function>(inout functions,f);}for f in fs_policy::functions() {array_push::<ir::Function>(inout functions,f);}for f in fs_runtime::functions() {array_push::<ir::Function>(inout functions,f);}for f in write_runtime::functions() {array_push::<ir::Function>(inout functions,f);}for f in artifact_runtime::functions() {array_push::<ir::Function>(inout functions,f);}array_push::<ir::Function>(inout functions,aggregate_runtime::location_function());
 if array_len::<ir::Function>(additions)>0 {let mut selected:Array<ir::Function>=[];for f in functions {let mut overridden:bool=false;for value in additions {if value.name==f.name {overridden=true;}}if !overridden {array_push::<ir::Function>(inout selected,f);}}functions=selected;for f in additions {array_push::<ir::Function>(inout functions,f);}}
 runtime_io(inout r);
 runtime_process(inout r);
 runtime_supervision(inout r);
 runtime_filesystem_data(inout r);
 runtime_artifact_data(inout r);
 for value in extra_data {array_push::<elf::Data>(inout r.data,value);}
 let codes:Array<string>=["KRT_BOUNDS","KRT_UTF8_BOUNDARY","KRT_UTF8","KRT_UNICODE","KRT_EMPTY_SEPARATOR","KRT_IO","KRT_CAPABILITY"];for code in codes {let name:string="k_panic_"+code;let symbol:string=name+"_text";let bytes:Bytes=string_to_bytes("error["+code+"]\n");array_push::<ir::Signature>(inout r.imports,ir::Signature {name:name,params:[],locations:0,result:"void"});array_push::<elf::Data>(inout r.data,elf::Data {name:symbol,bytes:bytes});array_push::<x::Code>(inout r.code,x::encode(name,[x::make("prologue",32,0,""),x::make("linux_write_error",array_len::<u8>(bytes),0,symbol),x::make("imm",1,0,""),x::make("linux_exit_value",0,0,"")]));}
 let p:ir::Program=ir::Program {schema:"kelft-native-ir/1",target:"x86_64",platform:"linux",abi:"kelft-native/1",functions:functions,imports:r.imports,data:r.data};ir::verify(p);
 let mut imported:Array<string>=[];for signature in r.imports {array_push::<string>(inout imported,signature.name);}for f in functions {array_push::<x::Code>(inout r.code,x::encode_registered(f.name,ir::lower(f,imported),opcode_registry));array_push::<ir::Signature>(inout r.imports,ir::Signature {name:f.name,params:f.params,locations:f.locations,result:f.result});}return r;
}
pub struct Lowering {indices:Map<string,i32>,layouts:Array<Layout>,graph:graph_runtime::Table,names:Map<string,string>}
pub fn prepare(p:c::Program)->Lowering {
 c::validate(p);let mut layouts:Array<Layout>=[];for n in p.types {gather(inout layouts,n,p.types);}for n in p.functions {gather(inout layouts,n,p.types);}for n in p.functions {shape(n,layouts);}
 let mut graph_types:Array<graph_runtime::Type>=[];for l in layouts {let mut fields:Array<string>=[];let mut variants:Array<Array<string>>=[];for f in l.fields {array_push::<string>(inout fields,f.ty);}for v in l.variants {let mut values:Array<string>=[];for f in v.args {array_push::<string>(inout values,f.ty);}array_push::<Array<string>>(inout variants,values);}array_push::<graph_runtime::Type>(inout graph_types,graph_runtime::Type {ty:l.ty,kind:l.kind,fields:fields,variants:variants});}let graph:graph_runtime::Table=graph_runtime::table(graph_types);
 let mut names:Map<string,string>=map_new::<string,string>();let mut indices:Map<string,i32>=map_new::<string,i32>();let mut at:i32=0;for f in p.functions {map_set::<string,string>(inout names,f.name,"kf"+i32_to_string(at));map_set::<string,i32>(inout indices,f.name,at);at=at+1;}
 return Lowering {indices:indices,layouts:layouts,graph:graph,names:names};
}
fn aggregate_data(layouts:Array<Layout>,literal_data:Array<elf::Data>,graph:graph_runtime::Table,base:Array<elf::Data>)->Array<elf::Data> {
 let mut data:Array<elf::Data>=base;for l in layouts {if l.kind=="enum" {let mut at:i32=0;for v in l.variants {let mut bytes:Bytes=[0];for field in v.args {let mut bit:u8=1;if scalar(field.ty) {bit=0;}array_push::<u8>(inout bytes,bit);}array_push::<elf::Data>(inout data,elf::Data {name:l.symbol+"v"+i32_to_string(at),bytes:bytes});at=at+1;}}else {let mut bytes:Bytes=[];for field in l.fields {let mut bit:u8=1;if scalar(field.ty) {bit=0;}array_push::<u8>(inout bytes,bit);}array_push::<elf::Data>(inout data,elf::Data {name:l.symbol,bytes:bytes});}}
 for item in literal_data {array_push::<elf::Data>(inout data,item);}array_push::<elf::Data>(inout data,elf::Data {name:"k_graph_types",bytes:graph.bytes});
 return data;
}
pub fn lower(p:c::Program)->ir::Program {
 let plan:Lowering=prepare(p);let r:runtime::Runtime=runtime_build([],[]);let mut functions:Array<ir::Function>=[];let mut literal_data:Array<elf::Data>=[];
 for f in p.functions {let lowered:ir::Function=lower_function(f,p.functions,plan.indices,plan.names,plan.layouts,plan.graph,inout literal_data);array_push::<ir::Function>(inout functions,lowered);}
 let data:Array<elf::Data>=aggregate_data(plan.layouts,literal_data,plan.graph,r.data);
 let mut imports:Array<ir::Signature>=r.imports;let names:Array<string>=["k_process_run","k_filesystem_read","k_filesystem_write"];for name in names {let mut used:bool=false;for f in functions {for block in f.blocks {for instruction in block.instructions {if instruction.op=="call"&&instruction.symbol==name {used=true;}}}}if used {array_push::<ir::Signature>(inout imports,ir::Signature {name:name,params:["ptr"],locations:0,result:"ptr"});}}
 let result:ir::Program=ir::Program {schema:"kelft-native-ir/1",target:"x86_64",platform:"linux",abi:"kelft-native/1",functions:functions,imports:imports,data:data};ir::verify(result);return result;
}
fn core_signature(f:c::Node,names:Map<string,string>)->ir::Signature {
 let mut params:Array<string>=[];let mut locations:i32=0;for p in parameters(f) {if p.flag {locations=locations+1;}else {array_push::<string>(inout params,width(p.ty,p));}}
 let mut result:string="void";if f.ty!="void" {result=width(f.ty,f);}return ir::Signature {name:name(names,f.name),params:params,locations:locations,result:result};
}
pub fn declarations(p:c::Program)->Array<c::Node> {let mut out:Array<c::Node>=[];for f in p.functions {array_push::<c::Node>(inout out,c::make(f.op,f.name,f.ty,parameters(f),f.span,f.flag));}return out;}
pub fn lower_planned(f:c::Node,functions:Array<c::Node>,plan:Lowering,inout data:Array<elf::Data>)->ir::Function {return lower_function(f,functions,plan.indices,plan.names,plan.layouts,plan.graph,inout data);}
pub fn planned_signature(f:c::Node,plan:Lowering)->ir::Signature {return core_signature(f,plan.names);}
pub fn lowering_data(plan:Lowering)->Array<elf::Data> {return aggregate_data(plan.layouts,[],plan.graph,[]);}

pub fn runtime_data(plan:Lowering,literals:Array<elf::Data>,base:Array<elf::Data>)->Array<elf::Data> {return aggregate_data(plan.layouts,literals,plan.graph,base);}
