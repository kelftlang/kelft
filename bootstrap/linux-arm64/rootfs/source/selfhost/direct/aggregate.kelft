struct Layout {ty:string,kind:string,fields:Array<c::Node>,variants:Array<c::Node>,symbol:string}
struct Owner {slot:i32,local:bool,consumed:bool}
struct Loop {stop:string,next:string,mark:i32}
struct Builder {functions:Array<c::Node>,indices:Map<string,i32>,names:Map<string,string>,fn_node:c::Node,slots:Array<string>,blocks:Array<ir::Block>,locals:Map<string,i32>,locations:Map<string,i32>,serial:i32,current:i32,terminated:bool,context:i32,old_depth:i32,loops:Array<Loop>,owners:Array<Owner>,layouts:Array<Layout>,graph:graph_runtime::Table,data:Array<elf::Data>,cached:Array<i32>,cached_index:i32,replaying:bool,cached_key:i32}
fn fail(message:string,n:c::Node)->void {s::error("K0403",message,n.span);}
fn scalar(ty:string)->bool {return ty=="i32"||ty=="bool"||ty=="u8";}
fn array(ty:string)->bool {return s::starts(ty,"Array<");}
fn map_type(ty:string)->bool {return s::starts(ty,"Map<");}
fn width(ty:string,n:c::Node)->string {if ty=="i32"||ty=="bool" {return "i32";}if ty=="u8" {return "u8";}return "ptr";}
fn register(inout layouts:Array<Layout>,ty:string,n:c::Node,types:Array<c::Node>,active:Array<string>)->void {
 if ty=="void"||scalar(ty) {return;}for l in layouts {if l.ty==ty {return;}}if array_len::<string>(active)>=64 {fail("excessive aggregate layout",n);}
 let mut fields:Array<c::Node>=[];let mut variants:Array<c::Node>=[];let mut kind:string="record";
 if ty=="string" {kind="string";}
 else if s::starts(ty,"Option<")||s::starts(ty,"Result<") {kind="enum";let parts:(string,Array<string>)=s::type_parts(ty);let mut first:string="Some";let mut second:string="None";let mut second_fields:Array<c::Node>=[];if parts.0=="Result" {first="Ok";second="Error";array_push::<c::Node>(inout second_fields,c::make("field","0",parts.1[1],[],n.span,false));}let first_fields:Array<c::Node>=[c::make("field","0",parts.1[0],[],n.span,false)];variants=[c::make("variant",first,ty,first_fields,n.span,false),c::make("variant",second,ty,second_fields,n.span,false)];}
 else if array(ty) {kind="array";let parts:(string,Array<string>)=s::type_parts(ty);array_push::<c::Node>(inout fields,c::make("field","[]",parts.1[0],[],n.span,false));}
 else if map_type(ty) {kind="map";let parts:(string,Array<string>)=s::type_parts(ty);if array_len::<string>(parts.1)!=2 {fail("invalid map layout",n);}let key:string=parts.1[0];if key!="string"&&!scalar(key) {fail("invalid map layout",n);}array_push::<c::Node>(inout fields,c::make("field","[]","("+key+","+parts.1[1]+")",[],n.span,false));}
 else if s::starts(ty,"(") {kind="tuple";let parts:(string,Array<string>)=s::type_parts(ty);let mut index:i32=0;for t in parts.1 {array_push::<c::Node>(inout fields,c::make("field",i32_to_string(index),t,[],n.span,false));index=index+1;}}
 else {let mut found:bool=false;for def in types {if def.name==ty {if def.op=="struct" {fields=def.args;found=true;}else if def.op=="enum" {kind="enum";variants=def.args;found=true;}}}if !found {fail("development aggregate type is unavailable: "+ty,n);}for field in fields {if field.op!="field"||array_len::<c::Node>(field.args)!=0 {fail("invalid aggregate fields",n);}}}
 let mut seen:Map<string,i32>=map_new::<string,i32>();for field in fields {if field.ty=="void" {fail("invalid aggregate fields",n);}match map_get::<string,i32>(seen,field.name) {Option::Some(value)=>{fail("invalid aggregate fields",n);},Option::None=>{}}map_set::<string,i32>(inout seen,field.name,1);}
 let mut variant_names:Map<string,i32>=map_new::<string,i32>();for v in variants {if v.op!="variant"||v.ty!=ty||v.name=="" {fail("invalid enum variants",n);}match map_get::<string,i32>(variant_names,v.name) {Option::Some(old)=>{fail("invalid enum variants",n);},Option::None=>{}}map_set::<string,i32>(inout variant_names,v.name,1);let mut at:i32=0;for field in v.args {if field.op!="field"||array_len::<c::Node>(field.args)!=0||field.name!=i32_to_string(at)||field.ty=="void" {fail("invalid enum variants",n);}at=at+1;}}
 let symbol:string="kbm"+i32_to_string(array_len::<Layout>(layouts));array_push::<Layout>(inout layouts,Layout {ty:ty,kind:kind,fields:fields,variants:variants,symbol:symbol});let mut path:Array<string>=active;array_push::<string>(inout path,ty);for field in fields {register(inout layouts,field.ty,n,types,path);}for v in variants {for field in v.args {register(inout layouts,field.ty,n,types,path);}}
}
fn gather(inout layouts:Array<Layout>,n:c::Node,types:Array<c::Node>)->void {let mut pending:Array<c::Node>=[n];while array_len::<c::Node>(pending)>0 {let node:c::Node=pending[array_len::<c::Node>(pending)-1];array_pop::<c::Node>(inout pending);register(inout layouts,node.ty,node,types,[]);let mut i:i32=array_len::<c::Node>(node.args)-1;while i>=0 {array_push::<c::Node>(inout pending,node.args[i]);i=i-1;}}}
fn find_layout(layouts:Array<Layout>,ty:string,n:c::Node)->Layout {for l in layouts {if l.ty==ty {return l;}}fail("aggregate layout is unavailable",n);return Layout {ty:ty,kind:"",fields:[],variants:[],symbol:""};}
struct ShapePattern {node:c::Node,ty:string}
fn pattern_shape(p:c::Node,ty:string,layouts:Array<Layout>)->void {let mut pending:Array<ShapePattern>=[ShapePattern {node:p,ty:ty}];while array_len::<ShapePattern>(pending)>0 {let f:ShapePattern=pending[array_len::<ShapePattern>(pending)-1];array_pop::<ShapePattern>(inout pending);let fields:Array<c::Node>=pattern_fields(f.node,f.ty,layouts);let mut i:i32=array_len::<c::Node>(f.node.args)-1;while i>=0 {array_push::<ShapePattern>(inout pending,ShapePattern {node:f.node.args[i],ty:fields[i].ty});i=i-1;}}}
fn pattern_fields(p:c::Node,ty:string,layouts:Array<Layout>)->Array<c::Node> {
 if p.ty!=ty {fail("invalid aggregate pattern type",p);}if p.op=="pattern" {if array_len::<c::Node>(p.args)!=0||(p.name=="true"||p.name=="false")&&ty!="bool" {fail("invalid aggregate pattern",p);}return [];}
 let l:Layout=find_layout(layouts,ty,p);let mut fields:Array<c::Node>=[];let mut found:bool=false;if p.op=="tuple_pattern"&&l.kind=="tuple" {fields=l.fields;found=true;}if p.op=="variant_pattern"&&l.kind=="enum" {for v in l.variants {if v.name==p.name {fields=v.args;found=true;}}}if !found||array_len::<c::Node>(fields)!=array_len::<c::Node>(p.args) {fail("invalid aggregate pattern",p);}return fields;
}
fn irrefutable(p:c::Node,layouts:Array<Layout>)->bool {let mut pending:Array<c::Node>=[p];while array_len::<c::Node>(pending)>0 {let node:c::Node=pending[array_len::<c::Node>(pending)-1];array_pop::<c::Node>(inout pending);if node.op=="pattern" {if node.name=="true"||node.name=="false" {return false;}}else {let mut allowed:bool=node.op=="tuple_pattern";if node.op=="variant_pattern" {let l:Layout=find_layout(layouts,node.ty,node);allowed=array_len::<c::Node>(l.variants)==1;}if !allowed {return false;}let mut i:i32=array_len::<c::Node>(node.args)-1;while i>=0 {array_push::<c::Node>(inout pending,node.args[i]);i=i-1;}}}return true;}
struct ShapeFrame {node:c::Node,index:i32,entered:bool,seen:Map<string,i32>}
fn shape_frame(n:c::Node)->ShapeFrame {return ShapeFrame {node:n,index:0,entered:false,seen:map_new::<string,i32>()};}
fn shape(root:c::Node,layouts:Array<Layout>)->void {
 let mut pending:Array<ShapeFrame>=[shape_frame(root)];while array_len::<ShapeFrame>(pending)>0 {let mut f:ShapeFrame=shape_frame(root);match array_pop::<ShapeFrame>(inout pending) {Option::Some(v)=>{f=v;},Option::None=>{}}let n:c::Node=f.node;
  if !f.entered {if n.op=="record"||n.op=="tuple" {let construction:Layout=find_layout(layouts,n.ty,n);if construction.kind!="record"&&construction.kind!="tuple"||(n.op=="tuple")!=s::starts(n.ty,"(")||array_len::<c::Node>(n.args)!=array_len::<c::Node>(construction.fields) {fail("invalid aggregate construction",n);}}else {shape_one(n,layouts);}f.entered=true;}
  if f.index<array_len::<c::Node>(n.args) {let at:i32=f.index;let item:c::Node=n.args[at];let mut child:c::Node=item;
   if n.op=="record"||n.op=="tuple" {let construction:Layout=find_layout(layouts,n.ty,n);let fields:Array<c::Node>=construction.fields;let mut field:c::Node=item;let mut value:c::Node=item;let mut found:bool=false;if n.op=="record" {for f in fields {if f.name==item.name {field=f;found=true;}}if !found||item.op!="field"||array_len::<c::Node>(item.args)!=1 {fail("invalid aggregate construction",n);}value=item.args[0];match map_get::<string,i32>(f.seen,item.name) {Option::Some(v)=>{fail("invalid aggregate construction",n);},Option::None=>{}}map_set::<string,i32>(inout f.seen,item.name,1);if item.ty!=field.ty {fail("invalid aggregate construction",n);}}else {field=fields[at];}if value.ty!=field.ty {fail("invalid aggregate construction",n);}child=value;}
   f.index=f.index+1;array_push::<ShapeFrame>(inout pending,f);array_push::<ShapeFrame>(inout pending,shape_frame(child));
  }
 }
}
fn shape_one(n:c::Node,layouts:Array<Layout>)->void {
 if n.op=="literal"&&n.ty=="string" {if array_len::<c::Node>(n.args)!=0||bytes_to_string(string_to_bytes(n.name))!=n.name {fail("invalid UTF-8 string literal",n);}}
 if n.op=="variant" {let l:Layout=find_layout(layouts,n.ty,n);let mut found:bool=false;for v in l.variants {if v.name==n.name {found=true;if array_len::<c::Node>(v.args)!=array_len::<c::Node>(n.args) {fail("invalid enum construction",n);}let mut at:i32=0;for field in v.args {if field.ty!=n.args[at].ty {fail("invalid enum construction",n);}at=at+1;}}}if l.kind!="enum"||!found {fail("invalid enum construction",n);}}
 if n.op=="array" {if !array(n.ty) {fail("invalid array construction",n);}let mut element:string="";for l in layouts {if l.ty==n.ty {element=l.fields[0].ty;}}if element=="" {fail("invalid array construction",n);}for item in n.args {if item.ty!=element {fail("invalid array construction",n);}}}
 if n.op=="index" {let base:c::Node=n.args[0];let index:c::Node=n.args[1];if !array(base.ty) {fail("invalid array index access",n);}let mut element:string="";for l in layouts {if l.ty==base.ty {element=l.fields[0].ty;}}if !array(base.ty)||index.ty!="i32"||element!=n.ty {fail("invalid array index access",n);}}
 if n.op=="for" {let p:c::Node=n.args[0];let source:c::Node=n.args[1];let l:Layout=find_layout(layouts,source.ty,n);if l.kind!="array"&&l.kind!="map" {fail("unsupported array iteration",n);}pattern_shape(p,l.fields[0].ty,layouts);if !irrefutable(p,layouts) {fail("refutable array iteration pattern",n);}}
 if n.op=="match" {if array_len::<c::Node>(n.args)<2 {fail("missing aggregate match arms",n);}let mut at:i32=1;while at<array_len::<c::Node>(n.args) {let arm:c::Node=n.args[at];if arm.op!="arm"||array_len::<c::Node>(arm.args)!=2 {fail("invalid aggregate match arm",n);}pattern_shape(arm.args[0],n.args[0].ty,layouts);at=at+1;}}
 if n.op=="field" {if array_len::<c::Node>(n.args)!=1 {fail("invalid aggregate field access",n);}let accessed:Layout=find_layout(layouts,n.args[0].ty,n);if accessed.kind!="record"&&accessed.kind!="tuple" {fail("invalid aggregate field access",n);}let mut found:bool=false;for l in layouts {if l.ty==n.args[0].ty {for f in l.fields {if f.name==n.name&&f.ty==n.ty {found=true;}}}}if !found {fail("invalid aggregate field access",n);}}

}
fn layout(state:Builder,ty:string,n:c::Node)->Layout {for l in state.layouts {if l.ty==ty {return l;}}fail("aggregate layout is unavailable",n);return Layout {ty:ty,kind:"",fields:[],variants:[],symbol:""};}
fn field_index(state:Builder,ty:string,key:string,n:c::Node)->i32 {let l:Layout=layout(state,ty,n);let mut index:i32=0;for field in l.fields {if field.name==key {return index;}index=index+1;}fail("aggregate field is unavailable",n);return -1;}
fn parameters(f:c::Node)->Array<c::Node> {let mut out:Array<c::Node>=[];for p in f.args {if p.op=="param" {array_push::<c::Node>(inout out,p);}}return out;}
fn name(names:Map<string,string>,key:string)->string {match map_get::<string,string>(names,key) {Option::Some(value)=>{return value;},Option::None=>{b::error("unresolved scalar function");}}return "";}
fn fresh(inout state:Builder,w:string)->i32 {let out:i32=array_len::<string>(state.slots);if out>=4096 {fail("development native slot limit exceeded",state.fn_node);}array_push::<string>(inout state.slots,w);return out;}
fn label(inout state:Builder)->string {let out:string="b"+i32_to_string(state.serial);state.serial=state.serial+1;return out;}
fn terminal(op:string,value:i32,label:string,condition:i32,yes:string,no:string)->ir::End {return ir::End {op:op,value:value,label:label,condition:condition,yes:yes,no:no};}
fn begin(inout state:Builder,name:string)->void {let at:i32=array_len::<ir::Block>(state.blocks);array_push::<ir::Block>(inout state.blocks,ir::Block {label:name,instructions:[],end:terminal("trap",-1,"",-1,"","")});state.current=at;state.terminated=false;}
fn emit(inout state:Builder,i:ir::Instruction)->void {if state.terminated {b::error("scalar builder emitted after terminator");}let at:i32=state.current;array_push::<ir::Instruction>(inout state.blocks[at].instructions,i);}
fn end(inout state:Builder,t:ir::End)->void {let at:i32=state.current;state.blocks[at].end=t;state.terminated=true;}
fn constant(inout state:Builder,value:i32,w:string)->i32 {let out:i32=fresh(inout state,w);let mut i:ir::Instruction=ir::instruction("const",out);i.value=value;emit(inout state,i);return out;}
fn copy(inout state:Builder,value:i32)->i32 {let w:string=state.slots[value];let out:i32=fresh(inout state,w);let mut i:ir::Instruction=ir::instruction("copy",out);i.value=value;emit(inout state,i);return out;}
fn binary(inout state:Builder,kind:string,left:i32,right:i32)->i32 {let out:i32=fresh(inout state,"i32");let mut i:ir::Instruction=ir::instruction("binary",out);i.kind=kind;i.left=left;i.right=right;emit(inout state,i);return out;}
fn widen(inout state:Builder,value:i32)->i32 {if state.slots[value]=="i32" {return value;}let out:i32=fresh(inout state,"i32");let mut i:ir::Instruction=ir::instruction("convert",out);i.value=value;emit(inout state,i);return out;}
fn panic(inout state:Builder,code:string)->void {let mut i:ir::Instruction=ir::instruction("call",-1);i.symbol="k_panic_"+code;emit(inout state,i);end(inout state,terminal("trap",-1,"",-1,"",""));}
fn guard(inout state:Builder,condition:i32,code:string)->void {let bad:string=label(inout state);let good:string=label(inout state);end(inout state,terminal("branch",-1,"",condition,bad,good));begin(inout state,bad);panic(inout state,code);begin(inout state,good);}
fn call(inout state:Builder,symbol:string,args:Array<i32>,result:string,locations:Array<i32>)->i32 {let mut out:i32=-1;if result!="void" {out=fresh(inout state,result);}let mut i:ir::Instruction=ir::instruction("call",out);i.symbol=symbol;i.args=args;i.locations=locations;emit(inout state,i);return out;}
fn load(inout state:Builder,base:i32,offset:i32,w:string)->i32 {let out:i32=fresh(inout state,w);let mut i:ir::Instruction=ir::instruction("load",out);i.base=base;i.offset=offset;emit(inout state,i);return out;}
fn address(inout state:Builder,slot:i32)->i32 {let out:i32=fresh(inout state,"ptr");let mut i:ir::Instruction=ir::instruction("slot_address",out);i.slot=slot;emit(inout state,i);return out;}
fn pointer(inout state:Builder,base:i32,offset:i32)->i32 {let out:i32=fresh(inout state,"ptr");let mut i:ir::Instruction=ir::instruction("ptr_add",out);i.base=base;i.offset=offset;emit(inout state,i);return out;}
fn length(inout state:Builder,base:i32)->i32 {let bytes:i32=load(inout state,base,8,"i32");let shift:i32=call(inout state,"k_array_shift",[base],"i32",[]);return binary(inout state,"shr_u",bytes,shift);}
fn cleanup(inout state:Builder,mark:i32,temps:bool)->void {let owners:Array<Owner>=state.owners;let mut index:i32=mark;while index<array_len::<Owner>(owners) {let o:Owner=owners[index];if !o.consumed&&(!temps||!o.local) {call(inout state,"k_heap_release",[o.slot],"void",[]);let mut i:ir::Instruction=ir::instruction("const",o.slot);i.value=0;emit(inout state,i);}index=index+1;}}
fn owner(inout state:Builder,is_local:bool)->i32 {let out:i32=fresh(inout state,"ptr");array_push::<Owner>(inout state.owners,Owner {slot:out,local:is_local,consumed:false});return out;}
// Owner slots are appended in strictly increasing order. No traversal history is retained.
fn temporary_owner(owners:Array<Owner>,slot:i32)->i32 {let mut low:i32=0;let mut high:i32=array_len::<Owner>(owners);while low<high {let middle:i32=low+(high-low)/2;if owners[middle].slot<slot {low=middle+1;}else {high=middle;}}if low<array_len::<Owner>(owners)&&owners[low].slot==slot&&!owners[low].local&&!owners[low].consumed {return low;}return -1;}
// Call only after a managed child has been retained. Locations and named owners
// remain owned; completed receiver slots no longer need statement cleanup.
fn consume_projection(inout state:Builder,slot:i32)->void {let index:i32=temporary_owner(state.owners,slot);if index<0 {return;}call(inout state,"k_heap_release",[slot],"void",[]);let mut zero:ir::Instruction=ir::instruction("const",slot);zero.value=0;emit(inout state,zero);state.owners[index].consumed=true;}
fn take(inout state:Builder,out:i32,raw:i32)->i32 {call(inout state,"k_heap_release",[out],"void",[]);let mut i:ir::Instruction=ir::instruction("copy",out);i.value=raw;emit(inout state,i);return out;}
fn own(inout state:Builder,raw:i32)->i32 {let out:i32=owner(inout state,false);return take(inout state,out,raw);}
fn hold(inout state:Builder,raw:i32)->i32 {let value:i32=call(inout state,"k_heap_retain",[raw],"ptr",[]);return own(inout state,value);}
fn assign(inout state:Builder,out:i32,value:i32)->void {if state.slots[out]=="ptr" {let retained:i32=call(inout state,"k_heap_retain",[value],"ptr",[]);take(inout state,out,retained);}else {let mut i:ir::Instruction=ir::instruction("copy",out);i.value=value;emit(inout state,i);}}
fn local(inout state:Builder,n:c::Node)->i32 {match map_get::<string,i32>(state.locals,n.name) {Option::Some(out)=>{return out;},Option::None=>{}}let w:string=width(n.ty,n);let mut out:i32=-1;if w=="ptr" {out=owner(inout state,true);}else {out=fresh(inout state,w);}map_set::<string,i32>(inout state.locals,n.name,out);return out;}
fn construct_variant(inout state:Builder,ty:string,name:string,values:Array<i32>,n:c::Node)->i32 {
 let l:Layout=layout(state,ty,n);let mut tag:i32=-1;let mut at:i32=0;for v in l.variants {if v.name==name {tag=at;}at=at+1;}let descriptor:i32=fresh(inout state,"ptr");let mut address:ir::Instruction=ir::instruction("address",descriptor);address.symbol=l.symbol+"v"+i32_to_string(tag);emit(inout state,address);
 let tag_slot:i32=constant(inout state,tag,"i32");let arity:i32=constant(inout state,array_len::<i32>(values),"i32");let out:i32=call(inout state,"k_variant_alloc",[tag_slot,arity,descriptor],"ptr",[]);
 let mut index:i32=0;for v in values {let mut stored:i32=v;if state.slots[v]=="ptr" {stored=call(inout state,"k_heap_retain",[v],"ptr",[]);}let mut store:ir::Instruction=ir::instruction("store",-1);store.base=out;store.offset=48+index*8;store.value=stored;emit(inout state,store);index=index+1;}return out;
}
struct PatternFrame {node:c::Node,subject:i32,index:i32,step:i32,out:i32,done:string}
fn pattern_frame(p:c::Node,subject:i32)->PatternFrame {return PatternFrame {node:p,subject:subject,index:0,step:0,out:-1,done:""};}
fn condition(inout state:Builder,p:c::Node,subject:i32)->i32 {return process_pattern(inout state,p,subject,false);}
fn bind_pattern(inout state:Builder,p:c::Node,subject:i32)->void {process_pattern(inout state,p,subject,true);}
fn process_pattern(inout state:Builder,p:c::Node,subject:i32,bind:bool)->i32 {
 let mut pending:Array<PatternFrame>=[pattern_frame(p,subject)];let mut result:i32=-1;
 while array_len::<PatternFrame>(pending)>0 {let mut f:PatternFrame=pattern_frame(p,subject);match array_pop::<PatternFrame>(inout pending) {Option::Some(v)=>{f=v;},Option::None=>{}}let node:c::Node=f.node;
  if node.op=="pattern" {if bind {if node.name!="_"&&node.name!="true"&&node.name!="false" {let slot:i32=local(inout state,node);assign(inout state,slot,f.subject);}}else if node.name=="true" {result=f.subject;}else if node.name=="false" {let zero:i32=constant(inout state,0,"i32");result=binary(inout state,"eq",f.subject,zero);}else {result=constant(inout state,1,"i32");}continue;}
