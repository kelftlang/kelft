// Compiler protocol for a parent-owned measured macOS linker service.
import "../json.kelft" as j;
import "../hash.kelft" as h;
import "../syntax.kelft" as s;
pub struct Prepared {object:Bytes,configuration:j::Value,object_hash:string}
fn fail(message:string)->void {s::error("K0403",message,s::span("<darwin-link-driver>",0,0));}
fn need(value:bool,message:string)->void {if !value {fail(message);}}
fn read(file:string)->Bytes {match read_file(file) {Result::Ok(value)=>{return value;},Result::Error(message)=>{fail(message);}}return [];}
fn text(value:j::Value,key:string)->string {let field:j::Value=j::field(value,key);need(j::is_string(field),"missing linker field: "+key);return j::string(field);}
fn digest(value:string)->bool {if string_len(value)!=71||string_slice(value,0,7)!="sha256:" {return false;}let mut i:i32=7;while i<71 {let c:i32=i32_from_u8(string_byte(value,i));if !(c>=48&&c<=57)&&!(c>=97&&c<=102) {return false;}i=i+1;}return true;}
pub fn validate(value:j::Value)->j::Value {
 need(j::is_object(value),"linker session object required");for (key,field) in j::object(value) {need(key=="schema"||key=="profile"||key=="identity"||key=="sdkVersion","unexpected linker session field");}
 need(text(value,"schema")=="kelft-macos-linker-session/1","unsupported macOS linker session");let profile:string=text(value,"profile");need(profile=="macos-x86_64"||profile=="macos-arm64","native macOS linker profile required");need(digest(text(value,"identity")),"invalid measured linker identity");
 let parts:Array<string>=string_split(text(value,"sdkVersion"),".");need(array_len::<string>(parts)>0&&array_len::<string>(parts)<=3,"invalid SDK version");let mut index:i32=0;for part in parts {need(string_len(part)>0,"invalid SDK version");let mut at:i32=0;while at<string_len(part) {let c:i32=i32_from_u8(string_byte(part,at));need(c>=48&&c<=57,"invalid SDK version");at=at+1;}match string_to_i32(part) {Result::Ok(n)=>{if index==0 {need(n>=14&&n<=65535,"unsupported SDK version");}else {need(n>=0&&n<=255,"invalid SDK version");}},Result::Error(e)=>{fail("invalid SDK version");}}index=index+1;}return value;
}
pub fn configuration(file:string)->j::Value {return validate(j::parse(bytes_to_string(read(file))));}
pub fn prepare(object:Bytes,value:j::Value,profile:string)->Prepared {let checked:j::Value=validate(value);need(text(checked,"profile")==profile,"compiler and linker architecture differ");return Prepared {object:object,configuration:checked,object_hash:h::sha256_bytes(object)};}
fn word(bytes:Bytes,at:i32)->i32 {return i32_from_u8(bytes[at])|(i32_from_u8(bytes[at+1])<<8)|(i32_from_u8(bytes[at+2])<<16)|(i32_from_u8(bytes[at+3])<<24);}
pub fn image(bytes:Bytes,profile:string)->void {need(array_len::<u8>(bytes)>=32&&word(bytes,0)==-17958193&&word(bytes,12)==2,"invalid linked Mach-O image");let mut machine:i32=16777223;if profile=="macos-arm64" {machine=16777228;}need(word(bytes,4)==machine,"linked image architecture differs");}
pub fn execute(prepared:Prepared,output:string,maximum:string)->j::Value {
 let destination:string=canonical_path(output);match create_dir(path_dirname(destination)) {Result::Ok(ok)=>{},Result::Error(e)=>{fail(e);}}
 let profile:string=text(prepared.configuration,"profile");let target:string="linker-"+profile+"-v1";let mut policy:j::Value=j::parse("{\"read\":[],\"write\":[]}");policy=j::set(policy,"write",j::Value::Array([j::Value::Text(destination)]));let mut signed:string="";let mut unsigned:string="";
 match artifact_run(prepared.object,target,[destination,text(prepared.configuration,"identity")],j::canonical(policy)) {
  Result::Ok(result)=>{need(result.0==0&&result.2=="","trusted macOS linker failed: "+result.1+result.2);let receipt:j::Value=j::parse(result.1);need(text(receipt,"schema")=="kelft-macos-link-result/1"&&text(receipt,"toolchainIdentity")==text(prepared.configuration,"identity")&&text(receipt,"signing")=="measured-ld-adhoc","trusted linker result differs");signed=text(receipt,"signedSHA256");unsigned=text(receipt,"unsignedSHA256");need(digest(signed)&&digest(unsigned)&&signed!=unsigned,"invalid signing result");},
  Result::Error(e)=>{fail(e);}
 }
 let bytes:Bytes=read(destination);image(bytes,profile);need(h::sha256_bytes(bytes)==signed,"linked image changed");
 let mut report:j::Value=j::parse("{\"schema\":\"kelft-native-link-development/1\",\"state\":\"linked\",\"selfHostingVerified\":false,\"productionClosureVerified\":false,\"releaseEligible\":false}");report=j::set(report,"profile",j::Value::Text(profile));report=j::set(report,"output",j::Value::Text(destination));report=j::set(report,"objectHash",j::Value::Text(prepared.object_hash));report=j::set(report,"executableHash",j::Value::Text(signed));report=j::set(report,"unsignedExecutableHash",j::Value::Text(unsigned));report=j::set(report,"toolchainIdentity",j::field(prepared.configuration,"identity"));report=j::set(report,"maximum",j::parse(maximum));return report;
}
