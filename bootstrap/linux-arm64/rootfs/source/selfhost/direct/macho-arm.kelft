// Deterministic ARM64 Mach-O with checked PC-relative relocations and FP/LR unwind.
import "./binary.kelft" as b;
import "./x86_64.kelft" as x;
import "./darwin-arm64.kelft" as w;
import "./elf.kelft" as elf;
struct Relocation {offset:i32,symbol:string,kind:i32,width:i32,pcrel:bool}
struct Symbol {name:string,section:i32,value:i32}
struct Section {name:string,segment:string,address:i32,alignment:i32,flags:i32,bytes:Bytes,size:i32,relocations:Array<Relocation>}
fn field_name(inout out:Bytes,value:string)->void {let bytes:Bytes=string_to_bytes(value);if array_len::<u8>(bytes)>16 {b::error("Mach-O section name overflow");}b::append(inout out,bytes);let mut n:i32=array_len::<u8>(bytes);while n<16 {array_push::<u8>(inout out,0);n=n+1;}}
fn decimal(value:string)->i32 {if string_len(value)==0 {b::error("invalid macOS SDK version");}let mut out:i32=0;let mut n:i32=0;while n<string_len(value) {let c:i32=i32_from_u8(string_byte(value,n));if c<48||c>57||out>(65535-(c-48))/10 {b::error("invalid macOS SDK version");}out=out*10+c-48;n=n+1;}return out;}
fn version(value:string)->i32 {let parts:Array<string>=string_split(value,".");if array_len::<string>(parts)<1||array_len::<string>(parts)>3 {b::error("invalid macOS SDK version");}let major:i32=decimal(parts[0]);let mut minor:i32=0;let mut patch:i32=0;if array_len::<string>(parts)>1 {minor=decimal(parts[1]);}if array_len::<string>(parts)>2 {patch=decimal(parts[2]);}if major<14||minor>255||patch>255 {b::error("unsupported macOS SDK version");}return (major<<16)|(minor<<8)|patch;}
fn word_at(bytes:Bytes,offset:i32)->i32 {if offset<0||offset>array_len::<u8>(bytes)-4 {b::error("invalid Mach-O word");}return i32_from_u8(bytes[offset])|(i32_from_u8(bytes[offset+1])<<8)|(i32_from_u8(bytes[offset+2])<<16)|(i32_from_u8(bytes[offset+3])<<24);}
fn frame(f:w::Code)->void {let size:i32=f.frame_size;if size<32||size>40000||size%16!=0||array_len::<u8>(f.bytes)<12||array_len::<u8>(f.bytes)%4!=0||word_at(f.bytes,0)!= -1447068675||word_at(f.bytes,4)!= -1862269955||word_at(f.bytes,8)!= -788528129+(size%4096)*1024 {b::error("invalid Darwin ARM64 frame/unwind contract");}if size>=4096&&word_at(f.bytes,12)!= -784333825+(size/4096)*1024 {b::error("invalid Darwin ARM64 frame/unwind contract");}let mut previous:i32=-1;for pc in f.returns {if pc<=previous||pc%4!=0||pc<20||pc>array_len::<u8>(f.bytes)-4||word_at(f.bytes,pc)!= -698416192||word_at(f.bytes,pc-4)!= -1463714819||word_at(f.bytes,pc-8)!= -1862270017 {b::error("invalid Darwin ARM64 unwind return");}previous=pc;}}
fn checked_add(left:i32,right:i32)->i32 {if left<0||right<0||left>2147483647-right {b::error("Mach-O offset overflow");}return left+right;}
fn aligned(value:i32,alignment:i32)->i32 {let n:i32=checked_add(value,alignment-1);return n/alignment*alignment;}
fn relocation_order(values:Array<x::Relocation>,start:i32,end:i32)->Array<i32> {if start==end {return [];}if end-start==1 {return [start];}let middle:i32=start+(end-start)/2;let left:Array<i32>=relocation_order(values,start,middle);let right:Array<i32>=relocation_order(values,middle,end);let mut out:Array<i32>=[];let mut a:i32=0;let mut c:i32=0;while a<array_len::<i32>(left)&&c<array_len::<i32>(right) {if values[left[a]].offset<=values[right[c]].offset {array_push::<i32>(inout out,left[a]);a=a+1;}else {array_push::<i32>(inout out,right[c]);c=c+1;}}while a<array_len::<i32>(left) {array_push::<i32>(inout out,left[a]);a=a+1;}while c<array_len::<i32>(right) {array_push::<i32>(inout out,right[c]);c=c+1;}return out;}
fn unique(inout names:Map<string,i32>,name:string)->void {if !b::symbol(name) {b::error("duplicate or invalid Mach-O symbol");}match map_get::<string,i32>(names,name) {Option::Some(value)=>{b::error("duplicate or invalid Mach-O symbol");},Option::None=>{}}map_set::<string,i32>(inout names,name,1);}
pub fn write(functions:Array<w::Code>,data:Array<elf::Data>,imports:Array<string>,metadata:string,sdk_version:string)->Bytes {let mut owned:Array<w::Code>=functions;return consume(inout owned,data,imports,metadata,sdk_version);}
// Release encoded functions as their bytes enter the final Mach-O image.
pub fn consume(inout functions:Array<w::Code>,data:Array<elf::Data>,imports:Array<string>,metadata:string,sdk_version:string)->Bytes {
 if array_len::<w::Code>(functions)==0 {b::error("Mach-O object requires code");}let mut function_names:Array<string>=[];let mut data_names:Array<string>=[];let mut seen:Map<string,i32>=map_new::<string,i32>();for f in functions {unique(inout seen,f.name);array_push::<string>(inout function_names,f.name);}for d in data {unique(inout seen,d.name);array_push::<string>(inout data_names,d.name);}for name in imports {unique(inout seen,name);}
 let mut out:Bytes=b::zeros(32+(72+4*80)+24+80+24);b::align(inout out,16);let text_start:i32=array_len::<u8>(out);let mut constants:Bytes=[];let mut unwind:Bytes=[];let mut text_relocations:Array<Relocation>=[];let mut unwind_relocations:Array<Relocation>=[];let mut symbols:Array<Symbol>=[];
 for index in b::name_order(function_names) {
  let f:w::Code=functions[index];frame(f);while (array_len::<u8>(out)-text_start)%16!=0 {array_push::<u8>(inout out,0);}let start:i32=array_len::<u8>(out)-text_start;array_push::<Symbol>(inout symbols,Symbol {name:f.name,section:1,value:start});b::append(inout out,f.bytes);let mut end:i32=-1;
  for at in relocation_order(f.relocations,0,array_len::<x::Relocation>(f.relocations)) {let r:x::Relocation=f.relocations[at];if r.offset<0||r.offset%4!=0||r.offset>array_len::<u8>(f.bytes)-4||r.offset<end||r.addend!=0 {b::error("invalid Darwin ARM64 relocation/addend");}end=r.offset+4;let mut kind:i32=0;let mut pcrel:bool=true;if r.kind=="call26" {kind=2;}else if r.kind=="page21" {kind=3;}else if r.kind=="pageoff12" {kind=4;pcrel=false;}else {b::error("unsupported Darwin ARM64 relocation");}array_push::<Relocation>(inout text_relocations,Relocation {offset:checked_add(start,r.offset),symbol:r.symbol,kind:kind,width:2,pcrel:pcrel});}
  let at:i32=array_len::<u8>(unwind);b::wide(inout unwind,0);b::word(inout unwind,array_len::<u8>(f.bytes));b::word(inout unwind,67108864);b::wide(inout unwind,0);b::wide(inout unwind,0);array_push::<Relocation>(inout unwind_relocations,Relocation {offset:at,symbol:f.name,kind:0,width:3,pcrel:false});
  functions[index]=w::Code {name:f.name,bytes:[],relocations:[],frame_size:f.frame_size,returns:[]};
 }
 functions=[];let text_size:i32=array_len::<u8>(out)-text_start;
 let constant_base:i32=aligned(text_size,8);for index in b::name_order(data_names) {let d:elf::Data=data[index];b::align(inout constants,8);array_push::<Symbol>(inout symbols,Symbol {name:d.name,section:2,value:checked_add(constant_base,array_len::<u8>(constants))});b::append(inout constants,d.bytes);}
 let unwind_base:i32=aligned(checked_add(constant_base,array_len::<u8>(constants)),8);let metadata_base:i32=checked_add(unwind_base,array_len::<u8>(unwind));let metadata_bytes:Bytes=string_to_bytes(metadata);let address:i32=checked_add(metadata_base,array_len::<u8>(metadata_bytes));
 let sections:Array<Section>=[Section {name:"__text",segment:"__TEXT",address:0,alignment:4,flags:-2147482624,bytes:[],size:text_size,relocations:text_relocations},Section {name:"__const",segment:"__TEXT",address:constant_base,alignment:3,flags:0,bytes:constants,size:array_len::<u8>(constants),relocations:[]},Section {name:"__compact_unwind",segment:"__LD",address:unwind_base,alignment:3,flags:33554432,bytes:unwind,size:array_len::<u8>(unwind),relocations:unwind_relocations},Section {name:"__kelft_native",segment:"__TEXT",address:metadata_base,alignment:0,flags:268435456,bytes:metadata_bytes,size:array_len::<u8>(metadata_bytes),relocations:[]}];
 let mut names:Array<string>=[];for value in symbols {array_push::<string>(inout names,value.name);}let mut ordered:Array<Symbol>=[];for at in b::name_order(names) {array_push::<Symbol>(inout ordered,symbols[at]);}let definitions:i32=array_len::<Symbol>(ordered);for at in b::name_order(imports) {array_push::<Symbol>(inout ordered,Symbol {name:imports[at],section:0,value:0});}if array_len::<Symbol>(ordered)>16777215 {b::error("Mach-O symbol count overflow");}let mut ids:Map<string,i32>=map_new::<string,i32>();let mut n:i32=0;for value in ordered {map_set::<string,i32>(inout ids,value.name,n);n=n+1;}
 let segment_size:i32=72+array_len::<Section>(sections)*80;let command_size:i32=segment_size+24+80+24;let header_size:i32=32+command_size;let mut offsets:Array<i32>=[];let mut relocation_offsets:Array<i32>=[];
 for section in sections {if section.name=="__text" {array_push::<i32>(inout offsets,text_start);}else {b::align(inout out,1<<section.alignment);array_push::<i32>(inout offsets,array_len::<u8>(out));b::append(inout out,section.bytes);}}let raw_end:i32=array_len::<u8>(out);
 for section in sections {if array_len::<Relocation>(section.relocations)==0 {array_push::<i32>(inout relocation_offsets,0);continue;}b::align(inout out,4);array_push::<i32>(inout relocation_offsets,array_len::<u8>(out));let mut at:i32=array_len::<Relocation>(section.relocations);while at>0 {at=at-1;let r:Relocation=section.relocations[at];let id:i32=b::get(ids,r.symbol);let mut pcrel:i32=0;if r.pcrel {pcrel=16777216;}b::word(inout out,r.offset);b::word(inout out,id+pcrel+r.width*33554432+134217728+r.kind*268435456);}}
 b::align(inout out,8);let symbol_offset:i32=array_len::<u8>(out);let mut strings:Bytes=[0];for value in ordered {let at:i32=array_len::<u8>(strings);b::append(inout strings,string_to_bytes("_"+value.name));array_push::<u8>(inout strings,0);b::word(inout out,at);let mut kind:u8=1;if value.section>0 {kind=15;}array_push::<u8>(inout out,kind);array_push::<u8>(inout out,u8_from_i32(value.section));b::half(inout out,0);b::wide(inout out,value.value);}let string_offset:i32=array_len::<u8>(out);b::append(inout out,strings);
 let mut header:Bytes=[];let header_words:Array<i32>=[-17958193,16777228,0,1,4,command_size,8192,0,25,segment_size];for value in header_words {b::word(inout header,value);}field_name(inout header,"");b::wide(inout header,0);b::wide(inout header,address);b::wide(inout header,offsets[0]);b::wide(inout header,raw_end-offsets[0]);let segment_words:Array<i32>=[7,7,array_len::<Section>(sections),0];for value in segment_words {b::word(inout header,value);}
 n=0;for section in sections {field_name(inout header,section.name);field_name(inout header,section.segment);b::wide(inout header,section.address);b::wide(inout header,section.size);let section_words:Array<i32>=[offsets[n],section.alignment,relocation_offsets[n],array_len::<Relocation>(section.relocations),section.flags,0,0,0];for value in section_words {b::word(inout header,value);}n=n+1;}
 let table_words:Array<i32>=[2,24,symbol_offset,array_len::<Symbol>(ordered),string_offset,array_len::<u8>(strings),11,80,0,0,0,definitions,definitions,array_len::<string>(imports)];for value in table_words {b::word(inout header,value);}n=0;while n<12 {b::word(inout header,0);n=n+1;}let build_words:Array<i32>=[50,24,1,917504,version(sdk_version),0];for value in build_words {b::word(inout header,value);}if array_len::<u8>(header)!=header_size {b::error("Mach-O load-command size mismatch");}n=0;for value in header {out[n]=value;n=n+1;}return out;
}
