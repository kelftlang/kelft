import "./elf.kelft" as elf;
pub fn data(architecture:string)->Array<elf::Data> {
let mut out:Array<elf::Data>=[elf::Data {name:"k_stream_lf",bytes:string_to_bytes("\n")}];
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_env_key",bytes:string_to_bytes("KELFT_CAPABILITIES=")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_key_read",bytes:string_to_bytes("read")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_key_write",bytes:string_to_bytes("write")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_key_execute",bytes:string_to_bytes("execute")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_true",bytes:string_to_bytes("true")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_false",bytes:string_to_bytes("false")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_empty",bytes:string_to_bytes("{}")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_empty_text",bytes:string_to_bytes("")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_proc",bytes:string_to_bytes("/proc/self/fd/")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_dot",bytes:string_to_bytes(".")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_slash",bytes:string_to_bytes("/")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_enoent",bytes:string_to_bytes("ENOENT")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_eacces",bytes:string_to_bytes("EACCES")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_eexist",bytes:string_to_bytes("EEXIST")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_enotdir",bytes:string_to_bytes("ENOTDIR")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_eisdir",bytes:string_to_bytes("EISDIR")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_fs_io_error",bytes:string_to_bytes("IO_ERROR")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_hex",bytes:string_to_bytes("0123456789abcdef")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_comma",bytes:string_to_bytes(",")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_policy_prefix",bytes:string_to_bytes("{\"execute\":false,\"read\":[")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_policy_middle",bytes:string_to_bytes("],\"write\":[")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_policy_suffix",bytes:string_to_bytes("]}")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_target",bytes:string_to_bytes(string_replace("native-linux-x86_64-v1","x86_64",architecture))});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_name",bytes:string_to_bytes("kelft-artifact"+string_from_codepoint(0)+"")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_empty",bytes:[0]});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_unsupported",bytes:string_to_bytes("UNSUPPORTED_ARTIFACT_TARGET")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_failed",bytes:string_to_bytes("ARTIFACT_EXECUTION_FAILED")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_link_static",bytes:string_to_bytes("-static"+string_from_codepoint(0))});
array_push::<elf::Data>(inout out,elf::Data {name:"k_link_build_id",bytes:string_to_bytes("--build-id=none"+string_from_codepoint(0))});
array_push::<elf::Data>(inout out,elf::Data {name:"k_link_z",bytes:string_to_bytes("-z"+string_from_codepoint(0))});
array_push::<elf::Data>(inout out,elf::Data {name:"k_link_noexec",bytes:string_to_bytes("noexecstack"+string_from_codepoint(0))});
array_push::<elf::Data>(inout out,elf::Data {name:"k_link_output",bytes:string_to_bytes("-o"+string_from_codepoint(0))});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_linker",bytes:string_to_bytes(string_replace("linker-linux-x86_64-v1","x86_64",architecture))});
array_push::<elf::Data>(inout out,elf::Data {name:"k_engine_probe",bytes:string_to_bytes(string_replace("engine-probe-linux-x86_64-v1","x86_64",architecture))});
array_push::<elf::Data>(inout out,elf::Data {name:"k_engine_js",bytes:string_to_bytes(string_replace("engine-javascript-linux-x86_64-v1","x86_64",architecture))});
array_push::<elf::Data>(inout out,elf::Data {name:"k_engine_wasm",bytes:string_to_bytes(string_replace("engine-wasm-linux-x86_64-v1","x86_64",architecture))});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_javascript",bytes:string_to_bytes("javascript")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_wasm",bytes:string_to_bytes("wasm")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_js_fd_key",bytes:string_to_bytes("KELFT_JAVASCRIPT_RUNTIME_FD=")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_wasm_fd_key",bytes:string_to_bytes("KELFT_WASM_RUNTIME_FD=")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_js_flag",bytes:string_to_bytes("--input-type=module"+string_from_codepoint(0)+"")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_stdin",bytes:string_to_bytes("-"+string_from_codepoint(0)+"")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_wasm_command",bytes:string_to_bytes("artifact-exec"+string_from_codepoint(0)+"")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_separator",bytes:string_to_bytes("--"+string_from_codepoint(0)+"")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_required",bytes:string_to_bytes("ARTIFACT_RUNTIME_REQUIRED")});
array_push::<elf::Data>(inout out,elf::Data {name:"k_artifact_invalid",bytes:string_to_bytes("INVALID_ARTIFACT_RUNTIME")});
return out;
}
