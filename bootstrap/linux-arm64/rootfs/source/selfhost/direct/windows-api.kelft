// Fixed trusted Windows mechanism signatures. No arbitrary FFI.
import "./binary.kelft" as b;
import "./ir.kelft" as ir;
pub fn signatures()->Array<ir::Signature> {return [ir::Signature {name:"VirtualAlloc",params:["ptr","i32","i32","i32"],locations:0,result:"ptr"},ir::Signature {name:"VirtualFree",params:["ptr","i32","i32"],locations:0,result:"i32"},ir::Signature {name:"GetStdHandle",params:["i32"],locations:0,result:"ptr"},ir::Signature {name:"ReadFile",params:["ptr","ptr","i32","ptr","ptr"],locations:0,result:"i32"},ir::Signature {name:"DeviceIoControl",params:["ptr","i32","ptr","i32","ptr","i32","ptr","ptr"],locations:0,result:"i32"},ir::Signature {name:"WriteFile",params:["ptr","ptr","i32","ptr","ptr"],locations:0,result:"i32"},ir::Signature {name:"ExitProcess",params:["i32"],locations:0,result:"void"},ir::Signature {name:"GetCommandLineW",params:[],locations:0,result:"ptr"},ir::Signature {name:"CommandLineToArgvW",params:["ptr","ptr"],locations:0,result:"ptr"},ir::Signature {name:"LocalFree",params:["ptr"],locations:0,result:"ptr"},ir::Signature {name:"WideCharToMultiByte",params:["i32","i32","ptr","i32","ptr","i32","ptr","ptr"],locations:0,result:"i32"},ir::Signature {name:"GetCurrentDirectoryW",params:["i32","ptr"],locations:0,result:"i32"},ir::Signature {name:"GetEnvironmentVariableW",params:["ptr","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"MultiByteToWideChar",params:["i32","i32","ptr","i32","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"NtCreateFile",params:["ptr","i32","ptr","ptr","ptr","i32","i32","i32","i32","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"GetFinalPathNameByHandleW",params:["ptr","ptr","i32","i32"],locations:0,result:"i32"},ir::Signature {name:"QueryDosDeviceW",params:["ptr","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"GetFileType",params:["ptr"],locations:0,result:"i32"},ir::Signature {name:"GetFileInformationByHandleEx",params:["ptr","i32","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"CloseHandle",params:["ptr"],locations:0,result:"i32"},ir::Signature {name:"ReOpenFile",params:["ptr","i32","i32","i32"],locations:0,result:"ptr"},ir::Signature {name:"GetLastError",params:[],locations:0,result:"i32"},ir::Signature {name:"GetEnvironmentStringsW",params:[],locations:0,result:"ptr"},ir::Signature {name:"FreeEnvironmentStringsW",params:["ptr"],locations:0,result:"i32"},ir::Signature {name:"DuplicateHandle",params:["ptr","ptr","ptr","ptr","i32","i32","i32"],locations:0,result:"i32"},ir::Signature {name:"SetFilePointerEx",params:["ptr","ptr","ptr","i32"],locations:0,result:"i32"},ir::Signature {name:"SetEndOfFile",params:["ptr"],locations:0,result:"i32"},ir::Signature {name:"CompareStringOrdinal",params:["ptr","i32","ptr","i32","i32"],locations:0,result:"i32"},ir::Signature {name:"QueryPerformanceCounter",params:["ptr"],locations:0,result:"i32"},ir::Signature {name:"QueryPerformanceFrequency",params:["ptr"],locations:0,result:"i32"}];}
pub fn get(name:string)->ir::Signature {for api in signatures() {if api.name==name {return api;}}b::error("Win32 mechanism is not allowlisted: "+name);return ir::Signature {name:"",params:[],locations:0,result:"void"};}
