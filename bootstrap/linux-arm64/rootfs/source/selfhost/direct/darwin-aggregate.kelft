 for at in b::name_order(traps) {let name:string=traps[at];let bytes:Bytes=string_to_bytes("error["+string_slice(name,8,string_len(name))+"]\n");array_push::<elf::Data>(inout data,elf::Data {name:name+"_text",bytes:bytes});array_push::<ir::Function>(inout functions,panic_function(name,array_len::<u8>(bytes)));}array_push::<ir::Function>(inout functions,wrapper);
 let mut sigs:Array<ir::Signature>=signatures();let mut imported:Array<string>=[];for a in sigs {array_push::<string>(inout imported,a.name);}for f in declarations {array_push::<ir::Signature>(inout sigs,aggregate::planned_signature(f,plan));}for f in functions {array_push::<ir::Signature>(inout sigs,ir::Signature {name:f.name,params:f.params,locations:f.locations,result:f.result});}let environment:ir::Environment=ir::verification(sigs,data);
 let opcode_registry:Map<string,i32>=opcodes::registry();let mut code:Array<d::Code>=[];let mut literals:Array<elf::Data>=[];let mut index:i32=0;while index<array_len::<c::Node>(p.functions) {let f:c::Node=p.functions[index];p.functions[index]=declarations[index];array_push::<d::Code>(inout code,encoded_core(f,declarations,plan,environment,imported,opcode_registry,inout literals));index=index+1;}
 for f in functions {ir::verify_part(f,environment,[]);array_push::<d::Code>(inout code,d::encode_registered(f.name,ir::lower(f,imported),opcode_registry));}for value in literals {array_push::<elf::Data>(inout data,value);}for a in signatures() {let mut width:i32=4;if a.result=="void" {width=0;}if a.result=="ptr" {width=8;}let name:string=string_slice(a.name,9,string_len(a.name));array_push::<d::Code>(inout code,d::encode(a.name,[x::make("prologue",64,0,""),x::make("darwin_api",array_len::<string>(a.params),width,name),x::make("return",width,0,"")]));}
 let mut imported_hosts:Map<string,i32>=map_new::<string,i32>();for a in api::signatures() {map_set::<string,i32>(inout imported_hosts,a.name,1);}let mut used_imports:Map<string,i32>=map_new::<string,i32>();map_set::<string,i32>(inout used_imports,"_exit",1);
 let mut ids:Map<string,i32>=map_new::<string,i32>();index=0;for f in code {map_set::<string,i32>(inout ids,f.name,index);index=index+1;}let mut data_ids:Map<string,i32>=map_new::<string,i32>();for value in data {map_set::<string,i32>(inout data_ids,value.name,1);}let mut reachable:Map<string,i32>=map_new::<string,i32>();let mut used_data:Map<string,i32>=map_new::<string,i32>();let mut pending:Array<string>=["k_darwin_main"];let mut cursor:i32=0;
 while cursor<array_len::<string>(pending) {let name:string=pending[cursor];cursor=cursor+1;if present(reachable,name) {continue;}map_set::<string,i32>(inout reachable,name,1);let f:d::Code=code[b::get(ids,name)];for r in f.relocations {if present(ids,r.symbol) {array_push::<string>(inout pending,r.symbol);}else if present(data_ids,r.symbol) {map_set::<string,i32>(inout used_data,r.symbol,1);}else if present(imported_hosts,r.symbol) {map_set::<string,i32>(inout used_imports,r.symbol,1);}else {b::error("unresolved Darwin object symbol: "+r.symbol);}}}
 let mut selected:Array<d::Code>=[];for f in code {if present(reachable,f.name) {array_push::<d::Code>(inout selected,f);}}array_push::<d::Code>(inout selected,d::encode("k_start",[x::make("prologue",256,0,""),x::make("darwin_start",0,0,"k_darwin_main")]));let mut selected_data:Array<elf::Data>=[];for value in data {if present(used_data,value.name) {array_push::<elf::Data>(inout selected_data,value);}}
 let mut guest_metadata:string="";if guest_paths {guest_metadata="\"guestPaths\":true,";}let metadata:string="{\"schema\":\"kelft-native-object/1\",\"platform\":\"macos\",\"target\":\"x86_64\",\"format\":\"macho64\",\"runtimeABI\":\"kelft-native/1\",\"heapLimit\":"+i32_to_string(limit)+",\"status\":\"development-owned-core-process-paths-and-streams\",\"productionClosureVerified\":false,"+guest_metadata+"\"maximum\":"+maximum+"}";let mut hosts:Array<string>=[];for a in api::signatures() {if present(used_imports,a.name) {array_push::<string>(inout hosts,a.name);}}let mut names:Array<string>=[];for at in b::name_order(hosts) {array_push::<string>(inout names,hosts[at]);}return Object {code:selected,data:selected_data,imports:names,metadata:metadata};
}

pub fn consume_object(inout p:c::Program,limit:i32,maximum:string)->Object {return consume_profile(inout p,limit,maximum,false);}
pub fn consume_guest_object(inout p:c::Program,limit:i32,maximum:string)->Object {return consume_profile(inout p,limit,maximum,true);}
pub fn consume_guest_bytes(inout p:c::Program,limit:i32,sdk:string,maximum:string)->Bytes {let mut out:Object=consume_guest_object(inout p,limit,maximum);return write_object(inout out,sdk);}
pub fn consume_bytes(inout p:c::Program,limit:i32,sdk:string,maximum:string)->Bytes {let mut out:Object=consume_object(inout p,limit,maximum);return write_object(inout out,sdk);}

pub fn emit_guest_object(p:c::Program,limit:i32,sdk:string,maximum:string)->Bytes {let mut out:Object=build_profile(p,limit,maximum,true);return write_object(inout out,sdk);}
