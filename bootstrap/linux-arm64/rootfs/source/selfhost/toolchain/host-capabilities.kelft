// Production capability decisions. No host observations or process launching here.
import "../json.kelft" as j;
import "../syntax.kelft" as s;
pub fn normal_path(path:string)->bool {
 if path==""||string_len(path)>4095||s::has(path,"\\")||s::has(path,"\u{0}") {return false;}
 let mut start:i32=0;if s::starts(path,"/") {start=1;}else if string_len(path)>=3&&string_byte(path,1)==u8_from_i32(58)&&string_byte(path,2)==u8_from_i32(47) {let c:i32=i32_from_u8(string_byte(path,0));if (c>=65&&c<=90)||(c>=97&&c<=122) {start=3;}}
 if start==0 {return false;}if string_len(path)==start {return true;}
 for part in string_split(s::slice(path,start,string_len(path)),"/") {if part==""||part=="."||part==".."||s::has(part,":") {return false;}}return true;
}
pub fn contains_path(root:string,path:string)->bool {if root==path {return true;}if string_len(root)>0&&s::slice(root,string_len(root)-1,string_len(root))=="/" {return s::starts(path,root);}return s::starts(path,root+"/");}
fn keys(value:j::Value,allowed:Array<string>)->bool {if !j::is_object(value) {return false;}for (key,item) in j::object(value) {let mut known:bool=false;for name in allowed {if key==name {known=true;}}if !known {return false;}}return true;}
fn has(value:j::Value,key:string)->bool {for (name,item) in j::object(value) {if name==key {return true;}}return false;}
fn upper(value:string)->string {let mut bytes:Bytes=[];for byte in string_to_bytes(value) {let mut c:i32=i32_from_u8(byte);if c>=97&&c<=122 {c=c-32;}array_push::<u8>(inout bytes,u8_from_i32(c));}match utf8_decode(bytes) {Result::Ok(text)=>{return text;},Result::Error(message)=>{}}return "";}
fn roots(value:j::Value)->bool {if !j::is_array(value)||array_len::<j::Value>(j::array(value))>128 {return false;}for path in j::array(value) {if !j::is_string(path)||!normal_path(j::string(path)) {return false;}}return true;}
fn roots_allow(allowed:j::Value,requested:j::Value)->bool {if !roots(allowed)||!roots(requested) {return false;}for path in j::array(requested) {let mut found:bool=false;for root in j::array(allowed) {if contains_path(j::string(root),j::string(path)) {found=true;}}if !found {return false;}}return true;}
fn integer(value:j::Value)->i32 {match value {j::Value::Number(raw)=>{match string_to_i32(raw) {Result::Ok(n)=>{if i32_to_string(n)==raw {return n;}},Result::Error(message)=>{}}},_=>{}}return -1;}
fn quantity(value:j::Value)->string {match value {j::Value::Number(raw)=>{if raw==""||string_len(raw)>12||raw=="0"||(string_len(raw)>1&&string_byte(raw,0)==u8_from_i32(48)) {return "";}for byte in string_to_bytes(raw) {let n:i32=i32_from_u8(byte);if n<48||n>57 {return "";}}return raw;},_=>{}}return "";}
fn quantity_le(a:string,b:string)->bool {if a==""||b=="" {return false;}if string_len(a)!=string_len(b) {return string_len(a)<string_len(b);}let mut i:i32=0;while i<string_len(a) {let left:i32=i32_from_u8(string_byte(a,i));let right:i32=i32_from_u8(string_byte(b,i));if left!=right {return left<right;}i=i+1;}return true;}
fn limits(value:j::Value)->bool {let names:Array<string>=["timeoutMs","memoryBytes","stdoutBytes","stderrBytes"];let bounds:Array<i32>=[600000,1073741824,16777216,16777216];if !keys(value,names) {return false;}let mut at:i32=0;for name in names {if name=="memoryBytes" {if !quantity_le(quantity(j::field(value,name)),"549755813888") {return false;}at=at+1;continue;}let n:i32=integer(j::field(value,name));let mut minimum:i32=1;if at>=2 {minimum=0;}if n<minimum||n>bounds[at] {return false;}at=at+1;}return true;}
fn environment(value:j::Value)->bool {
 if !j::is_object(value)||map_len::<string,j::Value>(j::object(value))>32 {return false;}
 let mut names:Map<string,bool>=map_new::<string,bool>();for (key,item) in j::object(value) {if key==""||!j::is_string(item)||string_len(j::string(item))>4096||s::has(j::string(item),"\u{0}") {return false;}let mut index:i32=0;for byte in string_to_bytes(key) {let c:i32=i32_from_u8(byte);if !((c>=65&&c<=90)||(c>=97&&c<=122)||c==95||(index>0&&c>=48&&c<=57)) {return false;}index=index+1;}let upper:string=upper(key);match map_get::<string,bool>(names,upper) {Option::Some(previous)=>{return false;},Option::None=>{}}map_set::<string,bool>(inout names,upper,true);if upper=="LOCALAPPDATA"||upper=="SYSTEMROOT"||upper=="SYSTEMDRIVE"||upper=="WINDIR"||upper=="TEMP"||upper=="TMP"||s::starts(upper,"KELFT_")||upper=="NODE_OPTIONS"||upper=="NODE_PATH"||upper=="LD_PRELOAD"||upper=="LD_LIBRARY_PATH"||upper=="DYLD_INSERT_LIBRARIES"||upper=="DYLD_LIBRARY_PATH" {return false;}}
 return true;
}
fn hash(value:j::Value)->bool {if !j::is_string(value) {return false;}let raw:string=j::string(value);if string_len(raw)!=71||!s::starts(raw,"sha256:") {return false;}for byte in string_to_bytes(s::slice(raw,7,71)) {let c:i32=i32_from_u8(byte);if !((c>=48&&c<=57)||(c>=97&&c<=102)) {return false;}}return true;}
pub fn validate_host_policy(value:j::Value)->string {
 if !keys(value,["read","write","execute","process"])||!roots(j::field(value,"read"))||!roots(j::field(value,"write")) {return "INVALID_POLICY";}let execute:j::Value=j::field(value,"execute");if has(value,"execute")&&!j::is_bool(execute) {return "INVALID_POLICY";}
 let grants:j::Value=j::field(value,"process");if !has(value,"process") {return "";}if !j::is_array(grants)||array_len::<j::Value>(j::array(grants))>32 {return "INVALID_POLICY";}let mut seen:Map<string,bool>=map_new::<string,bool>();
 for grant in j::array(grants) {let executable:string=j::string(j::field(grant,"executable"));let profile:j::Value=j::field(grant,"profile");if !keys(grant,["executable","sha256","cwd","environment","read","write","limits","profile"])||!normal_path(executable)||!hash(j::field(grant,"sha256"))||!roots(j::field(grant,"cwd"))||!environment(j::field(grant,"environment"))||!roots(j::field(grant,"read"))||!roots(j::field(grant,"write"))||!limits(j::field(grant,"limits"))||(has(grant,"profile")&&profile!=j::Value::Text("native")&&profile!=j::Value::Text("installed-kelft")) {return "INVALID_POLICY";}
  match map_get::<string,bool>(seen,executable) {Option::Some(previous)=>{return "INVALID_POLICY";},Option::None=>{}}map_set::<string,bool>(inout seen,executable,true);
  if !roots_allow(j::field(value,"read"),j::field(grant,"read"))||!roots_allow(j::field(value,"write"),j::field(grant,"write")) {return "INVALID_POLICY";}
 }return "";
}
pub fn validate_process_request(value:j::Value)->string {
 if !keys(value,["schema","executable","sha256","args","cwd","environment","stdinHex","read","write","limits"])||j::field(value,"schema")!=j::Value::Text("kelft.process-request/1")||!normal_path(j::string(j::field(value,"executable")))||!hash(j::field(value,"sha256"))||!normal_path(j::string(j::field(value,"cwd")))||!environment(j::field(value,"environment"))||!roots(j::field(value,"read"))||!roots(j::field(value,"write"))||!limits(j::field(value,"limits")) {return "INVALID_REQUEST";}
 let arguments:j::Value=j::field(value,"args");if !j::is_array(arguments)||array_len::<j::Value>(j::array(arguments))>256 {return "INVALID_REQUEST";}let mut budget:i32=65536;for argument in j::array(arguments) {if !j::is_string(argument) {return "INVALID_REQUEST";}let raw:string=j::string(argument);let n:i32=string_len(raw);if n>32768||n>budget||s::has(raw,"\u{0}") {return "INVALID_REQUEST";}budget=budget-n;}
 let input:j::Value=j::field(value,"stdinHex");if !j::is_string(input) {return "INVALID_REQUEST";}let raw:string=j::string(input);if string_len(raw)>131072||string_len(raw)%2!=0 {return "INVALID_REQUEST";}for byte in string_to_bytes(raw) {let c:i32=i32_from_u8(byte);if !((c>=48&&c<=57)||(c>=97&&c<=102)) {return "INVALID_REQUEST";}}return "";
}
fn permits(policy:j::Value,request:j::Value)->bool {
 for grant in j::array(j::field(policy,"process")) {if j::field(grant,"executable")!=j::field(request,"executable")||j::field(grant,"sha256")!=j::field(request,"sha256") {continue;}let mut cwd:bool=false;for root in j::array(j::field(grant,"cwd")) {if contains_path(j::string(root),j::string(j::field(request,"cwd"))) {cwd=true;}}if !cwd {return false;}
  for (key,value) in j::object(j::field(request,"environment")) {if j::field(j::field(grant,"environment"),key)!=value {return false;}}
  let operations:Array<string>=["read","write"];for operation in operations {if !roots_allow(j::field(grant,operation),j::field(request,operation))||!roots_allow(j::field(policy,operation),j::field(request,operation)) {return false;}}
  let names:Array<string>=["timeoutMs","memoryBytes","stdoutBytes","stderrBytes"];for name in names {if name=="memoryBytes" {if !quantity_le(quantity(j::field(j::field(request,"limits"),name)),quantity(j::field(j::field(grant,"limits"),name))) {return false;}continue;}if integer(j::field(j::field(request,"limits"),name))>integer(j::field(j::field(grant,"limits"),name)) {return false;}}return true;
 }return false;
}
pub fn authorize_process(maximum:j::Value,caller:j::Value,request:j::Value)->string {
 if validate_host_policy(maximum)!=""||validate_host_policy(caller)!="" {return "INVALID_POLICY";}let error:string=validate_process_request(request);if error!="" {return error;}if !permits(maximum,request)||!permits(caller,request)||profile(maximum,request)!=profile(caller,request) {return "PROCESS_DENIED";}return "";
}
fn profile(policy:j::Value,request:j::Value)->string {for grant in j::array(j::field(policy,"process")) {if j::field(grant,"executable")==j::field(request,"executable") {let value:j::Value=j::field(grant,"profile");if value==j::Value::Null() {return "native";}return j::string(value);}}return "";}

fn root(raw:j::Value)->string {if !j::is_string(raw) {return "";}let value:string=j::string(raw);if string_find(value,"\\",0)>=0||string_find(value,":",0)>=0||string_find(value,"\u{0}",0)>=0 {return "";}let mut parts:Array<string>=[];if string_len(value)==0||string_slice(value,0,1)!="/" {parts=["project"];}for part in string_split(value,"/") {if part==""||part=="." {continue;}if part==".." {if array_len::<string>(parts)==0 {return "";}array_pop::<string>(inout parts);}else {array_push::<string>(inout parts,part);}}let mut out:string="";for part in parts {out=out+"/"+part;}if out=="" {return "/";}return out;}
pub fn normalize_host_policy(value:j::Value)->j::Value {let mut out:j::Value=value;let names:Array<string>=["read","write"];for name in names {let field:j::Value=j::field(value,name);if j::is_array(field) {let mut paths:Array<j::Value>=[];for path in j::array(field) {array_push::<j::Value>(inout paths,j::Value::Text(root(path)));}out=j::set(out,name,j::Value::Array(paths));}}return out;}
