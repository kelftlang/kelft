import "../../stdlib/testing.kelft" as testing;
import "../../selfhost/json.kelft" as j;
import "../../examples/relay/browser-policy.kelft" as client;
fn initial()->j::Value {return j::parse("{\"sequence\":0,\"auth_epoch\":1,\"pending\":{},\"queue\":[],\"forms\":{},\"data_version\":1,\"persisted_version\":1,\"online\":false,\"network_ok\":false,\"authenticated\":true,\"authorized\":true,\"vault_enabled\":true,\"vault_unlocked\":true,\"local_authorized\":true,\"workspace\":\"00000000-0000-4000-8000-000000000001\",\"identity\":{\"issuer\":\"https://identity.test\",\"subject\":\"alice\"},\"session\":{\"csrf\":\"token\"},\"snapshot\":{\"workspace\":{\"id\":\"00000000-0000-4000-8000-000000000001\",\"name\":\"Team\",\"revision\":1},\"tasks\":[{\"id\":\"00000000-0000-4000-8000-000000000002\",\"workspace\":\"00000000-0000-4000-8000-000000000001\",\"title\":\"Plan\",\"state\":\"todo\",\"owner\":null,\"revision\":1}],\"members\":[],\"conflicts\":[]}}");}
fn command(frame:j::Value,kind:string)->j::Value {for item in j::array(j::field(frame,"commands")) {if j::string(j::field(item,"type"))==kind {return item;}}return j::Value::Null();}
fn complete(frame:j::Value,effect:j::Value,ok:bool,result:j::Value)->j::Value {let mut event:j::Value=j::parse("{\"type\":\"host.complete\"}");event=j::set(event,"id",j::field(effect,"id"));event=j::set(event,"ok",j::Value::Bool(ok));event=j::set(event,"result",result);return client::transition(j::field(frame,"state"),event);}
fn queue_from(state:j::Value)->j::Value {
 let frame:j::Value=client::transition(state,j::parse("{\"type\":\"ui.task-move\",\"data\":{\"task\":\"00000000-0000-4000-8000-000000000002\",\"state\":\"doing\",\"workspace\":\"00000000-0000-4000-8000-000000000001\",\"base\":{\"revision\":1,\"title\":\"Plan\",\"state\":\"todo\",\"owner\":null}}}"));
 return complete(frame,command(frame,"random.uuid"),true,j::parse("{\"uuid\":\"00000000-0000-4000-8000-000000000003\"}"));
}
fn queued()->j::Value {return queue_from(initial());}
pub fn test_offline_work_is_persisted_before_replay(inout context:testing::Context)->void {
 let frame:j::Value=queued();let effect:j::Value=command(frame,"vault.store");let state:j::Value=j::field(frame,"state");let queue:Array<j::Value>=j::array(j::field(state,"queue"));
 testing::equal_i32(inout context,array_len::<j::Value>(queue),1,"one pending edit");testing::equal_json(inout context,j::field(j::field(effect,"payload"),"queue"),j::field(state,"queue"),"encrypted payload contains pending edit");testing::expect(inout context,!j::is_object(command(frame,"http.request")),"no network before durable write");
 testing::equal_json(inout context,j::field(j::field(j::field(queue[0],"operation"),"patch"),"state"),j::Value::Text("doing"),"actual patch retained");
 let persisted:j::Value=complete(frame,effect,true,j::parse("{\"persisted\":true}"));testing::equal_json(inout context,j::field(j::field(persisted,"state"),"queue"),j::field(state,"queue"),"persistence is not server acknowledgement");testing::expect(inout context,!j::is_object(command(persisted,"http.request")),"offline persistence cannot replay");testing::equal_json(inout context,j::field(j::field(persisted,"state"),"persisted_version"),j::field(state,"data_version"),"persisted version acknowledged");
 let onlineState:j::Value=j::set(j::set(initial(),"online",j::Value::Bool(true)),"network_ok",j::Value::Bool(true));let onlineSession:j::Value=j::set(j::field(onlineState,"session"),"identity",j::field(onlineState,"identity"));let online:j::Value=queue_from(j::set(onlineState,"session",onlineSession));testing::expect(inout context,!j::is_object(command(online,"http.request")),"online transport also waits for encrypted persistence");
 let replay:j::Value=complete(online,command(online,"vault.store"),true,j::parse("{\"persisted\":true}"));testing::equal_json(inout context,j::field(command(replay,"http.request"),"method"),j::Value::Text("POST"),"online replay starts after persistence");testing::equal_i32(inout context,array_len::<j::Value>(j::array(j::field(j::field(replay,"state"),"queue"))),1,"replay request does not discard unacknowledged work");
}
pub fn test_failed_persistence_retains_unacknowledged_edit(inout context:testing::Context)->void {
 let frame:j::Value=queued();let before:j::Value=j::field(frame,"state");let failed:j::Value=complete(frame,command(frame,"vault.store"),false,j::Value::Null());let state:j::Value=j::field(failed,"state");
 testing::equal_json(inout context,j::field(state,"queue"),j::field(before,"queue"),"failed save retains work");testing::equal_json(inout context,j::field(state,"persisted_version"),j::field(before,"persisted_version"),"failed write does not acknowledge version");testing::equal_json(inout context,j::field(state,"persistence_paused"),j::Value::Bool(true),"saving paused");testing::expect(inout context,!j::is_object(command(failed,"http.request")),"failed write cannot replay");testing::equal_json(inout context,j::field(command(failed,"unload.guard"),"enabled"),j::Value::Bool(true),"unsaved work guards tab unload");
}
pub fn test_stale_completion_after_authentication_change_is_ignored(inout context:testing::Context)->void {
 let frame:j::Value=queued();let effect:j::Value=command(frame,"vault.store");let mut state:j::Value=j::field(frame,"state");state=j::set(state,"auth_epoch",j::Value::Number("2"));let changed:j::Value=j::set(frame,"state",state);let stale:j::Value=complete(changed,effect,true,j::parse("{\"persisted\":true}"));let after:j::Value=j::field(stale,"state");
 testing::equal_json(inout context,j::field(after,"queue"),j::field(state,"queue"),"stale callback retains queue");testing::equal_json(inout context,j::field(after,"persisted_version"),j::field(state,"persisted_version"),"old epoch cannot acknowledge work");testing::equal_json(inout context,j::field(after,"auth_epoch"),j::Value::Number("2"),"current authentication retained");testing::expect(inout context,!j::is_object(command(stale,"http.request")),"stale callback cannot replay");testing::expect(inout context,!j::is_object(j::field(j::field(after,"pending"),j::string(j::field(effect,"id")))),"stale callback removed from pending");
}
pub fn test_cross_tab_lock_preserves_durable_work_without_broadcast_loop(inout context:testing::Context)->void {
 let frame:j::Value=queued();let effect:j::Value=command(frame,"vault.store");let payload:j::Value=j::field(effect,"payload");let persisted:j::Value=complete(frame,effect,true,j::parse("{\"persisted\":true}"));let locked:j::Value=client::transition(j::field(persisted,"state"),j::parse("{\"type\":\"platform.vault-lock\",\"identity\":{\"issuer\":\"https://identity.test\",\"subject\":\"alice\",\"workspace\":\"00000000-0000-4000-8000-000000000001\"},\"reason\":\"logout\"}"));let state:j::Value=j::field(locked,"state");
 testing::equal_json(inout context,j::field(state,"vault_unlocked"),j::Value::Bool(false),"vault locked");testing::equal_json(inout context,j::field(state,"local_authorized"),j::Value::Bool(false),"local editing disabled");testing::equal_json(inout context,j::field(state,"snapshot"),j::Value::Null(),"plaintext snapshot cleared");testing::equal_i32(inout context,array_len::<j::Value>(j::array(j::field(state,"queue"))),0,"plaintext queue cleared");
 testing::equal_i32(inout context,array_len::<j::Value>(j::array(j::field(payload,"queue"))),1,"previously stored encrypted work remains");testing::expect(inout context,!j::is_object(command(locked,"http.request")),"lock cannot replay");
 let saved:Array<j::Value>=j::array(j::field(payload,"queue"));testing::equal_json(inout context,j::field(j::field(j::field(saved[0],"operation"),"patch"),"state"),j::Value::Text("doing"),"stored edit remains intact after lock");
 for item in j::array(j::field(locked,"commands")) {let kind:string=j::string(j::field(item,"type"));testing::expect(inout context,kind!="vault.lock"&&kind!="vault.store"&&kind!="vault.quarantine"&&kind!="vault.lock-all","remote lock does not rewrite or rebroadcast vault state");}
}
